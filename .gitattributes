# ── Text normalization ─────────────────────────────────────────────

* text=auto

# Source files should always use LF.
*.thy       text eol=lf
*.ML        text eol=lf
*.vimp      text eol=lf
ROOT        text eol=lf
ROOTS       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.py        text eol=lf


# ── GitHub syntax highlighting ─────────────────────────────────────

# VIMP is C-like.
*.vimp linguist-language=C


# ── Generated code ─────────────────────────────────────────────────

# Example: code generated by Isabelle export_code.
codegen/generated/** linguist-generated=true

# The VIMP frontend (grammar/vimp.yaml -> scripts/gen_vimp_menhir.py),
# unrelated to Isabelle codegen -- kept in cli/ next to its consumer
# (main.ml, vimp_frontend.ml) rather than under codegen/generated/.
cli/vimp_parser.mly linguist-generated=true
cli/vimp_lexer.mll linguist-generated=true

# ── Vendored / third-party code ────────────────────────────────────

vendor/** linguist-vendored=true

# ── Documentation ──────────────────────────────────────────────────

docs/** linguist-documentation=true
