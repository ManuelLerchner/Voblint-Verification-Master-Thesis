# GHC/OCaml build byproducts from compiling codegen/generated/ and the
# regression drivers under codegen/regression/. `pixi run codegen`/`isabelle
# export` regenerate the tracked .hs/.ml sources from scratch, so these
# are always safe to delete.
*.hi
*.o
*.cmi
*.cmx
*.cmt
*.cmti

# Build-time copy of codegen/generated/Voblint_Analyse_OCaml.ml made so
# ocamlopt can infer a module name from the filename; not a source file.
regression/ocaml/Voblint_Analyse_OCaml.ml

# Compiled regression driver binaries.
regression/haskell/regression-hs
regression/ocaml/regression-ml
