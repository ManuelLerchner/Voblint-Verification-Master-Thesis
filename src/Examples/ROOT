session Voblint_Examples in "." = "Voblint_Examples_CLI" +
  description
    "The project capstone index: one theory that imports every example session and
     the CLI, so nothing it names is unbuilt"
  sessions
    "HOL-Library"
    "Voblint_Soundness"
    "Voblint_Examples_CFG"
    "Voblint_Examples_Congruence"
    "Voblint_Examples_Sign"
    "Voblint_Examples_Interval"
    "Voblint_Examples_Parity"
    "Voblint_Examples_Int"
    "Voblint_Examples_Relational"
    "Voblint_Examples_Tooling"
  theories
    Voblint
  document_files
    (in "../Analyses/Base/document") "root.bib"
