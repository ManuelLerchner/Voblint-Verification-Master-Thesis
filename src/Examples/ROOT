session Voblint_Examples in "." = "Voblint_Formalization" +
  description "Executable witnesses, flagship demonstrations, and the project capstone index"
  sessions
    "HOL-Library"
  directories
    "Sign"
    "Sign/CallString"
    "Interval"
    "Interval/CallString"
    "Interval/Ctx"
    "Parity"
    "Mixed"
    "CFG"
    "Tooling"
    "Regression"
  theories
    (* CFG: cross-cutting compiler/collecting-semantics support and regressions *)
    Example_Inc_Proc
    Example_Compile_Baseline
    Example_Compile_Regression
    Example_Control_Simulation_Regression
    Example_LTR_Collect_Regression
    Example_Proc_Recursion_CFG
    Example_VIMP_Proc_Regression

    (* Sign *)
    Exec_Sign_Run
    Exec_Sign_DG_Run
    Example_Sign_Codegen
    (* G-A1 acceptance case: checks_proven/checks_proven_sound, store-only. *)
    Example_Checks_Store_Only
    Example_Side_Execute
    Example_Side_Proc_Global
    Example_Side_Branch_Calls
    Example_Mixed_Flow_Sign
    Example_Sign_Placement
    Example_Placement_Regression
    Example_Sign_DG_CallString_K1
    Example_Sign_DG_CallString_K2

    (* Interval *)
    Exec_Ivl_Run
    (* Interval analogue of G-A1: checks_proven/checks_proven_sound, store-only. *)
    Example_Interval_Checks_Store_Only
    Example_Interval_Placement
    Example_M4_Acceptance
    Example_Interval_DG_Flagship
    Example_Interval_DG_IP_Flagship
    Example_Interval_DG_Ctx_Flagship
    Example_Interval_DG_Ctx_Sound
    Example_Interval_DG_Ctx_Collect
    Example_Interval_DG_Ctx_Multi_Call_Regression
    Example_Interval_DG_EntryState_Base
    Example_Interval_DG_EntryState_Ctx
    Example_Interval_DG_EntryState_Sound
    Example_Interval_DG_EntryState_Collect
    Example_Interval_DG_CallString
    Example_Interval_DG_CallString_K1
    Example_Interval_DG_CallString_K2
    Call_String_Solver_Refinement
    Example_Interval_Source_Ctx
    Example_Interval_Side_Proc_Global
    Example_Interval_Loop_Coverage
    Example_Guard_Refinement
    Example_Proc_Call

    (* Parity *)
    Example_Parity_DG_Flagship
    Example_Parity_Checks_Store_Only

    (* Mixed (Sign x Interval, relational) *)
    Example_Relational_DG_Demo
    Example_Analysis_Dispatch

    (* Solver, domain-independent *)
    Example_Strategy_Tree_Demo

    (* Tooling *)
    Example_Proc_GraphViz
    Example_Proc_GraphViz_Recursion
    Example_Mixed_Sign_Interval_GraphViz
    Example_State_Report_GraphViz

    Voblint
  document_files
    (in "../Analysis/document") "root.bib"
  export_files (in "../../codegen/generated/ml") [2]
    "Voblint_Examples.Example_Analysis_Dispatch:code/*.ocaml"
  export_files (in "../../codegen/generated/ml") [2]
    "Voblint_Examples.Example_State_Report_GraphViz:code/*.ocaml"
