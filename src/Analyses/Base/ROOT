session Voblint_Analysis_Base in "." = "Voblint_Soundness" +
  description "Non-relational reuse locales, context routing, dispatch config, reporting and result publication shared by every concrete analysis domain"
  sessions
    "Voblint_VIMP"
    "Voblint_Domain"
    "Voblint_Framework"
    "Voblint_Compile"
  directories
    "Nonrelational"
    "Config"
    "Context"
    "Reporting"
    "Result"
  theories
    (* Nonrelational: locales whose store is pointwise, vname => 'a *)
    Abstract_Arithmetic
    Special_Ops
    Numeric_Ops
    Exec_Backward

    (* Config: cross-domain analysis selection *)
    Analysis_Config

    (* Context: concrete routing policies over a compiled program *)
    Call_String_Context_Finite
    Call_String_Routed_Context
    Context_Space_Finite
    Entry_State_Routed_Context

    (* Reporting: generic GraphViz rendering of an analysis result *)
    Analysis_GraphViz

    (* Result: publishing a solved routed system, and the surface it exposes *)
    DG_Result_Construction
    Analysis_Surface
  document_files
    "root.bib"
