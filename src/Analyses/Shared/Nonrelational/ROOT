chapter Voblint

session Voblint_Nonrelational in "." = "Voblint_Result" +
  description
    "What a non-relational domain reuses: expression evaluation and soundness,
     special-call dispatch, generic procedure entry and executable backward filtering.
     Every theory here fixes an abstract state as one value per variable,
     which is why a relational carrier must not be able to reach it"
  sessions
    "Voblint_VIMP"
    "Voblint_Domain"
    "Voblint_Framework"
    "Voblint_Exec"
    "HOL-Computational_Algebra"
  theories
    (* Elaborated here rather than imported, for the same reason Voblint_VIMP
       is parented on HOL-Library: HOL-Computational_Algebra is a sibling of
       this chain, so Congruence_Backward's import of it was re-elaborated in
       both Analysis_Congruence and Analysis_Int. This is their nearest common
       ancestor. *)
    "HOL-Computational_Algebra.Euclidean_Algorithm"
    Abstract_Arithmetic
    Special_Ops
    Nonrelational_Transfer
    Numeric_Ops
    Exec_Backward
