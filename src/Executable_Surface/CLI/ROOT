chapter Voblint

session Voblint_CLI in "." = "Voblint_Analysis_Int" +
  description
    "Production CLI-facing surface: the AnalysisConfig-driven dispatcher over
     the five domains' entry points, and the graph export a renderer consumes,
     independent of the demonstration and regression theories in
     Voblint_Examples"
  sessions
    "Voblint_Analysis_Sign"
    "Voblint_Analysis_Interval"
    "Voblint_Analysis_Parity"
    "Voblint_Analysis_Congruence"
    "HOL-Library"
  directories
    "generated"
  theories
    Analysis_Config
    Dispatch_Carrier
    Config_Tables
    Dispatch_Tables
    Analyse_Dispatch
    Dispatch_Config

    (* A solved result as a graph, and the readings handed to a renderer.
       Domain-independent, but used by no domain -- only by the surface below. *)
    Analysis_Graph
    Analysis_Graph_Build
    Analysis_Graph_Wf
    Analysis_Graph_Naming
    Analysis_Graph_Export

    State_Report_Graph
    State_Report_Entry_Ctx
    State_Report_Call_String
    Analysis_Run
    Analysis_Run_Sound
    Analysis_Run_Ctx_Sound
    Analysis_Run_Solver_Sound
    Analysis_Certified
