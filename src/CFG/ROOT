session Voblint_CFG in "." = "Voblint_VIMP" +
  description "Procedure-aware CFG: the graph model and its activation-local semantics"
  directories
    "Collecting"
  theories
    CFG_Def
    CFG_Transfer
    CFG_Prune
    (* Small-step located execution of an arbitrary CFG. *)
    CFG_Exec
    (* The concrete interprocedural semantics of an arbitrary CFG.  Nothing here
       mentions the compiler: the analysis soundness statements are about any
       graph, not only about compiled ones. *)
    LTR_Def
    Activation_Context
    LTR_Collect
    LTR_Abstract
