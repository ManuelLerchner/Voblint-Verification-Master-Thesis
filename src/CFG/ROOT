session Voblint_CFG in "." = "Voblint_VIMP" +
  description "Procedure-aware CFG: core, trace, collecting, and structural compiler"
  directories
    "Collecting"
    "Compiler"
  theories
    CFG_Def
    CFG_Local_Trace
    LTR_Collect
    LTR_Abstract
    VIMP_Proc_to_CFG
    CFG_Transfer
    Compile_Invariants
    Control_Residual
    Located_Exec
    Control_Simulation
    Compile_Certificate
    Compile_Edge_Determinism
    (* last_writer over path/intra, edge-action functionality resolved for
       compile_prog. *)
    LTR_Last_Write
    CFG_Prune
    (* Per-procedure node classification and edge locality; carries
       valid_ltr_entry_result_eq, the activation procedure-locality theorem. *)
    Compile_Locality
    (* Source-to-local-trace bridge (csim -> valid_ltr), and the completed-run
       exit reachability it feeds. *)
    Located_LTR
  (* Statement indices are allocated directly in the procedure-aware node space.
     Located simulation supplies the path structure used by compiler soundness. *)
