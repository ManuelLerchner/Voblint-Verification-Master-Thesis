session Voblint_Solver in "." = "TD" +
  description "The strategy-tree equation language of the vendored side-effecting solver"
  theories
    Strategy_Tree_Sequencing
    Strategy_Tree_Fold
    Strategy_Tree_Post_Solution
    Strategy_Tree_Combinators
    (* Equation-level normalization: aggregates repeated side effects to one
       key into a single write, so no right-hand side names a key twice. *)
    Strategy_Tree_Side_Buffering
    (* The semantic boundary to the vendored TD solver: executable termination
       to solver-domain membership to part_post_solution, proved once inside
       TD_side_upd_rule. *)
    TD_Solver_Bridge
    (* The named menu of concrete update-rule solvers built on that boundary.
       The sole point where this session names TD's concrete update-rule
       interpretations. *)
    TD_Solver_Menu
