session Voblint_Core in "." = "Voblint_CFG" +
  description "Abstract framework: domains, constraint systems, and TD solver bridge"
  sessions
    TD
  directories
    "Domain"
    "Equations"
    "Solver/Strategy_Tree"
    "Solver/Context"
    "Solver/Context/Activation"
    "Solver/Context/DG"
    "Solver/Exec"
  theories
    Abstract_Domain
    (* Generic numeric-query interface and its derivations from a
       backward_domain instance's own narrowing operators. *)
    Abstract_Numeric_Queries
    Exec_St
    Exec_Placement
    Exec_Backward
    Split_State
    CFG_Enumeration
    Constraint_System
    Constraint_System_Sound
    (* Ordinary __goblint_assert checks: store-only checks, with no
       ghost-domain or additional trace-projection dependency. *)
    Checks
    (* Domain-generic solved-result table: per-point reachability and the
       per-context/per-node lookup surface downstream consumers read. *)
    Analysis_Result
    (* Domain-generic sound (incomplete) decision procedure discharging
       compiled checks, parametric in an arbitrary abstract-state type,
       both per node and per covered context of the result table above. *)
    Abstract_Checks
    State_Restriction
    Exec_Refinement
    Strategy_Tree_Monad
    Strategy_Tree_Rhs
    Strategy_Tree_Relabel
    Solver_Mono
    Strategy_Tree_Do
    Strategy_Tree_Combinators
    (* Equation-level normalization: aggregates repeated side effects to one
       key into a single write, so no right-hand side names a key twice. *)
    Side_Buffering
    Solver_Side_RG
    Solver_Menu
    Activation_Local_Sound
    Activation_Backbone
    DG_Framework
    DG_Soundness
    DG_LTR_Sound
    DG_Ctx_Activation
    Context_Refinement
    DG_Transfer_Combinators
    Routed_Context
    Routed_Context_Unit
    Call_String_Context
    Call_String_Context_Finite
    Call_String_Collecting_Refinement
    Call_String_Routed_Context
    Call_String_Solver_Projection
    Entry_State_Routed_Context
    (* Generic public AnalysisResult/check-report/soundness adapter for a
       routed DG analysis, generic in a classify function and a
       routed_context_hetero interpretation. *)
    DG_Analysis_Adapter
    (* Executable mirror of the abstract D/G spine: the transport between the
       solver's association-list carrier and the function-valued abstract
       states, the executable Base-style spec, and the routing layer every
       domain instantiates. Domain-generic throughout. *)
    Exec_DG_Refines
    Exec_DG_Trees
    Exec_DG_Generator
    (* Solved-key coverage as a graph property: vars_cover from reachability to
       the exit, instead of evaluating the solver's own key set. *)
    DG_Coverage
    Exec_DG_Bridge
    DG_Base_Exec
    Routed_Domain_Exec
    Monovariant_Analysis_Result
