session Voblint_Core in "." = "Voblint_CFG" +
  description "Abstract framework: domains, constraint systems, and TD solver bridge"
  sessions
    TD
  directories
    "Domain"
    "Equations"
    "Solver/TD_Side"
    "Solver/Strategy_Tree"
    "Solver/Context"
    "Solver/Context/Activation"
    "Solver/Context/DG"
    "Solver/Exec"
  theories
    Abstract_Domain
    (* Generic numeric-query interface and its derivations from a
       backward_domain instance's own narrowing operators. *)
    Abstract_Numeric_Queries
    Exec_St
    Exec_Placement
    Exec_Backward
    Split_State
    CFG_Enumeration
    Constraint_System
    Constraint_System_Sound
    (* Ordinary __goblint_assert checks: store-only checks, with no
       ghost-domain or additional trace-projection dependency. *)
    Checks
    (* Domain-generic solved-result table: per-point reachability and the
       per-context/per-node lookup surface downstream consumers read. *)
    Analysis_Result
    (* Domain-generic sound (incomplete) decision procedure discharging
       compiled checks, parametric in an arbitrary abstract-state type,
       both per node and per covered context of the result table above. *)
    Abstract_Checks
    TD_Side_CFG
    Strategy_Tree_Monad
    Strategy_Tree_Do
    Strategy_Tree_Combinators
    TD_Side_Tree
    Exec_Bridge
    Solver_Side_RG
    Solver_Menu
    TD_Side_Eff_Sound
    TD_Side_Eff_Bounds
    TD_Side_Eff_Interface
    TD_Side_Eff_Pipeline
    TD_Side_RHS_Generator
    TD_Side_Eff_Cone_Lemmas
    LTR_TD_Side_Eff_Sound
    LTR_TD_Side_Eff_Exit
    Activation_Local_Sound
    Activation_Backbone
    TD_Side_Eff_Keyed_Gen
    DG_Framework
    DG_Soundness
    DG_LTR_Sound
    DG_Ctx_Activation
    Context_Refinement
    DG_Transfer_Combinators
    Routed_Context
    Routed_Context_Unit
    Call_String_Context
    Call_String_Context_Finite
    Call_String_Collecting_Refinement
    Call_String_Routed_Context
    Call_String_Solver_Projection
    Entry_State_Routed_Context
    (* Generic public AnalysisResult/check-report/soundness adapter for a
       routed DG analysis, generic in a classify function and a
       routed_context_hetero interpretation. *)
    DG_Analysis_Adapter
