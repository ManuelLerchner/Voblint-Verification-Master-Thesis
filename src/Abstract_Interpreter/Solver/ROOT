chapter Voblint

session Voblint_Solver in "." = "TD" +
  description "The strategy-tree equation language of the vendored side-effecting solver"
  theories
    Strategy_Program_Fold
    (* A typed continuation-passing frontend over the homogeneous vendor
       tree: sp_bind's intermediate type need not be the solver carrier,
       only the final answer does. *)
    Strategy_Tree_Program
    (* Equation-level normalization: aggregates repeated side effects to one
       key into a single write, so no right-hand side names a key twice. *)
    Strategy_Tree_Side_Buffering
    (* The solver contract the pipeline assumes. *)
    TD_Solver_Bridge
    (* The global update rule as a value: one solver interpretation for all four. *)
    Globals_Rule
