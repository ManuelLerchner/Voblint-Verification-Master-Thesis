chapter Voblint

(* Parented on HOL-Library, not HOL: the library is otherwise a *sibling* of
   this chain, so every "HOL-Library.X" import below re-elaborates X inside the
   importing session instead of reading it from the library's own prebuilt heap.
   Eight sessions were paying that, 31 elaborations between them. As an ancestor
   it costs nothing -- heap ancestry preloads, it does not import, so no theory
   context changes. *)
session Voblint_VIMP in "." = "HOL-Library" +
  description "VIMP syntax, small-step, and procedure language"
  sessions
    Deriving
    "HOL-IMP"
    "HOL-Computational_Algebra"
  theories
    (* Elaborated here, not where it is used: Voblint_Domain's congruence lattice
       and Voblint_Framework, which re-reads Voblint_Domain, both sit below this
       session and would otherwise each elaborate it. This is their nearest
       common ancestor. *)
    "HOL-Computational_Algebra.Euclidean_Algorithm"
    VIMP_Syntax
    VIMP_Globals
    VIMP_Expr
    VIMP_Special
    VIMP_Proc
    VIMP_Program
    VIMP_Grammar_Generated
    VIMP_Notation
