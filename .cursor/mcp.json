{
  "mcpServers": {
    "isabelle-ir": {
      "type": "http",
      "url": "http://localhost:9148/mcp",
      "timeout": 300000,
      "headers": {
        "Authorization": "Bearer isabelle-local",
        "Accept": "application/json, text/event-stream"
      }
    },
    "isabelle-iq": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/Users/manuellerchner/git/goblint-formalization/ir-repo/iq/iq_bridge.py"
      ],
      "env": {
        "IQ_AUTH_TOKEN": "isabelle-local",
        "IQ_MCP_BRIDGE_HOST": "127.0.0.1",
        "IQ_MCP_BRIDGE_PORT": "8765",
        "IQ_MCP_ALLOWED_ROOTS": "/Users/manuellerchner/git/goblint-formalization",
        "IQ_MCP_ALLOWED_READ_ROOTS": "/Users/manuellerchner/git/goblint-formalization"
      }
    }
  }
}
