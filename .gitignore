*.heap
*.log

# Isabelle
.isabelle/
_opam/
/build/
/output/
/document/*.aux
/document/*.fls
/document/*.fdb_latexmk

# Editor backups / autosaves (Emacs, vim)
*~
\#*\#
.\#*

# IDEs / editors
.cursor/

# Python
__pycache__/
.venv/
.pytest_cache/
.hypothesis/

# pixi
.pixi/

# Dune build products
_build/

# Local OS files
.DS_Store

# Local tool settings
.claude/settings.local.json
/vendor/autocorrode/

# codegen regression driver: build products and the generated module it
# copies in from codegen/generated/ (the copy is a build step, not a source)
codegen/regression/ocaml/Voblint_CLI.ml
codegen/regression/ocaml/*.cm*
codegen/regression/ocaml/*.o
codegen/regression/ocaml/regression-ml

# Regenerable definitional index: `pixi run docs-overview-generate`.
# Its own generator calls it "a gitignored, regenerable index -- not a source
# of truth (the .thy files are)".
docs/generated/DEFINITIONS_OVERVIEW.md
cli/.voblint.*

# Local stamp of the sources the export was generated from (codegen-hash.sh)
codegen/generated/.source-hash

# Thesis data every build regenerates (pixi run thesis-local-data)
thesis/shared/generated/stats.json
thesis/shared/generated/goblint-alignment.json

# Paper: rebuilt from the uncommitted thesis stats.json on every build
paper/generated/stats.tex

# Vale packages fetched by `vale sync`; only the project style is ours.
/.vale/styles/*
!/.vale/styles/Voblint/
# Vendored: jdkato/prompts publishes no release for `vale sync` to pin.
!/.vale/styles/Prompts/
/.vale/.sync.lock
