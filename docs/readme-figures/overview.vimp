// Move the cursor, hover the badges, click the graph.
// Then try: globals "Warrow per origin", call-string depth k=2, context None.

fun i32 smaller(i32 a, i32 b) {
  i32 lo;
  if (a <= b) {
    lo = a;
  } else {
    lo = b;
  }
  return lo;
}

fun main() {
  i32 x = __voblint_nondet_int();
  i32 y = __voblint_nondet_int();

  i32 q = 100 / x;

  i32 n = smaller(3, 7);
  smaller(9, 4);

  if (x <= y) {
    if (y <= x) {
      i32 z = (x == y);
      i32 w = x;
      __voblint_check(z == 1); // PROVED
      __voblint_check(w == y); // PROVED
    }
  }

  i32 c = __voblint_nondet_int();
  i32 u, v;
  if (0 < c) {
    u = 0;
    v = 10;
  } else {
    u = 20;
    v = 30;
  }
  __voblint_check(u <= v); // PROVED

  i32 i = 0;
  while (i < 3) {
    i = i + 1;
  }

  __voblint_check(i == 3); // PROVED
  __voblint_check(n == 7); // REFUTED

  if (i > 5) {
    __voblint_check(i == 0); // NOWARN
  }
}
