<?xml version="1.0" encoding="utf-8"?>
<!--
  LaTeX's `unsrt` style: numeric labels [12] in order of first citation,
  with `plain`-style entries. Originally written for `alpha` labels, [TGS26] followed by
  given-name-first authors and period-separated fields. Written for this thesis
  because Typst's built-in `alphanumeric` style produces the labels but has no
  bibliography layout, and the CSL styles that do produce such labels format
  their entries to German conventions.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>Alphanumeric (plain)</title>
    <id>https://voblint.invalid/plain-numeric</id>
    <category citation-format="numeric"/>
    <updated>2026-09-22T00:00:00+00:00</updated>
  </info>

  <!--
    Hayagriva renders the names of a prose citation (`form: "prose"`) from this
    macro, so it has to serve both uses. It evaluates every position test as
    true in the bibliography, and `near-note` is never true for an in-text
    citation: the first branch is the bibliography entry, the second the prose
    form, "Stemmler et al. [12]".
  -->
  <macro name="author">
    <choose>
      <if position="near-note">
        <names variable="author">
          <!-- Full given names, as LaTeX plain sets them. -->
          <name and="text" delimiter=", " delimiter-precedes-last="contextual"/>
          <label form="short" prefix=", "/>
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </if>
      <else>
        <names variable="author">
          <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1"/>
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <!--
    Same-label entries get a year suffix ([CC79a], [CC79b]). Rendering the
    suffix explicitly keeps it out of the date. Hayagriva takes the first
    variable-bearing element as the flush-aligned label column, which would
    split a bare `citation-label` from its suffix; the bibliography therefore
    wraps this macro in a `names` substitute so the whole label is one element.
  -->
  <macro name="label">
    <group>
      <text variable="citation-label"/>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="container">
    <choose>
      <if type="paper-conference chapter entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text value="In"/>
          <text variable="container-title"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine" match="any">
        <group delimiter=" ">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", ">
          <text variable="genre"/>
          <text variable="publisher"/>
          <text variable="archive"/>
        </group>
      </else-if>
      <else>
        <text variable="publisher"/>
      </else>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <!-- A supplement (`@key[§8.4.1]`) arrives as the locator. -->
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0"
                hanging-indent="false">
    
    <layout suffix=".">
      <!-- No entry has an original author, so the substitute always renders. -->
      <names variable="original-author">
        <substitute>
          <text variable="citation-number" prefix="[" suffix="]"/>
        </substitute>
      </names>
      <group delimiter=". ">
        <text macro="author"/>
        <text variable="title"/>
        <text macro="container"/>
        <text variable="page" prefix="pages "/>
        <text macro="issued"/>
      </group>
    </layout>
  </bibliography>
</style>
