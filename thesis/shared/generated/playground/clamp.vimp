fun i32 clamp(i32 x, i32 lo, i32 hi) {
  if (x < lo) {
    return lo;
  }
  if (x > hi) {
    return hi;
  }
  return x;
}

fun main() {
  i32 t = __voblint_nondet_int();
  i32 p = clamp(t, 0, 100);
  __voblint_check(0 <= p && p <= 100);
  __voblint_check(p > 100);
  __voblint_check(p == 50);
  i32 a = 1000 / (p + 1);
  i32 b = 1000 / p;
  if (p > 100) {
    __voblint_check(p == 0);
  }
}
