{
  "source": "thesis/shared/notation.toml",
  "base": "https://manuellerchner.github.io/Voblint-Verification-Master-Thesis/",
  "groups": {
    "operator": {
      "title": "Semantic operators and relations"
    },
    "set": {
      "title": "Semantic sets",
      "note": "A calligraphic capital names a semantic set. Its global form lists every parameter; inside a locale or a theory's context block that fixes them, they are omitted."
    },
    "shorthand": {
      "title": "Proof-local shorthands",
      "note": "These names are local abbreviations available while writing proofs in the indicated locales. They are not new definitions: they unfold when parsed, and outside those locale contexts Isabelle shows the underlying expressions."
    }
  },
