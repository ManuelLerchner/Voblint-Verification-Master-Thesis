(menhir
 (modules vimp_parser)
 (flags --table --unused-precedence-levels))

(ocamllex vimp_lexer)

; Same split as cli/dune: generated modules are exempt from warnings, the
; handwritten ones around them are not.

(library
 (name ast_driver_positions)
 (wrapped false)
 (modules vimp_positions))

(library
 (name ast_driver_grammar)
 (wrapped false)
 (modules Voblint_CLI vimp_parser vimp_lexer)
 (libraries ast_driver_positions menhirLib str zarith)
 (flags
  (:standard -w -a)))

(executable
 (name ast_driver)
 (modules vimp_frontend vimp_printer ast_driver)
 (libraries ast_driver_grammar ast_driver_positions str zarith))
