// One call, traced in full (#251): the callee is first solved with a bottom seed,
// because the call's publication into the seed waits until its right-hand side
// answers. Once the seed is published before the exit is read, the expected traces
// lose the bottom pass and the restart.
fun bump(n) {
  return n + 1;
}

fun main() {
  a = bump(5);
  __voblint_check(a == 6);
}
