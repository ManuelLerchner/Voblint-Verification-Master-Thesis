// Run with --typed interval,order: the two analyses ask each other through EvalInt.
// Inside the branch only f(100, 0) arrives, so x = 100 and y = 0.
fun f(i32 x, i32 y) {
  i32 z;
  if (y <= x) {
    __voblint_check((y <= x) + 1 == 2); // proved only with order
    z = (y <= x);
    x = 0;
    __voblint_check(z == 1); // proved from interval's own state
    __voblint_check(y == 1); // fails at the one store reaching it: unknown
  }
}
fun main() {
  f(0, 100);
  f(100, 0);
}
