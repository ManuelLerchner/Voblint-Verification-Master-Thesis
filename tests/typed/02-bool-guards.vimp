// Run with --typed interval: a guard that holds through either operand narrows by
// each operand that can still hold and joins the results.
fun f(i32 x) {
  i32 y;
  if (x > 3 || x > 4) {
    __voblint_check(x >= 4); // || must hold: x > 3 joined with x > 4
  }
  if (x <= 3 && x <= 4) {
  } else {
    __voblint_check(x >= 4); // && must fail: the same two alternatives
  }
  y = 0;
  if (x > 0 && (x < 0 || x < 0)) {
    y = 1; // after x > 0 neither x < 0 can hold: unreachable
  }
  __voblint_check(y == 0);
}
fun main() {
  f(0 - 5);
  f(5);
}
