// PARAM: --analysis interval
// Mirror of 01-straight_line_proved.vimp's PROVED witness: an exact
// negative write refutes the same condition instead of proving it. Pairs
// PROVED and REFUTED witnesses for one mechanism (exact assignment),
// rather than leaving REFUTED coverage to a single case buried inside a
// mixed-verdict file.
void main() {
  x := 0 - 5;
  __voblint_check(0 < x) // REFUTED
}
