// PARAM: --analysis interval
// Literal Goblint idiom (https://goblint.readthedocs.io/en/latest/developer-guide/testing/):
// "__goblint_check(0); // NOWARN (unreachable)" -- a constant-false check as
// a dead-code sentinel, rather than a real condition that happens to be
// dead (see 02-unreachable_nowarn.vimp for that variant). VIMP has no
// integer truthiness, so the literal constant is the bexp "false" itself.
// main itself may not contain a return (wf_source_program's no_return
// conjunct), so the return lives in a helper procedure p instead, called
// destination-less.
void p() {
  int32 x;
  x := 5;
  __voblint_check(true); // PROVED
  return x;
  __voblint_check(false) // NOWARN (unreachable)
}
void main() {
  p()
}
