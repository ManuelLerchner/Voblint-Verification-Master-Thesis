// PARAM: --analysis sign
// Ported from Example_Analysis_Result_Regression.thy
// (result_demo_sign_stmt1_reachable, result_demo_sign_stmt2_unreachable).
// x = 5 makes x < 0 infeasible: the then-branch is DEAD and the points around
// it stay live. 05-unreachable_dead_branch_literal.vimp is the Interval case.
fun main() {
  x = 5;
  __voblint_check(0 < x); // PROVED
  if (x < 0) {
    y = 1;
    __voblint_check(false); // NOWARN
  } else {
    y = 2;
  }
  __voblint_check(0 < x); // PROVED
}
