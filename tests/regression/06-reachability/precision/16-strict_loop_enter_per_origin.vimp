// PARAM: --analysis interval --globals per-origin
// Same program as 10-strict_loop_enter.vimp under the per-origin update rule.
// Regression for issue #160: an explicit --globals used to have no
// reachability flag, so the NOWARN check below printed a vacuous PROVED for
// the bottom state instead of being suppressed. Every globals rule now reads
// reachability from its own solved table, so this agrees with the default
// rule exactly.
global g;
fun main() {
  x = 0;
  while (x < 50) {
    g = 1;
    x = x + 1;
  }
  __voblint_check(x == 50); // PROVED
  if (50 < x) {
    i = 0;
    while (i <= 0) {
      g = 57;
      i = i - 1;
    }
    __voblint_check(true); // NOWARN (unreachable)
  }
}
