// PARAM: --analysis interval --context entry-state
// Call/return semantics of the entry-state context analysis over a declared
// global. The local unknown carries every VIMP variable, so g crosses the
// call boundary in the same slot a local does: bump reads the g main wrote
// before the call, writes it, and returns it, and main then observes both
// the returned value and the callee's update. The three calls carry
// different arguments -- two literals and one that is itself the global g
// -- so bump is analyzed under three distinct entry-state contexts
// ([5,5], [4,4], [19,19]) and n binds exactly in each. The third call also
// locks in that a global-valued actual argument is evaluated against the
// caller's real state at the call site, not a globals-bottomed one -- see
// src/Examples/Interval/Ctx/Example_Interval_DG_Ctx_Globals_Regression.thy
// for the same program with its per-context abstract states pinned.
global g;
void bump(n) {
  g := g + n;
  return g
}
void main() {
  int32 a, b, c;
  g := 10;
  a := bump(5);
  b := bump(4);
  __voblint_check(a == 15); // PROVED
  __voblint_check(b == 19); // PROVED
  __voblint_check(g == 19); // PROVED
  c := bump(g);
  __voblint_check(c == 38); // PROVED
  __voblint_check(g == 38) // PROVED
}
