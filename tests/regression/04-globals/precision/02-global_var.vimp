// PARAM: --analysis interval
// Declared global mutated across two calls; exercises declared_global_vars
// wiring. Base-style migration acceptance case (issue tracked alongside
// 12-widening/precision/01-global_self_feedback.vimp): total lives in the
// same reachability-lifted local unknown as every local, flow-sensitively
// through both calls to inc, so its exact value (7) survives to the check
// -- no separate flow-insensitive global summary exists to join total's
// prior value against its own write anymore.
global total;
void inc(n) {
  total := total + n
}
void main() {
  total := 0;
  inc(3);
  inc(4);
  __voblint_check(0 < total) // PROVED
}
