// PARAM: --analysis interval
// Declared global mutated across two calls; exercises declared_global_vars
// wiring. UNKNOWN for the same reason as 12-widening/known-imprecision/'s
// pair: total's write reads its own prior value through the flow-
// insensitive global summary, a self-referential fixpoint dependency the
// join-only backend proves sound but not exact (total is really 7 here,
// the summary only proves total=[0,+inf]).
global total;
void inc(n) {
  total := total + n
}
void main() {
  total := 0;
  inc(3);
  inc(4);
  __voblint_check(0 < total) // UNKNOWN
}
