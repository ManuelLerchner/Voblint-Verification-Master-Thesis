// PARAM: --analysis interval
// p is called twice, so counter's concrete value at the check is fixed at
// 2 -- yet the analysis cannot bound it.
// Mechanism: p is entered twice in one context, with counter = 0 and then
// counter = 1, and widening at p's entry takes counter's upper bound to the
// i32 limit. counter + 1 may then overflow, so under the default assume_top
// counter is the full i32 range at the check (measured) -- the same
// call-site widening as
// 04-globals/known-imprecision/01-repeated_call_site_widening.vimp. A
// single call to p, by contrast, needs no fixpoint iteration and resolves
// counter exactly; it is the repetition, not the declaration itself, that
// costs precision here. Contrast with
// 04-globals/precision/05-glocal_not_global_by_name.vimp: same program,
// same two calls, but Glocal is undeclared and stays exact throughout.
global counter;
fun p() {
  counter = counter + 1;
}
fun main() {
  Glocal = 1;
  p();
  p();
  __voblint_check(counter < 5); // UNKNOWN
}
