// PARAM: --analysis interval --program-globals flow-insensitive
// The sequence of 06-sequential_global_proved.vimp with program globals
// flow-insensitive. x lives at its own global unknown, which must cover every
// value x holds anywhere: the initial zero, published by the program entry,
// joins the two writes, and the check at the end sees x in [0,1]. The exact
// check is lost; the range check survives.
global x;
fun main() {
  x = 0;
  x = 1;
  __voblint_check(x == 1); // UNKNOWN
  __voblint_check(0 <= x); // PROVED
}
