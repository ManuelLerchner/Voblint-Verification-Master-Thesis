// PARAM: --analysis interval
// The concrete value of total here is fixed at 7, so total < 100 genuinely
// holds -- but the analysis cannot establish it. Mechanism: inc is entered
// from two call sites, with n = 3 and n = 4, in one context, and widening
// at the entry of inc takes n to [3,2147483647]. total + n may then
// overflow, so under the default assume_top the analysis sets total to the
// full i32 range and the bound < 100 stays undecided. The warrow-per-origin
// rule keeps the same result: the loss is on the entered formal, which the
// global's update rule does not touch. --context entry-state separates the
// two calls and proves the check.
//
// 04-globals/known-imprecision/04-global_var.vimp is the same program with
// the check 0 < total, lost the same way.

global i32 total;
fun inc(i32 n) {
  total = total + n;
}
fun main() {
  total = 0;
  inc(3);
  inc(4);
  __voblint_check(total < 100); // UNKNOWN
}
