// PARAM: --analysis sign --context entry-state
// Regression for a silent wrong-output bug: the collapsed entry-state
// GraphViz renderers took only an imp_prog and hard-wired Interval's own
// result table, so --analysis sign --context entry-state --graph-snapshot
// rendered Interval's states under a Sign banner -- node labels read
// a=[9,9] rather than a=Positive. The four collapsed renderers now take an
// analysis_domain and read the selected domain's own entry-state table.
// This fixture pins that the rendering is Sign's: the labels below are
// Sign values, and no interval notation appears anywhere in the graph.
// Collapsed rendering is domain-generic because lookup_joined_state joins
// a point's covered contexts away before the renderer sees them, leaving
// an ordinary per-node abs_state that projects into abstract_value -- the
// same projection the monovariant renderer already used. The expanded
// (--context-graph expanded) renderer is typed in the context type itself
// and stays Interval-only, explicitly rejected for other domains rather
// than silently reused.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//   cluster_ctx_1:
//     square_pp0_ctx1
//     square_entry_square_ctx1
//     square_result_square_ctx1
//
// nodes:
//   main_pp5_ctx0: pp5
//       check 0<b
//       a=Positive
//       b=Positive
//   main_pp6_ctx0: pp6
//   main_result_main_ctx0: exit_main
//   main_entry_main_ctx0: entry_main
//   square_pp0_ctx1: pp0
//   main_pp2_ctx0: pp2
//   main_pp3_ctx0: pp3
//   square_entry_square_ctx1: entry_square
//   main_pp4_ctx0: pp4
//       check 0<a
//       a=Positive
//       b=Positive
//   square_result_square_ctx1: exit_square
//
// edges:
//   main_pp5_ctx0 -> main_pp6_ctx0: check(0<b)
//   main_pp6_ctx0 -> main_result_main_ctx0: terminate
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   square_pp0_ctx1 -> square_result_square_ctx1: return n*n
//   square_entry_square_ctx1 -> square_pp0_ctx1: body(square)
//   main_pp4_ctx0 -> main_pp5_ctx0: check(0<a)
//   main_pp2_ctx0 -> square_entry_square_ctx1: enter square(3)
//   main_pp3_ctx0 -> square_entry_square_ctx1: enter square(4)
//   square_result_square_ctx1 -> main_pp3_ctx0: combine a
//   square_result_square_ctx1 -> main_pp4_ctx0: combine b
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return square
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return square
// EXPECT-GRAPH-END

void square(n) {
  return n * n
}
void main() {
  a := square(3);
  b := square(4);
  __voblint_check(0 < a); // PROVED
  __voblint_check(0 < b) // PROVED
}
