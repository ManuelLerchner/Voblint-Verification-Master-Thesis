// PARAM: --analysis sign --context entry-state
// Regression for a silent wrong-output bug: the entry-state GraphViz
// renderers took only an imp_prog and hard-wired Interval's own result
// table, so --analysis sign --context entry-state --graph-snapshot rendered
// Interval's states under a Sign banner -- node labels read a=[9,9] rather
// than a=Positive. The renderers now take an analysis_domain and read the
// selected domain's own entry-state table. This fixture pins that the
// rendering is Sign's: the labels below are Sign values, and no interval
// notation appears anywhere in the graph.
// The routing decision behind the enter edges is callee_ctx_of, taken once
// for every domain from the solved result table; before that it existed
// only as an Interval-typed mirror and every other domain was rejected
// outright.
// Sign gives square one context, not two: the entry-state context is the
// tuple of formals' abstract values, and 3 and 4 are both Positive, so the
// two call sites route to the same activation. 15-expanded_int_own_domain
// is the same program under Int, where they do not.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_exit_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: square / Positive
//     square_exit_square_ctx0
//     square_pp0_ctx0
//     square_entry_square_ctx0
//
// nodes:
//   main_pp5_ctx0: pp5 [proved]
//       a=Positive
//       b=Positive
//       check 0 < b
//   main_pp6_ctx0: pp6
//       a=Positive
//       b=Positive
//   main_exit_main_ctx0: exit_main
//       a=Positive
//       b=Positive
//   main_pp2_ctx0: pp2
//       a=Top
//       b=Top
//   main_pp3_ctx0: pp3
//       a=Positive
//       b=Top
//   main_pp4_ctx0: pp4 [proved]
//       a=Positive
//       b=Positive
//       check 0 < a
//   main_entry_main_ctx0: entry_main
//       a=Top
//       b=Top
//   square_exit_square_ctx0: exit_square
//       n=Positive
//       ret=Positive
//   square_pp0_ctx0: pp0
//       n=Positive
//       ret=Top
//   square_entry_square_ctx0: entry_square
//       n=Positive
//       ret=Top
//
// edges:
//   square_pp0_ctx0 -> square_exit_square_ctx0: return n * n
//   main_pp4_ctx0 -> main_pp5_ctx0: check(0 < a)
//   main_pp5_ctx0 -> main_pp6_ctx0: check(0 < b)
//   main_pp6_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   square_entry_square_ctx0 -> square_pp0_ctx0: body(square)
//   main_pp2_ctx0 -> square_entry_square_ctx0: enter square(3)
//   square_exit_square_ctx0 -> main_pp3_ctx0: combine a := ret
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return square
//   main_pp3_ctx0 -> square_entry_square_ctx0: enter square(4)
//   square_exit_square_ctx0 -> main_pp4_ctx0: combine b := ret
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return square
// EXPECT-GRAPH-END

fun square(n) {
  return n * n;
}
fun main() {
  a = square(3);
  b = square(4);
  __voblint_check(0 < a); // PROVED
  __voblint_check(0 < b); // PROVED
}
