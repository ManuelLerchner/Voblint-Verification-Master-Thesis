//   factorial_pp1_ctx2 -> factorial_pp3_ctx2: not (n<2)
//   factorial_pp1_ctx3 -> factorial_pp2_ctx3: n<2
//   factorial_pp1_ctx3 -> factorial_pp3_ctx3: not (n<2)
//   factorial_pp1_ctx4 -> factorial_pp2_ctx4: n<2
//   factorial_pp1_ctx4 -> factorial_pp3_ctx4: not (n<2)
//   factorial_pp1_ctx5 -> factorial_pp2_ctx5: n<2
