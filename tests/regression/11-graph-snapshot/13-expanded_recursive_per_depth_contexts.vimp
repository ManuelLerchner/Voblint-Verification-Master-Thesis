//   factorial_pp2_ctx1 -> factorial_result_factorial_ctx1: return 1
//   factorial_pp2_ctx2 -> factorial_result_factorial_ctx2: return 1
//   factorial_pp2_ctx3 -> factorial_result_factorial_ctx3: return 1
//   factorial_pp2_ctx4 -> factorial_result_factorial_ctx4: return 1
//   factorial_pp2_ctx5 -> factorial_result_factorial_ctx5: return 1
