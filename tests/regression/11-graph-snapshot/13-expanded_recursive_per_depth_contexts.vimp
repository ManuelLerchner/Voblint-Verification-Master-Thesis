//   factorial_pp3_ctx2 -> factorial_pp4_ctx2: call-to-return factorial
//   factorial_pp3_ctx3 -> factorial_pp4_ctx3: call-to-return factorial
//   factorial_pp3_ctx4 -> factorial_pp4_ctx4: call-to-return factorial
//   factorial_pp3_ctx5 -> factorial_pp4_ctx5: call-to-return factorial
//   main_pp7_ctx0 -> main_pp8_ctx0: call-to-return factorial
//   main_pp8_ctx0 -> main_pp9_ctx0: call-to-return factorial
// EXPECT-GRAPH-END

int32 factorial(int32 n) {
  int32 r;
  __voblint_check(0 < n); // PROVED

  if (n < 2) {
    return 1
  } else {
    r := factorial(n - 1);
    __voblint_check(0 < r); // PROVED
    return n * r
  }
}

void main() {
  int32 a, b;
  a := factorial(3);
  b := factorial(4);

  __voblint_check(a == 6);   // PROVED
  __voblint_check(b == 24)   // PROVED
}
