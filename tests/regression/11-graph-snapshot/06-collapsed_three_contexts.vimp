// PARAM: --analysis interval --context entry-state --context-graph collapsed --dot-full
// Collapsed counterpart of 04-expanded_three_contexts.vimp: identical
// program, default rendering (no --context-graph). Where expanded draws
// three clusters with n=[5,5]/[4,4]/[19,19], collapsed has exactly one
// physical CFG region for bump and shows n's join across all three calls:
// [5,5] sup [4,4] sup [19,19] = [4,19] under ivl's semilattice_sup. The
// solver still kept the three calls in distinct, un-joined contexts
// internally -- main's own checks (a==6, b==5, c==20) still come back
// PROVED, not UNKNOWN -- only the rendering collapses them, the same
// point 13-full-state-dot/02-entry_state_context_join.vimp makes for two
// call sites instead of three.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_pp10_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//   cluster_ctx_1:
//     bump_pp1_ctx1
//     bump_pp0_ctx1
//     bump_entry_bump_ctx1
//     bump_result_bump_ctx1
//
// nodes:
//   bump_pp1_ctx1: pp1
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[5,20]
//       n=[4,19]
//   main_pp8_ctx0: pp8
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp9_ctx0: pp9
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp10_ctx0: pp10
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_result_main_ctx0: exit_main
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   bump_pp0_ctx1: pp0
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[4,19]
//   main_entry_main_ctx0: entry_main
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[0,0]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp3_ctx0: pp3
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[0,0]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp4_ctx0: pp4
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp5_ctx0: pp5
//       a=[6,6]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   main_pp6_ctx0: pp6
//       a=[6,6]
//       b=[5,5]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   bump_entry_bump_ctx1: entry_bump
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[4,19]
//   main_pp7_ctx0: pp7
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       #ret=[-inf,+inf]
//       g=[19,19]
//       m=[-inf,+inf]
//       n=[-inf,+inf]
//   bump_result_bump_ctx1: exit_bump
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//       #ret=[5,20]
//       g=[19,19]
//       m=[5,20]
//       n=[4,19]
//
// edges:
//   bump_pp1_ctx1 -> bump_result_bump_ctx1: return m
//   main_pp8_ctx0 -> main_pp9_ctx0: check(b==5)
//   main_pp9_ctx0 -> main_pp10_ctx0: check(c==20)
//   main_pp10_ctx0 -> main_result_main_ctx0: terminate
//   bump_pp0_ctx1 -> bump_pp1_ctx1: m := n+1
//   main_entry_main_ctx0 -> main_pp3_ctx0: nop
//   main_pp3_ctx0 -> main_pp4_ctx0: g := 19
//   bump_entry_bump_ctx1 -> bump_pp0_ctx1: nop
//   main_pp7_ctx0 -> main_pp8_ctx0: check(a==6)
//   main_pp4_ctx0 -> bump_entry_bump_ctx1: enter bump(5)
//   main_pp5_ctx0 -> bump_entry_bump_ctx1: enter bump(4)
//   main_pp6_ctx0 -> bump_entry_bump_ctx1: enter bump(g)
//   bump_result_bump_ctx1 -> main_pp5_ctx0: combine a
//   bump_result_bump_ctx1 -> main_pp6_ctx0: combine b
//   bump_result_bump_ctx1 -> main_pp7_ctx0: combine c
//   main_pp4_ctx0 -> main_pp5_ctx0: call-to-return bump
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return bump
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return bump
// EXPECT-GRAPH-END

global int32 g;

int32 bump(int32 n) {
  int32 m;
  m := n + 1;
  return m
}
void main() {
  int32 a, b, c;
  g := 19;
  a := bump(5);
  b := bump(4);
  c := bump(g);
  __voblint_check(a == 6); // PROVED
  __voblint_check(b == 5); // PROVED
  __voblint_check(c == 20) // PROVED
}
