// PARAM: --analysis interval --context entry-state
// Two live (not dead) entry-state contexts disagree on the same source
// check: f/[1] proves n==1, f/[2] refutes it. Neither activation is
// unreachable, so aggregate_verdicts (Contextual_Check_Report.thy) combines two
// Decided verdicts via check_result's own semilattice_sup, and
// Check_Proved != Check_Refuted forces sup_check_result to its Check_Unknown
// case -- distinct from the Dead-suppression path 06-reachability/precision/
// 06-unreachable_dead_branch_entry_state.vimp and 11-graph-snapshot/
// 05-expanded_mixed_dead_live_check.vimp already cover, where one side
// contributes Dead (the aggregation's identity element) rather than a
// second, conflicting Decided verdict. The text report prints one verdict
// per source check, so UNKNOWN is not a failure of precision here -- it is
// the sound answer once two live contexts genuinely disagree. The graph
// keeps the two apart in its per-context clusters.
// still show the individual PROVED/REFUTED verdicts underneath.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_exit_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: f / [1,1]
//     f_pp1_ctx0
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_2: f / [2,2]
//     f_pp1_ctx1
//     f_exit_f_ctx1
//     f_pp0_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_exit_main_ctx0: exit_main
//   main_pp2_ctx0: pp2
//   main_pp3_ctx0: pp3
//   main_pp4_ctx0: pp4
//   main_entry_main_ctx0: entry_main
//   f_pp1_ctx0: pp1
//       n=[1,1]
//   f_exit_f_ctx0: exit_f
//       n=[1,1]
//   f_pp0_ctx0: pp0 [proved]
//       n=[1,1]
//       check n == 1
//   f_entry_f_ctx0: entry_f
//       n=[1,1]
//   f_pp1_ctx1: pp1
//       n=[2,2]
//   f_exit_f_ctx1: exit_f
//       n=[2,2]
//   f_pp0_ctx1: pp0 [refuted]
//       n=[2,2]
//       check n == 1
//   f_entry_f_ctx1: entry_f
//       n=[2,2]
//
// edges:
//   f_pp0_ctx0 -> f_pp1_ctx0: check(n == 1)
//   f_pp0_ctx1 -> f_pp1_ctx1: check(n == 1)
//   f_pp1_ctx0 -> f_exit_f_ctx0: return
//   f_pp1_ctx1 -> f_exit_f_ctx1: return
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp0_ctx1: body(f)
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   main_pp2_ctx0 -> f_entry_f_ctx0: enter f(1)
//   f_exit_f_ctx0 -> main_pp3_ctx0: combine
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return f
//   main_pp3_ctx0 -> f_entry_f_ctx1: enter f(2)
//   f_exit_f_ctx1 -> main_pp4_ctx0: combine
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun f(n) {
  __voblint_check(n == 1); // UNKNOWN (ctx [1]: PROVED, ctx [2]: REFUTED)
}
fun main() {
  f(1);
  f(2);
}
