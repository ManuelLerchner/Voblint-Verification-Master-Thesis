// PARAM: --analysis sign --context entry-state
// The expanded rendering at a domain other than Interval, and the default
// one: an entry-state run draws one node per (point, context) unless
// --context-graph collapsed asks for the joined view. The routing decision
// behind the enter edges is callee_ctx_of, taken once for every domain from
// the solved result table; before that it existed only as an Interval-typed
// mirror and every other domain was rejected outright.
// Sign gives square one context, not two: the entry-state context is the
// tuple of formals' abstract values, and 3 and 4 are both Positive, so the
// two call sites route to the same activation. 15-expanded_int_own_domain
// is the same program under Int, where they do not.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//   cluster_ctx_1:
//     square_pp0_ctx1
//     square_entry_square_ctx1
//     square_result_square_ctx1
//
// nodes:
//   main_pp5_ctx0: pp5
//       a=Positive
//       b=Positive
//       check 0<b
//   main_pp6_ctx0: pp6
//       a=Positive
//       b=Positive
//   main_result_main_ctx0: exit_main
//       a=Positive
//       b=Positive
//   main_entry_main_ctx0: entry_main
//       a=Top
//       b=Top
//   square_pp0_ctx1: pp0
//       n=Positive
//   main_pp2_ctx0: pp2
//       a=Top
//       b=Top
//   main_pp3_ctx0: pp3
//       a=Positive
//       b=Top
//   square_entry_square_ctx1: entry_square
//       n=Positive
//   main_pp4_ctx0: pp4
//       a=Positive
//       b=Positive
//       check 0<a
//   square_result_square_ctx1: exit_square
//       n=Positive
//       ret=Positive
//
// edges:
//   main_pp5_ctx0 -> main_pp6_ctx0: check(0<b)
//   main_pp6_ctx0 -> main_result_main_ctx0: terminate
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   square_pp0_ctx1 -> square_result_square_ctx1: return n*n
//   square_entry_square_ctx1 -> square_pp0_ctx1: body(square)
//   main_pp4_ctx0 -> main_pp5_ctx0: check(0<a)
//   main_pp2_ctx0 -> square_entry_square_ctx1: enter square(3)
//   main_pp3_ctx0 -> square_entry_square_ctx1: enter square(4)
//   square_result_square_ctx1 -> main_pp3_ctx0: combine a := #ret
//   square_result_square_ctx1 -> main_pp4_ctx0: combine b := #ret
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return square
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return square
// EXPECT-GRAPH-END

void square(n) {
  return n * n
}
void main() {
  a := square(3);
  b := square(4);
  __voblint_check(0 < a); // PROVED
  __voblint_check(0 < b) // PROVED
}
