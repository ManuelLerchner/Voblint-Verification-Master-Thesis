// PARAM: --analysis interval --context entry-state --dot
// The same source check renders differently in each of f's two entry-state
// contexts: under n=[1,1] the guard n<2 is live and the check is decided
// (PROVED); under n=[5,5] the same guard is false, so the check's own node is
// unreachable and renders [dead] instead of a verdict. This is what
// per-context rendering exists for: a single shared CFG node for that check
// could show only one verdict, so the dead activation would disappear into
// (or be shadowed by) the live one. One cluster per context keeps both.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_exit_main_ctx0
//     main_pp4_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: f / [1,1]
//     f_pp1_ctx0
//     f_pp3_ctx0
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_2: f / [5,5]
//     f_pp1_ctx1
//     f_pp3_ctx1
//     f_exit_f_ctx1
//     f_pp0_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_exit_main_ctx0: exit_main
//   main_pp4_ctx0: pp4
//   main_pp5_ctx0: pp5
//   main_pp6_ctx0: pp6
//   main_entry_main_ctx0: entry_main
//   f_pp1_ctx0: pp1 [proved]
//       n=[1,1]
//       check n == 1
//   f_pp3_ctx0: pp3
//       n=[1,1]
//   f_exit_f_ctx0: exit_f
//       n=[1,1]
//   f_pp0_ctx0: pp0
//       n=[1,1]
//   f_entry_f_ctx0: entry_f
//       n=[1,1]
//   f_pp1_ctx1: pp1 [unreachable]
//       unreachable
//       check n == 1 [dead]
//   f_pp3_ctx1: pp3
//       n=[5,5]
//   f_exit_f_ctx1: exit_f
//       n=[5,5]
//   f_pp0_ctx1: pp0
//       n=[5,5]
//   f_entry_f_ctx1: entry_f
//       n=[5,5]
//
// edges:
//   f_pp0_ctx0 -> f_pp1_ctx0: [n < 2]
//   f_pp0_ctx1 -> f_pp1_ctx1: [n < 2]
//   f_pp0_ctx0 -> f_pp3_ctx0: ![n < 2]
//   f_pp0_ctx1 -> f_pp3_ctx1: ![n < 2]
//   f_pp1_ctx0 -> f_pp3_ctx0: check(n == 1)
//   f_pp1_ctx1 -> f_pp3_ctx1: check(n == 1)
//   f_pp3_ctx0 -> f_exit_f_ctx0: return
//   f_pp3_ctx1 -> f_exit_f_ctx1: return
//   main_pp6_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp0_ctx1: body(f)
//   main_entry_main_ctx0 -> main_pp4_ctx0: body(main)
//   main_pp4_ctx0 -> f_entry_f_ctx0: enter f(1)
//   f_exit_f_ctx0 -> main_pp5_ctx0: combine 
//   main_pp4_ctx0 -> main_pp5_ctx0: call-to-return f
//   main_pp5_ctx0 -> f_entry_f_ctx1: enter f(5)
//   f_exit_f_ctx1 -> main_pp6_ctx0: combine 
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun f(n) {
  if (n < 2) {
    __voblint_check(n == 1);
  }
}
fun main() {
  f(1);
  f(5);
}
