// PARAM: --analysis interval
// Canonical CFG snapshot coverage: a procedure call with a formal and a used
// return value, covering the interprocedural shape (two clusters, plus
// EnterEdge/CombineEdge/CallToReturnEdge) -- see 01-straight_line.vimp in
// this same group for the single-cluster case and why this pair pins the
// two structural shapes.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: inc / unit
//     inc_exit_inc_ctx0
//     inc_pp0_ctx0
//     inc_entry_inc_ctx0
//   cluster_ctx_1: main / unit
//     main_pp4_ctx0
//     main_exit_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   inc_exit_inc_ctx0: exit_inc
//       n=[5,5]
//       ret=[6,6]
//   main_pp4_ctx0: pp4
//       r=[6,6]
//   main_exit_main_ctx0: exit_main
//       r=[6,6]
//   inc_pp0_ctx0: pp0
//       n=[5,5]
//       ret=[-inf,+inf]
//   main_pp2_ctx0: pp2
//       r=[-inf,+inf]
//   inc_entry_inc_ctx0: entry_inc
//       n=[5,5]
//       ret=[-inf,+inf]
//   main_pp3_ctx0: pp3 [proved]
//       r=[6,6]
//       check 0 < r
//   main_entry_main_ctx0: entry_main
//       r=[-inf,+inf]
//
// edges:
//   inc_pp0_ctx0 -> inc_exit_inc_ctx0: return n + 1
//   main_pp3_ctx0 -> main_pp4_ctx0: check(0 < r)
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   inc_entry_inc_ctx0 -> inc_pp0_ctx0: body(inc)
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   main_pp2_ctx0 -> inc_entry_inc_ctx0: enter inc(5)
//   inc_exit_inc_ctx0 -> main_pp3_ctx0: combine r := ret
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return inc
// EXPECT-GRAPH-END

fun inc(n) {
  return n + 1;
}
fun main() {
  r = inc(5);
  __voblint_check(0 < r); // PROVED
}
