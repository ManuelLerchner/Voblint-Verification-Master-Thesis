// PARAM: --analysis interval
// Canonical CFG snapshot coverage: a single procedure, straight-line CFG,
// one cluster. See 02-call_return.vimp in this same group for the
// interprocedural (multi-cluster, call/combine/call-to-return edge) case.
// This pair pins the two structural shapes -- single-cluster and
// interprocedural -- as a regression lock on
// contextual_analysis_canonical_text (Analysis_Graph_Export.thy). Other groups
// carry EXPECT-GRAPH blocks for their own reasons; these two exist to pin
// the shape itself.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp1_ctx0
//     main_pp2_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp1_ctx0: pp1 [proved]
//       x=[5,5]
//       check 0 < x
//   main_pp2_ctx0: pp2
//       x=[5,5]
//   main_exit_main_ctx0: exit_main
//       x=[5,5]
//   main_pp0_ctx0: pp0
//       x=[-inf,+inf]
//   main_entry_main_ctx0: entry_main
//       x=[-inf,+inf]
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: x := 5
//   main_pp1_ctx0 -> main_pp2_ctx0: check(0 < x)
//   main_pp2_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END

fun main() {
  x = 5;
  __voblint_check(0 < x); // PROVED
}
