// PARAM: --analysis interval --context entry-state
// Same program as 03-procedures/precision/04-two_call_sites_entry_state.vimp
// (see that file for the precision claim), captured as a canonical CFG
// snapshot instead: --graph-snapshot's clusters are keyed by procedure
// identity, not by entry-state context (the underlying CFG has one
// physical node per program point regardless of how many contexts the
// solver later associates with it), so square still renders as a single
// cluster here -- the two distinct entry-state contexts show up in the
// check annotations at main's own nodes (a=[9,9], b=[16,16], both PROVED),
// not as duplicated clusters.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//   cluster_ctx_1:
//     square_pp0_ctx1
//     square_entry_square_ctx1
//     square_result_square_ctx1
//   cluster_ctx_2:
//     square_pp0_ctx2
//     square_entry_square_ctx2
//     square_result_square_ctx2
//
// nodes:
//   main_pp5_ctx0: pp5
//       a=[9,9]
//       b=[16,16]
//       check b==16
//   main_pp6_ctx0: pp6
//       a=[9,9]
//       b=[16,16]
//   main_result_main_ctx0: exit_main
//       a=[9,9]
//       b=[16,16]
//   main_entry_main_ctx0: entry_main
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//   square_pp0_ctx1: pp0
//       n=[3,3]
//   square_pp0_ctx2: pp0
//       n=[4,4]
//   main_pp2_ctx0: pp2
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//   main_pp3_ctx0: pp3
//       a=[9,9]
//       b=[-inf,+inf]
//   square_entry_square_ctx1: entry_square
//       n=[3,3]
//   square_entry_square_ctx2: entry_square
//       n=[4,4]
//   main_pp4_ctx0: pp4
//       a=[9,9]
//       b=[16,16]
//       check a==9
//   square_result_square_ctx1: exit_square
//       n=[3,3]
//       ret=[9,9]
//   square_result_square_ctx2: exit_square
//       n=[4,4]
//       ret=[16,16]
//
// edges:
//   main_pp5_ctx0 -> main_pp6_ctx0: check(b==16)
//   main_pp6_ctx0 -> main_result_main_ctx0: terminate
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   square_pp0_ctx1 -> square_result_square_ctx1: return n*n
//   square_pp0_ctx2 -> square_result_square_ctx2: return n*n
//   square_entry_square_ctx1 -> square_pp0_ctx1: body(square)
//   square_entry_square_ctx2 -> square_pp0_ctx2: body(square)
//   main_pp4_ctx0 -> main_pp5_ctx0: check(a==9)
//   main_pp2_ctx0 -> square_entry_square_ctx1: enter square(3)
//   main_pp3_ctx0 -> square_entry_square_ctx2: enter square(4)
//   square_result_square_ctx1 -> main_pp3_ctx0: combine a := #ret
//   square_result_square_ctx2 -> main_pp4_ctx0: combine b := #ret
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return square
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return square
// EXPECT-GRAPH-END

void square(n) {
  return n * n
}
void main() {
  a := square(3);
  b := square(4);
  __voblint_check(a == 9); // PROVED
  __voblint_check(b == 16) // PROVED
}
