// PARAM: --analysis interval --context entry-state --context-graph expanded --dot-full
// Same shape as 03-two_call_sites_entry_state.vimp's square, but three call
// sites and --context-graph expanded instead of the default collapsed: where
// collapsed draws bump's CFG region once and shows n's join across every
// context (n=[4,19] there, per 13-full-state-dot/02-entry_state_context_join.vimp),
// expanded draws one cluster per (call site, entered context) pair, so bump's
// three activations render as three distinct clusters with their own
// un-joined n. No collapsed-mode join ever touches the rendering here.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp7_ctx0
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//   cluster_ctx_1:
//     bump_pp1_ctx1
//     bump_pp0_ctx1
//     bump_entry_bump_ctx1
//     bump_result_bump_ctx1
//   cluster_ctx_2:
//     bump_pp1_ctx2
//     bump_pp0_ctx2
//     bump_entry_bump_ctx2
//     bump_result_bump_ctx2
//   cluster_ctx_3:
//     bump_pp1_ctx3
//     bump_pp0_ctx3
//     bump_entry_bump_ctx3
//     bump_result_bump_ctx3
//
// nodes:
//   bump_pp1_ctx1: pp1
//       n=[19,19]
//       m=[20,20]
//   bump_pp1_ctx2: pp1
//       n=[4,4]
//       m=[5,5]
//   bump_pp1_ctx3: pp1
//       n=[5,5]
//       m=[6,6]
//   main_pp7_ctx0: pp7
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       check b==5
//   main_pp8_ctx0: pp8
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       check c==20
//   main_pp9_ctx0: pp9
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//   main_result_main_ctx0: exit_main
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//   bump_pp0_ctx1: pp0
//       n=[19,19]
//       m=[-inf,+inf]
//   bump_pp0_ctx2: pp0
//       n=[4,4]
//       m=[-inf,+inf]
//   bump_pp0_ctx3: pp0
//       n=[5,5]
//       m=[-inf,+inf]
//   main_entry_main_ctx0: entry_main
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//   main_pp3_ctx0: pp3
//       a=[-inf,+inf]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//   main_pp4_ctx0: pp4
//       a=[6,6]
//       b=[-inf,+inf]
//       c=[-inf,+inf]
//   main_pp5_ctx0: pp5
//       a=[6,6]
//       b=[5,5]
//       c=[-inf,+inf]
//   bump_entry_bump_ctx1: entry_bump
//       n=[19,19]
//       m=[-inf,+inf]
//   bump_entry_bump_ctx2: entry_bump
//       n=[4,4]
//       m=[-inf,+inf]
//   bump_entry_bump_ctx3: entry_bump
//       n=[5,5]
//       m=[-inf,+inf]
//   main_pp6_ctx0: pp6
//       a=[6,6]
//       b=[5,5]
//       c=[20,20]
//       check a==6
//   bump_result_bump_ctx1: exit_bump
//       n=[19,19]
//       m=[20,20]
//       ret=[20,20]
//   bump_result_bump_ctx2: exit_bump
//       n=[4,4]
//       m=[5,5]
//       ret=[5,5]
//   bump_result_bump_ctx3: exit_bump
//       n=[5,5]
//       m=[6,6]
//       ret=[6,6]
//
// edges:
//   bump_pp1_ctx1 -> bump_result_bump_ctx1: return m
//   bump_pp1_ctx2 -> bump_result_bump_ctx2: return m
//   bump_pp1_ctx3 -> bump_result_bump_ctx3: return m
//   main_pp7_ctx0 -> main_pp8_ctx0: check(b==5)
//   main_pp8_ctx0 -> main_pp9_ctx0: check(c==20)
//   main_pp9_ctx0 -> main_result_main_ctx0: terminate
//   bump_pp0_ctx1 -> bump_pp1_ctx1: m := n+1
//   bump_pp0_ctx2 -> bump_pp1_ctx2: m := n+1
//   bump_pp0_ctx3 -> bump_pp1_ctx3: m := n+1
//   main_entry_main_ctx0 -> main_pp3_ctx0: nop
//   bump_entry_bump_ctx1 -> bump_pp0_ctx1: nop
//   bump_entry_bump_ctx2 -> bump_pp0_ctx2: nop
//   bump_entry_bump_ctx3 -> bump_pp0_ctx3: nop
//   main_pp6_ctx0 -> main_pp7_ctx0: check(a==6)
//   main_pp3_ctx0 -> bump_entry_bump_ctx3: enter bump(5)
//   main_pp4_ctx0 -> bump_entry_bump_ctx2: enter bump(4)
//   main_pp5_ctx0 -> bump_entry_bump_ctx1: enter bump(19)
//   bump_result_bump_ctx3 -> main_pp4_ctx0: combine a := #ret
//   bump_result_bump_ctx2 -> main_pp5_ctx0: combine b := #ret
//   bump_result_bump_ctx1 -> main_pp6_ctx0: combine c := #ret
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return bump
//   main_pp4_ctx0 -> main_pp5_ctx0: call-to-return bump
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return bump
// EXPECT-GRAPH-END

void bump(n) {
  m := n + 1;
  return m
}
void main() {
  a := bump(5);
  b := bump(4);
  c := bump(19);
  __voblint_check(a == 6); // PROVED
  __voblint_check(b == 5); // PROVED
  __voblint_check(c == 20) // PROVED
}
