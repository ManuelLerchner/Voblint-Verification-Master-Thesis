// PARAM: --analysis interval
// Canonical CFG snapshot coverage: a self-recursive procedure (factorial).
// The context-insensitive analysis keys every recursive
// activation of fact into the same context (cluster_ctx_1), giving a small,
// deterministic graph with a self-loop EnterEdge (fact_pp2_ctx1 back into
// fact_entry_fact_ctx1) not exercised by 11-graph-snapshot/02-call_return.vimp's
// plain caller/callee pair. Verdict is UNKNOWN, not PROVED, and the mechanism
// is that collapse: every recursive activation of fact shares one context key,
// so the callee-entry seed is the join over all depths, and interval widening
// at the resulting self-loop drives the accumulating product to an unbounded
// bound. It is the *context-insensitive* keying that loses this, not recursion
// as such -- 03-procedures/precision/06 proves the same recursive factorial
// exactly under --context entry-state, where each depth gets its own key.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp7_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//   cluster_ctx_1:
//     fact_pp1_ctx1
//     fact_pp0_ctx1
//     fact_pp2_ctx1
//     fact_pp3_ctx1
//     fact_entry_fact_ctx1
//     fact_result_fact_ctx1
//
// nodes:
//   fact_pp1_ctx1: pp1
//       n=[1,1]
//       tmp=[-inf,+inf]
//   main_pp7_ctx0: pp7
//       r=[-inf,+inf]
//   main_result_main_ctx0: exit_main
//       r=[-inf,+inf]
//   fact_pp0_ctx1: pp0
//       n=[1,3]
//       tmp=[-inf,+inf]
//   main_entry_main_ctx0: entry_main
//       r=[-inf,+inf]
//   fact_pp2_ctx1: pp2
//       n=[2,3]
//       tmp=[-inf,+inf]
//   fact_pp3_ctx1: pp3
//       n=[2,3]
//       tmp=[-inf,+inf]
//   main_pp5_ctx0: pp5
//       r=[-inf,+inf]
//   fact_entry_fact_ctx1: entry_fact
//       n=[1,3]
//       tmp=[-inf,+inf]
//   main_pp6_ctx0: pp6
//       r=[-inf,+inf]
//       check 0<r [unknown]
//   fact_result_fact_ctx1: exit_fact
//       n=[1,3]
//       tmp=[-inf,+inf]
//
// edges:
//   fact_pp1_ctx1 -> fact_result_fact_ctx1: return 1
//   main_pp7_ctx0 -> main_result_main_ctx0: terminate
//   fact_pp0_ctx1 -> fact_pp1_ctx1: n<2
//   fact_pp0_ctx1 -> fact_pp2_ctx1: not (n<2)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   fact_pp3_ctx1 -> fact_result_fact_ctx1: return n*tmp
//   fact_entry_fact_ctx1 -> fact_pp0_ctx1: body(fact)
//   main_pp6_ctx0 -> main_pp7_ctx0: check(0<r)
//   fact_pp2_ctx1 -> fact_entry_fact_ctx1: enter fact(n-1)
//   main_pp5_ctx0 -> fact_entry_fact_ctx1: enter fact(3)
//   fact_result_fact_ctx1 -> fact_pp3_ctx1: combine tmp := #ret
//   fact_result_fact_ctx1 -> main_pp6_ctx0: combine r := #ret
//   fact_pp2_ctx1 -> fact_pp3_ctx1: call-to-return fact
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return fact
// EXPECT-GRAPH-END

fun fact(n) {
  if (n < 2) {
    return 1;
  } else {
    tmp = fact(n - 1);
    return n * tmp;
  }
}
fun main() {
  r = fact(3);
  __voblint_check(0 < r); // UNKNOWN
}
