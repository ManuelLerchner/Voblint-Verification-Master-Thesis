// PARAM: --analysis interval
// EXPECT-ARITHMETIC
// C evaluates the right operand of && only when the left one is true, and the
// right operand of || only when the left one is false. VIMP evaluates both
// operands of a logical operator: its expressions are pure and total, and
// x / 0 is 0. Voblint raises the obligations of both operands, so it reports a
// hazard C would skip. Each ERROR below holds whenever its division is
// evaluated, which VIMP does and C never would here. Silence remains sound for
// C's evaluation, because it covers a superset of the operations C evaluates.
fun main() {
  i32 x = 0;
  i32 y = x != 0 && 100 / x > 0; // ARITH: ERROR division-by-zero
  i32 z = x == 0 || 100 / x > 0; // ARITH: ERROR division-by-zero
  __voblint_check(y == 0); // PROVED
  __voblint_check(z == 1); // PROVED
}
