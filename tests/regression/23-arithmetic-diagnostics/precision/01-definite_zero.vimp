// PARAM: --analysis interval
// EXPECT-ARITHMETIC
// Definite hazards coexist with VIMP's total division and remainder results.
fun main() {
  i32 divisor = 0;
  i32 quotient = 7 / divisor; // ARITH: ERROR division-by-zero
  i32 remainder = 7 % divisor; // ARITH: ERROR remainder-by-zero
  __voblint_check(quotient == 0); // PROVED
  __voblint_check(remainder == 7); // PROVED
}
