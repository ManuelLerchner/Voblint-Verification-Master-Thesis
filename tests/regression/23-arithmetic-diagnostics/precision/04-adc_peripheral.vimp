// PARAM: --analysis interval --context entry-state
// EXPECT-ARITHMETIC
//
// Simplified ADC peripheral:
// each e* value models one channel-enable register bit.
// count_enabled recursively scans the hardware channels.
//
// The number of enabled channels is in [0,4].
// Computing the average therefore has a possible
// division-by-zero when all channels are disabled.

fun i32 count_enabled(i32 i, i32 e0, i32 e1, i32 e2, i32 e3) {
  if (i == 4) {
    return 0;
  }

  i32 enabled = 0;

  if (i == 0) {
    enabled = e0;
  }

  if (i == 1) {
    enabled = e1;
  }

  if (i == 2) {
    enabled = e2;
  }

  if (i == 3) {
    enabled = e3;
  }

  i32 rest = count_enabled(i + 1, e0, e1, e2, e3);
  return enabled + rest;
}

fun main() {
  // Simulated MMIO register bits.
  i32 e0 = __voblint_nondet_int();
  i32 e1 = __voblint_nondet_int();
  i32 e2 = __voblint_nondet_int();
  i32 e3 = __voblint_nondet_int();

  // Simulated ADC accumulation register.
  i32 adc_sum = __voblint_nondet_int();

  if (0 <= e0 && e0 <= 1 &&
      0 <= e1 && e1 <= 1 &&
      0 <= e2 && e2 <= 1 &&
      0 <= e3 && e3 <= 1 &&
      0 <= adc_sum && adc_sum <= 16380) {

    i32 active = count_enabled(0, e0, e1, e2, e3);

    __voblint_check(active >= 0); // PROVED
    __voblint_check(active <= 4); // PROVED

    i32 average = adc_sum / active; // ARITH: WARN division-by-zero
  }
}
