// PARAM: --analysis interval --context entry-state --globals per-origin
// EXPECT-ARITHMETIC
// This source operation sees zero on one activation and nonzero on another.
// Its aggregate finding must remain possible rather than definite.
fun i32 f(i32 n) {
  return 10 / n; // ARITH: WARN division-by-zero
}
fun main() {
  i32 x = f(0);
  i32 y = f(2);
}
