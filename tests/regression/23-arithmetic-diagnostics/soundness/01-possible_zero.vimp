// PARAM: --analysis interval
// EXPECT-ARITHMETIC
// The unconstrained divisor admits both zero and nonzero executions.
fun main() {
  i32 divisor = __voblint_nondet_int();
  i32 quotient = 7 / divisor; // ARITH: WARN division-by-zero
  i32 remainder = 7 % divisor; // ARITH: WARN remainder-by-zero
  __voblint_check(divisor != 0); // UNKNOWN
}
