// PARAM: --analysis interval --context call-string --context-depth 5
// Adapted from Goblint tests/regression/79-callstring/01-multiple_tests_h5sens_cs.c
// and 02-multiple_tests_h5ins_cs.c (ana.context.callString_length 5, i.e.
// --context call-string --context-depth 5). Every concrete result is fixed
// and no value comes near the i32 bounds: x0..x3 are 11, y0 = 5, y1 = 6,
// z0 = z1 = 2, and m is 0 after each o call. Goblint proves a(7), e(5),
// k(9) and o(5) (its widening delay tolerates about three collapsed levels)
// and reports the 02 checks UNKNOWN. Voblint proves the four a/b/c checks
// and leaves the six e, k and o checks UNKNOWN; those six are the
// imprecision this case pins. --context entry-state proves all ten.
// The call string is exact only while the deepest activation chain fits in
// K call sites. Beyond that every deeper activation carries the same
// truncated key, so one callee-entry seed is the join of their arguments.
// - a/b/c (PROVED): the joined seed contains 0 next to positive values.
//   Interval's guard refinement for i != 0 strips the endpoint 0, so the
//   seed reaching 0 < i is positive, the fall-through `return 1` stays dead,
//   and the collapsed exit is exactly 11.
// What the other families lose, measured:
// - k/h: the joined seed is i=[0,2147483646], so the collapsed context
//   admits values below 2 that the concrete run, which stops at k(2),
//   never passes; its fall-through `return 1` joins z0 and z1 to [1,2].
// - e/f: the collapsed activations return different concrete values
//   (e(1) = 3, e(3) = 4), so the shared exit grows with every round;
//   widening takes it to the i32 range, and y0, y1 read back as top.
// - o with the global m: the collapsed context is entered from three call
//   chains, warrowing widens its seed to i=[0,2147483646], the body writes
//   m := i from it, and m reads back as [0,2147483646] after each call.
global m;
fun a(i) {
  if (i == 0) { return 11; }
  if (0 < i) { r = a(i - 1); return r; }
  return 1;
}
fun b(i) {
  if (i == 0) { return 12; }
  if (0 < i) { r = a(i - 1); return r; }
  return 2;
}
fun c(i) {
  if (i == 0) { return 13; }
  if (0 < i) { r = b(i - 1); return r; }
  return 3;
}
fun f(i) {
  if (0 < i) { r = e(i - 1); return r; }
  return 2;
}
fun e(i) {
  r = f(i - 1);
  return r + 1;
}
fun h(i) {
  if (i == 0) { return 1; }
  if (0 < i) { r = h(i - 1); return r; }
  return 0;
}
fun k(i) {
  if (i == 2) { r = h(i - 1); return r + 1; }
  if (0 < i) { r = k(i - 1); return r; }
  return 1;
}
fun o(i) {
  if (0 < i) { i = i - 1; m = i; o(i); }
  return 0;
}
fun main() {
  x0 = a(7); __voblint_check(x0 == 11);  // PROVED
  x1 = a(8); __voblint_check(x1 == 11);  // PROVED
  x2 = c(11); __voblint_check(x2 == 11); // PROVED
  x3 = b(21); __voblint_check(x3 == 11); // PROVED
  y0 = e(5); __voblint_check(y0 == 5);   // UNKNOWN
  y1 = e(7); __voblint_check(y1 == 6);   // UNKNOWN
  z0 = k(9); __voblint_check(z0 == 2);   // UNKNOWN
  z1 = k(10); __voblint_check(z1 == 2);  // UNKNOWN
  m = 20; o(5); __voblint_check(m == 0); // UNKNOWN
  m = 20; o(6); __voblint_check(m == 0);  // UNKNOWN
}
