// PARAM: --analysis interval --context call-string --context-depth 1
// EXPECT-ARITHMETIC
// The browser playground's example, at its default configuration. At depth 1,
// scale's call string remembers only its call site inside wrap, so wrap(1)
// and wrap(4) share one scale context and widen together: v enters as
// [1,2147483647] and the returned r, and so a and b, lose both bounds. a == 2 is
// concretely true but UNKNOWN, and 10 / (a - 2) -- concretely 10 / 0 -- is
// only a possible division by zero. record keeps one context per call site
// in main, so hits stays exact and hits == 8 is still proved. The widened v
// and a leave v * 2 and a - 2 possible signed overflows.
global i32 hits;

fun record(i32 amount) {
  hits = hits + amount;
}

fun i32 scale(i32 v) {
  return v * 2; // ARITH: WARN signed-overflow
}

fun i32 wrap(i32 w) {
  i32 r = scale(w);
  return r;
}

fun main() {
  i32 i = 0;
  while (i < 5) {
    i = i + 1;
  }
  __voblint_check(i == 5); // PROVED
  __voblint_check(i < 5); // REFUTED

  record(i);
  record(3);
  __voblint_check(hits == 8); // PROVED

  if (hits > 10) {
    record(100);
  }

  i32 a = wrap(1);
  i32 b = wrap(4);
  __voblint_check(a == 2); // UNKNOWN
  i32 share = 10 / (a - 2); // ARITH: WARN division-by-zero; WARN signed-overflow
}
