// PARAM: --analysis interval --context call-string --context-depth 1
// At call-string depth 1, g's routed context remembers only its own
// immediate call site (the call inside f's body), which is the same
// source location regardless of which f activation reaches it. The two
// activations of g -- one from f(3), one from f(10) -- therefore collapse
// onto the same routed context and widen together, so g's result, and
// everything downstream that reads it, loses precision: both x and y come
// back as [6,+inf) instead of their exact values 6 and 20. The K1/K2
// Isabelle witnesses pin the same separation on their solved states.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_exit_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: g / call-string=pp2
//     g_exit_g_ctx0
//     g_pp0_ctx0
//     g_entry_g_ctx0
//   cluster_ctx_2: f / call-string=pp5
//     f_exit_f_ctx0
//     f_pp2_ctx0
//     f_pp3_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_3: f / call-string=pp6
//     f_exit_f_ctx1
//     f_pp2_ctx1
//     f_pp3_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_pp8_ctx0: pp8 [unknown]
//       x=[6,+inf]
//       y=[6,+inf]
//       check y == 20
//   main_pp9_ctx0: pp9
//       x=[6,+inf]
//       y=[6,+inf]
//   main_exit_main_ctx0: exit_main
//       x=[6,+inf]
//       y=[6,+inf]
//   main_pp5_ctx0: pp5
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp6_ctx0: pp6
//       x=[6,+inf]
//       y=[-inf,+inf]
//   main_pp7_ctx0: pp7 [unknown]
//       x=[6,+inf]
//       y=[6,+inf]
//       check x == 6
//   main_entry_main_ctx0: entry_main
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   g_exit_g_ctx0: exit_g
//       p=[3,+inf]
//   g_pp0_ctx0: pp0
//       p=[3,+inf]
//   g_entry_g_ctx0: entry_g
//       p=[3,+inf]
//   f_exit_f_ctx0: exit_f
//       p=[3,3]
//       t=[6,+inf]
//   f_pp2_ctx0: pp2
//       p=[3,3]
//       t=[-inf,+inf]
//   f_pp3_ctx0: pp3
//       p=[3,3]
//       t=[6,+inf]
//   f_entry_f_ctx0: entry_f
//       p=[3,3]
//       t=[-inf,+inf]
//   f_exit_f_ctx1: exit_f
//       p=[10,10]
//       t=[6,+inf]
//   f_pp2_ctx1: pp2
//       p=[10,10]
//       t=[-inf,+inf]
//   f_pp3_ctx1: pp3
//       p=[10,10]
//       t=[6,+inf]
//   f_entry_f_ctx1: entry_f
//       p=[10,10]
//       t=[-inf,+inf]
//
// edges:
//   g_pp0_ctx0 -> g_exit_g_ctx0: return p + p
//   f_pp3_ctx0 -> f_exit_f_ctx0: return t
//   f_pp3_ctx1 -> f_exit_f_ctx1: return t
//   main_pp7_ctx0 -> main_pp8_ctx0: check(x == 6)
//   main_pp8_ctx0 -> main_pp9_ctx0: check(y == 20)
//   main_pp9_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp2_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp2_ctx1: body(f)
//   g_entry_g_ctx0 -> g_pp0_ctx0: body(g)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   f_pp2_ctx0 -> g_entry_g_ctx0: enter g(p)
//   g_exit_g_ctx0 -> f_pp3_ctx0: combine t := g(p)
//   f_pp2_ctx0 -> f_pp3_ctx0: call-to-return g
//   f_pp2_ctx1 -> g_entry_g_ctx0: enter g(p)
//   g_exit_g_ctx0 -> f_pp3_ctx1: combine t := g(p)
//   f_pp2_ctx1 -> f_pp3_ctx1: call-to-return g
//   main_pp5_ctx0 -> f_entry_f_ctx0: enter f(3)
//   f_exit_f_ctx0 -> main_pp6_ctx0: combine x := f(3)
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return f
//   main_pp6_ctx0 -> f_entry_f_ctx1: enter f(10)
//   f_exit_f_ctx1 -> main_pp7_ctx0: combine y := f(10)
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun g(p) { return p + p; }
fun f(p) { t = g(p); return t; }
fun main() {
  x = f(3);
  y = f(10);
  __voblint_check(x == 6); // UNKNOWN
  __voblint_check(y == 20); // UNKNOWN
}
