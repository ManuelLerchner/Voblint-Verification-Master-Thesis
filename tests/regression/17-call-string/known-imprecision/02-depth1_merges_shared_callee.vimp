// PARAM: --analysis interval --context call-string --context-depth 1
// At call-string depth 1, g's routed context remembers only its own
// immediate call site (the call inside f's body), which is the same
// source location regardless of which f activation reaches it. The two
// activations of g -- one from f(3), one from f(10) -- therefore collapse
// onto the same routed context and widen together.
//
// Two mechanisms compose to produce what the snapshot shows. Widening the
// merged entry sends p's upper bound to +inf, so g's entry reads [3,+inf).
// That value is outside I32's range, so the conversion at every node
// downstream has an operand it cannot represent and answers the whole kind
// range: g's #ret, and x and y after it, are [-2147483648,2147483647]
// rather than the exact 6 and 20. Only the first mechanism is inherent to
// depth 1; the second is the widening/kind-range gap recorded in the
// alignment register, and closing it would leave the lower bound 6 standing
// here. Depth 2 keeps both values exact -- see precision/02.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     g_pp0_ctx0
//     g_entry_g_ctx0
//     g_result_g_ctx0
//   cluster_ctx_1:
//     main_pp8_ctx1
//     main_pp9_ctx1
//     main_result_main_ctx1
//     main_entry_main_ctx1
//     main_pp5_ctx1
//     main_pp6_ctx1
//     main_pp7_ctx1
//   cluster_ctx_2:
//     f_pp2_ctx2
//     f_pp3_ctx2
//     f_entry_f_ctx2
//     f_result_f_ctx2
//   cluster_ctx_3:
//     f_pp2_ctx3
//     f_pp3_ctx3
//     f_entry_f_ctx3
//     f_result_f_ctx3
//
// nodes:
//   main_pp8_ctx1: pp8
//       x=[-2147483648,2147483647]
//       y=[-2147483648,2147483647]
//       check y==20 [unknown]
//   main_pp9_ctx1: pp9
//       x=[-2147483648,2147483647]
//       y=[-2147483648,2147483647]
//   main_result_main_ctx1: exit_main
//       x=[-2147483648,2147483647]
//       y=[-2147483648,2147483647]
//   g_pp0_ctx0: pp0
//       p=[3,+inf]
//   main_entry_main_ctx1: entry_main
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   f_pp2_ctx2: pp2
//       p=[3,3]
//       t=[-inf,+inf]
//   f_pp2_ctx3: pp2
//       p=[10,10]
//       t=[-inf,+inf]
//   g_entry_g_ctx0: entry_g
//       p=[3,+inf]
//   f_pp3_ctx2: pp3
//       p=[3,3]
//       t=[-2147483648,2147483647]
//   f_pp3_ctx3: pp3
//       p=[10,10]
//       t=[-2147483648,2147483647]
//   g_result_g_ctx0: exit_g
//       p=[3,+inf]
//       ret=[-2147483648,2147483647]
//   main_pp5_ctx1: pp5
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp6_ctx1: pp6
//       x=[-2147483648,2147483647]
//       y=[-inf,+inf]
//   f_entry_f_ctx2: entry_f
//       p=[3,3]
//       t=[-inf,+inf]
//   f_entry_f_ctx3: entry_f
//       p=[10,10]
//       t=[-inf,+inf]
//   main_pp7_ctx1: pp7
//       x=[-2147483648,2147483647]
//       y=[-2147483648,2147483647]
//       check x==6 [unknown]
//   f_result_f_ctx2: exit_f
//       p=[3,3]
//       t=[-2147483648,2147483647]
//       ret=[-2147483648,2147483647]
//   f_result_f_ctx3: exit_f
//       p=[10,10]
//       t=[-2147483648,2147483647]
//       ret=[-2147483648,2147483647]
//
// edges:
//   main_pp8_ctx1 -> main_pp9_ctx1: check(y==20)
//   main_pp9_ctx1 -> main_result_main_ctx1: terminate
//   g_pp0_ctx0 -> g_result_g_ctx0: return p+p
//   main_entry_main_ctx1 -> main_pp5_ctx1: nop
//   g_entry_g_ctx0 -> g_pp0_ctx0: nop
//   f_pp3_ctx2 -> f_result_f_ctx2: return t
//   f_pp3_ctx3 -> f_result_f_ctx3: return t
//   f_entry_f_ctx2 -> f_pp2_ctx2: nop
//   f_entry_f_ctx3 -> f_pp2_ctx3: nop
//   main_pp7_ctx1 -> main_pp8_ctx1: check(x==6)
//   f_pp2_ctx2 -> g_entry_g_ctx0: enter g(p)
//   f_pp2_ctx3 -> g_entry_g_ctx0: enter g(p)
//   main_pp5_ctx1 -> f_entry_f_ctx2: enter f(3)
//   main_pp6_ctx1 -> f_entry_f_ctx3: enter f(10)
//   g_result_g_ctx0 -> f_pp3_ctx2: combine t := #ret
//   g_result_g_ctx0 -> f_pp3_ctx3: combine t := #ret
//   f_result_f_ctx2 -> main_pp6_ctx1: combine x := #ret
//   f_result_f_ctx3 -> main_pp7_ctx1: combine y := #ret
//   f_pp2_ctx2 -> f_pp3_ctx2: call-to-return g
//   f_pp2_ctx3 -> f_pp3_ctx3: call-to-return g
//   main_pp5_ctx1 -> main_pp6_ctx1: call-to-return f
//   main_pp6_ctx1 -> main_pp7_ctx1: call-to-return f
// EXPECT-GRAPH-END

int32 g(int32 p) { return p + p }
int32 f(int32 p) { int32 t; t := g(p); return t }
void main() {
  int32 x, y;
  x := f(3);
  y := f(10);
  __voblint_check(x == 6); // UNKNOWN
  __voblint_check(y == 20) // UNKNOWN
}
