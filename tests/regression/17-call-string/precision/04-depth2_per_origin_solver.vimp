// PARAM: --analysis interval --context call-string --context-depth 2 --solver per-origin
// Same program as 02-depth2_separates_shared_callee.vimp, explicit --solver
// per-origin instead of call-string's implicit Warrow default -- see
// 03-depth2_join_solver.vimp for why the routed equation system underneath
// accepts any solver the same way the flat one does.
int32 g(int32 p) { return p + p }
int32 f(int32 p) { int32 t; t := g(p); return t }
void main() {
  int32 x, y;
  x := f(3);
  y := f(10);
  __voblint_check(x == 6); // PROVED
  __voblint_check(y == 20) // PROVED
}
