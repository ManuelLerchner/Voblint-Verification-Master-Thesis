// PARAM: --analysis interval --context call-string --context-depth 2
// Same program as known-imprecision/02-depth1_merges_shared_callee.vimp. At depth 2, g's
// routed context additionally remembers which f activation called it --
// distinguishing the call reached via f(3) from the one reached via
// f(10), since each now carries its own two-frame call string instead of
// collapsing onto g's single call site alone. The two g activations no
// longer merge, so both results stay exact: x == 6 and y == 20, each
// provable. This is the precision separation call-string depth exists to
// buy, on the identical source depth 1 leaves imprecise.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_exit_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: g / call-string=pp2 pp5
//     g_exit_g_ctx0
//     g_pp0_ctx0
//     g_entry_g_ctx0
//   cluster_ctx_2: g / call-string=pp2 pp6
//     g_exit_g_ctx1
//     g_pp0_ctx1
//     g_entry_g_ctx1
//   cluster_ctx_3: f / call-string=pp5
//     f_exit_f_ctx0
//     f_pp2_ctx0
//     f_pp3_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_4: f / call-string=pp6
//     f_exit_f_ctx1
//     f_pp2_ctx1
//     f_pp3_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_pp8_ctx0: pp8 [proved]
//       x=[6,6]
//       y=[20,20]
//       check y == 20
//   main_pp9_ctx0: pp9
//       x=[6,6]
//       y=[20,20]
//   main_exit_main_ctx0: exit_main
//       x=[6,6]
//       y=[20,20]
//   main_pp5_ctx0: pp5
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp6_ctx0: pp6
//       x=[6,6]
//       y=[-inf,+inf]
//   main_pp7_ctx0: pp7 [proved]
//       x=[6,6]
//       y=[20,20]
//       check x == 6
//   main_entry_main_ctx0: entry_main
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   g_exit_g_ctx0: exit_g
//       p=[3,3]
//       ret=[6,6]
//   g_pp0_ctx0: pp0
//       p=[3,3]
//       ret=[-inf,+inf]
//   g_entry_g_ctx0: entry_g
//       p=[3,3]
//       ret=[-inf,+inf]
//   g_exit_g_ctx1: exit_g
//       p=[10,10]
//       ret=[20,20]
//   g_pp0_ctx1: pp0
//       p=[10,10]
//       ret=[-inf,+inf]
//   g_entry_g_ctx1: entry_g
//       p=[10,10]
//       ret=[-inf,+inf]
//   f_exit_f_ctx0: exit_f
//       p=[3,3]
//       t=[6,6]
//       ret=[6,6]
//   f_pp2_ctx0: pp2
//       p=[3,3]
//       t=[-inf,+inf]
//       ret=[-inf,+inf]
//   f_pp3_ctx0: pp3
//       p=[3,3]
//       t=[6,6]
//       ret=[-inf,+inf]
//   f_entry_f_ctx0: entry_f
//       p=[3,3]
//       t=[-inf,+inf]
//       ret=[-inf,+inf]
//   f_exit_f_ctx1: exit_f
//       p=[10,10]
//       t=[20,20]
//       ret=[20,20]
//   f_pp2_ctx1: pp2
//       p=[10,10]
//       t=[-inf,+inf]
//       ret=[-inf,+inf]
//   f_pp3_ctx1: pp3
//       p=[10,10]
//       t=[20,20]
//       ret=[-inf,+inf]
//   f_entry_f_ctx1: entry_f
//       p=[10,10]
//       t=[-inf,+inf]
//       ret=[-inf,+inf]
//
// edges:
//   g_pp0_ctx0 -> g_exit_g_ctx0: return p + p
//   g_pp0_ctx1 -> g_exit_g_ctx1: return p + p
//   f_pp3_ctx0 -> f_exit_f_ctx0: return t
//   f_pp3_ctx1 -> f_exit_f_ctx1: return t
//   main_pp7_ctx0 -> main_pp8_ctx0: check(x == 6)
//   main_pp8_ctx0 -> main_pp9_ctx0: check(y == 20)
//   main_pp9_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp2_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp2_ctx1: body(f)
//   g_entry_g_ctx0 -> g_pp0_ctx0: body(g)
//   g_entry_g_ctx1 -> g_pp0_ctx1: body(g)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   f_pp2_ctx0 -> g_entry_g_ctx0: enter g(p)
//   g_exit_g_ctx0 -> f_pp3_ctx0: combine t := ret
//   f_pp2_ctx0 -> f_pp3_ctx0: call-to-return g
//   f_pp2_ctx1 -> g_entry_g_ctx1: enter g(p)
//   g_exit_g_ctx1 -> f_pp3_ctx1: combine t := ret
//   f_pp2_ctx1 -> f_pp3_ctx1: call-to-return g
//   main_pp5_ctx0 -> f_entry_f_ctx0: enter f(3)
//   f_exit_f_ctx0 -> main_pp6_ctx0: combine x := ret
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return f
//   main_pp6_ctx0 -> f_entry_f_ctx1: enter f(10)
//   f_exit_f_ctx1 -> main_pp7_ctx0: combine y := ret
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun g(p) { return p + p; }
fun f(p) { t = g(p); return t; }
fun main() {
  x = f(3);
  y = f(10);
  __voblint_check(x == 6); // PROVED
  __voblint_check(y == 20); // PROVED
}
