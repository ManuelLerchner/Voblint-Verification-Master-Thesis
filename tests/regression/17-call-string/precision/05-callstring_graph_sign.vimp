// PARAM: --analysis sign --context call-string --context-depth 2
// Call-string GraphViz coverage at a non-Interval domain. Until the shared
// contextual renderer landed, --dot/--graph-snapshot with --context
// call-string was rejected outright at the CLI, and the only contextual
// graph that existed was entry-state's, written for Interval alone.
// A call-string context is a cfg_node list -- pure call history, no domain
// content -- and every state here renders through abstract_value, so one
// configuration (cs_ctx_graph_config, State_Report_Graph.thy) serves
// Sign, Interval and Int alike. This fixture pins that shared renderer at
// Sign specifically: g is entered under two distinct call strings (via
// f(3) and via f(-10)), so it gets two separate clusters whose enter and
// combine edges route to their own context rather than joining, and the
// two clusters carry genuinely different states (Positive vs Negative).
// The checks are Sign's own business, not the graph's: doubling preserves
// sign, so both are PROVED.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_exit_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: g / call-string=pp2 pp5
//     g_exit_g_ctx0
//     g_pp0_ctx0
//     g_entry_g_ctx0
//   cluster_ctx_2: g / call-string=pp2 pp6
//     g_exit_g_ctx1
//     g_pp0_ctx1
//     g_entry_g_ctx1
//   cluster_ctx_3: f / call-string=pp5
//     f_exit_f_ctx0
//     f_pp2_ctx0
//     f_pp3_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_4: f / call-string=pp6
//     f_exit_f_ctx1
//     f_pp2_ctx1
//     f_pp3_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_pp8_ctx0: pp8 [proved]
//       x=Positive
//       y=Negative
//       check y < 0
//   main_pp9_ctx0: pp9
//       x=Positive
//       y=Negative
//   main_exit_main_ctx0: exit_main
//       x=Positive
//       y=Negative
//   main_pp5_ctx0: pp5
//       x=Top
//       y=Top
//   main_pp6_ctx0: pp6
//       x=Positive
//       y=Top
//   main_pp7_ctx0: pp7 [proved]
//       x=Positive
//       y=Negative
//       check 0 < x
//   main_entry_main_ctx0: entry_main
//       x=Top
//       y=Top
//   g_exit_g_ctx0: exit_g
//       p=Positive
//       ret=Positive
//   g_pp0_ctx0: pp0
//       p=Positive
//       ret=Top
//   g_entry_g_ctx0: entry_g
//       p=Positive
//       ret=Top
//   g_exit_g_ctx1: exit_g
//       p=Negative
//       ret=Negative
//   g_pp0_ctx1: pp0
//       p=Negative
//       ret=Top
//   g_entry_g_ctx1: entry_g
//       p=Negative
//       ret=Top
//   f_exit_f_ctx0: exit_f
//       p=Positive
//       t=Positive
//       ret=Positive
//   f_pp2_ctx0: pp2
//       p=Positive
//       t=Top
//       ret=Top
//   f_pp3_ctx0: pp3
//       p=Positive
//       t=Positive
//       ret=Top
//   f_entry_f_ctx0: entry_f
//       p=Positive
//       t=Top
//       ret=Top
//   f_exit_f_ctx1: exit_f
//       p=Negative
//       t=Negative
//       ret=Negative
//   f_pp2_ctx1: pp2
//       p=Negative
//       t=Top
//       ret=Top
//   f_pp3_ctx1: pp3
//       p=Negative
//       t=Negative
//       ret=Top
//   f_entry_f_ctx1: entry_f
//       p=Negative
//       t=Top
//       ret=Top
//
// edges:
//   g_pp0_ctx0 -> g_exit_g_ctx0: return p + p
//   g_pp0_ctx1 -> g_exit_g_ctx1: return p + p
//   f_pp3_ctx0 -> f_exit_f_ctx0: return t
//   f_pp3_ctx1 -> f_exit_f_ctx1: return t
//   main_pp7_ctx0 -> main_pp8_ctx0: check(0 < x)
//   main_pp8_ctx0 -> main_pp9_ctx0: check(y < 0)
//   main_pp9_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp2_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp2_ctx1: body(f)
//   g_entry_g_ctx0 -> g_pp0_ctx0: body(g)
//   g_entry_g_ctx1 -> g_pp0_ctx1: body(g)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   f_pp2_ctx0 -> g_entry_g_ctx0: enter g(p)
//   g_exit_g_ctx0 -> f_pp3_ctx0: combine t := ret
//   f_pp2_ctx0 -> f_pp3_ctx0: call-to-return g
//   f_pp2_ctx1 -> g_entry_g_ctx1: enter g(p)
//   g_exit_g_ctx1 -> f_pp3_ctx1: combine t := ret
//   f_pp2_ctx1 -> f_pp3_ctx1: call-to-return g
//   main_pp5_ctx0 -> f_entry_f_ctx0: enter f(3)
//   f_exit_f_ctx0 -> main_pp6_ctx0: combine x := ret
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return f
//   main_pp6_ctx0 -> f_entry_f_ctx1: enter f(-10)
//   f_exit_f_ctx1 -> main_pp7_ctx0: combine y := ret
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun g(p) { return p + p; }
fun f(p) { t = g(p); return t; }
fun main() {
  x = f(3);
  y = f(-10);
  __voblint_check(0 < x); // PROVED
  __voblint_check(y < 0); // PROVED
}
