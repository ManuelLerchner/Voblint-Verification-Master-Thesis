// PARAM: --analysis interval --context call-string --context-depth 5
// Adapted from Goblint tests/regression/81-loopfree_callstring/10-nested_loops.c
// (loopfree_callstring, which has no voblint equivalent; a plain
// call-string of depth 5 is used instead, and Goblint's own annotation is
// UNKNOWN). The chain main -> f(4) -> f(3) -> f(2) -> f(1) -> f(0) -> g(2)
// -> h(2) is seven sites deep, but the value 3 is produced by h and only
// passed back, so all that matters is that f(0)'s key differs from the
// keys of the activations still recursing. At depth 5 it does: the
// collapsed f activations f(1)/f(0) are exactly the ones whose g call is
// live, and g/h return a constant. At depth 2 the answer is UNKNOWN
// (a=[0,3]): the collapsed f seed admits every i in [0,2], and its
// fall-through `return 0` arm is live through Interval's !(i == 0) guard
// keeping the endpoint 0 (see known-imprecision/03 for that mechanism).
void h(i) { return 3 }
void g(i) { r := h(i); return r }
void f(i) {
  if (i == 0) { r := g(2); return r } else { skip };
  if (0 < i) { r := f(i - 1); return r } else { skip };
  return 0
}
void main() {
  a := f(4); __voblint_check(a == 3) // PROVED
}
