// PARAM: --analysis interval --context call-string --context-depth 2 --globals join
// Same program as 02-depth2_separates_shared_callee.vimp, explicit --globals
// join instead of call-string's implicit Warrow default -- valid because
// the routed call-string equation system is solved under every
// discipline exactly like the flat one. This routing depth crosses no unbounded loop, so join
// needs no widening to terminate and reproduces Warrow's exact k=2 result.
fun i32 g(i32 p) { return p + p; }
fun i32 f(i32 p) { i32 t = g(p); return t; }
fun main() {
  i32 x = f(3);
  i32 y = f(10);
  __voblint_check(x == 6); // PROVED
  __voblint_check(y == 20); // PROVED
}
