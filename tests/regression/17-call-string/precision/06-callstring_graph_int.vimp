// PARAM: --analysis int --context call-string --context-depth 2
// The same shared call-string renderer at the composite Int domain, the
// third and last domain routed through cs_ctx_graph_config. Together with
// 05-callstring_graph_sign.vimp (Sign) and the entry-state graph fixtures
// (Interval), this covers every domain the one configuration serves without
// duplicating a snapshot per domain-solver pair: the renderer is shared, so
// what varies between these fixtures is only which abstract_value the node
// labels carry, not any rendering logic.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_exit_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: g / call-string=pp2 pp5
//     g_exit_g_ctx0
//     g_pp0_ctx0
//     g_entry_g_ctx0
//   cluster_ctx_2: g / call-string=pp2 pp6
//     g_exit_g_ctx1
//     g_pp0_ctx1
//     g_entry_g_ctx1
//   cluster_ctx_3: f / call-string=pp5
//     f_exit_f_ctx0
//     f_pp2_ctx0
//     f_pp3_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_4: f / call-string=pp6
//     f_exit_f_ctx1
//     f_pp2_ctx1
//     f_pp3_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_pp8_ctx0: pp8 [proved]
//       x=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       y=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//       check y == 20
//   main_pp9_ctx0: pp9
//       x=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       y=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//   main_exit_main_ctx0: exit_main
//       x=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       y=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//   main_pp5_ctx0: pp5
//       x=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       y=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   main_pp6_ctx0: pp6
//       x=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       y=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   main_pp7_ctx0: pp7 [proved]
//       x=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       y=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//       check x == 6
//   main_entry_main_ctx0: entry_main
//       x=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       y=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   g_exit_g_ctx0: exit_g
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       ret=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//   g_pp0_ctx0: pp0
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   g_entry_g_ctx0: entry_g
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   g_exit_g_ctx1: exit_g
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       ret=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//   g_pp0_ctx1: pp0
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   g_entry_g_ctx1: entry_g
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_exit_f_ctx0: exit_f
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       t=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       ret=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//   f_pp2_ctx0: pp2
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       t=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_pp3_ctx0: pp3
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       t=sign=Positive, ivl=[6,6], parity=Even, congruence==6
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_entry_f_ctx0: entry_f
//       p=sign=Positive, ivl=[3,3], parity=Odd, congruence==3
//       t=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_exit_f_ctx1: exit_f
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       t=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//       ret=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//   f_pp2_ctx1: pp2
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       t=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_pp3_ctx1: pp3
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       t=sign=Positive, ivl=[20,20], parity=Even, congruence==20
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//   f_entry_f_ctx1: entry_f
//       p=sign=Positive, ivl=[10,10], parity=Even, congruence==10
//       t=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//       ret=sign=Top, ivl=[-inf,+inf], parity=Top, congruence==0 (mod 1)
//
// edges:
//   g_pp0_ctx0 -> g_exit_g_ctx0: return p + p
//   g_pp0_ctx1 -> g_exit_g_ctx1: return p + p
//   f_pp3_ctx0 -> f_exit_f_ctx0: return t
//   f_pp3_ctx1 -> f_exit_f_ctx1: return t
//   main_pp7_ctx0 -> main_pp8_ctx0: check(x == 6)
//   main_pp8_ctx0 -> main_pp9_ctx0: check(y == 20)
//   main_pp9_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp2_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp2_ctx1: body(f)
//   g_entry_g_ctx0 -> g_pp0_ctx0: body(g)
//   g_entry_g_ctx1 -> g_pp0_ctx1: body(g)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   f_pp2_ctx0 -> g_entry_g_ctx0: enter g(p)
//   g_exit_g_ctx0 -> f_pp3_ctx0: combine t := ret
//   f_pp2_ctx0 -> f_pp3_ctx0: call-to-return g
//   f_pp2_ctx1 -> g_entry_g_ctx1: enter g(p)
//   g_exit_g_ctx1 -> f_pp3_ctx1: combine t := ret
//   f_pp2_ctx1 -> f_pp3_ctx1: call-to-return g
//   main_pp5_ctx0 -> f_entry_f_ctx0: enter f(3)
//   f_exit_f_ctx0 -> main_pp6_ctx0: combine x := ret
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return f
//   main_pp6_ctx0 -> f_entry_f_ctx1: enter f(10)
//   f_exit_f_ctx1 -> main_pp7_ctx0: combine y := ret
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun g(p) { return p + p; }
fun f(p) { t = g(p); return t; }
fun main() {
  x = f(3);
  y = f(10);
  __voblint_check(x == 6); // PROVED
  __voblint_check(y == 20); // PROVED
}
