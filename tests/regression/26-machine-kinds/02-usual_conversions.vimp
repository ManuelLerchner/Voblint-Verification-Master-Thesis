// PARAM: --analysis interval
// EXPECT-ARITHMETIC
// The usual arithmetic conversions turn -1 into 4294967295 before it is
// compared with an unsigned 32-bit value, so -1 < 1u is false, as in C.
fun main() {
  i32 x;
  u32 u;
  x = -1;
  u = 1;
  __voblint_check(x < u); // REFUTED // ARITH: ERROR conversion-overflow
}
