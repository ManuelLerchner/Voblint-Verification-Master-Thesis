// PARAM: --analysis interval --context entry-state
// Adapted from Goblint tests/regression/80-context_gas/05-circle_call_sens.c
// and 06-circle_call_ins.c (ana.context.gas_value 15; Goblint's full
// context, which gas 15 preserves for these depths, maps to --context
// entry-state). Mutual recursion f -> g -> f with non-linear results: f(i)
// = g(i-2) + g(i-3) and g(i) = f(i+1). Entry-state keys each activation by
// its entered i, so every intermediate value is a singleton and all sums
// are exact. Goblint's annotations for its 06 file are arithmetically
// wrong: the concrete values are f(13) = 1817 (annotated 233), f(20) =
// 52756 (6765), g(13) = 2940 (377), g(20) = 10946 -> 85361; Goblint never
// notices since it marks those checks UNKNOWN. voblint REFUTES the wrong
// value and PROVES the right ones (computed by direct evaluation).
// --context call-string --context-depth 5 proves only f(0) and g(0);
// --context none proves nothing.
fun i32 g(i32 i) {
  if (i == 0) { return 1; }
  if (0 < i) { i32 r = f(i + 1); return r; }
  return 11;
}
fun i32 f(i32 i) {
  if (i == 0) { return 2; }
  if (0 < i) { i32 r1 = g(i - 2); i32 r2 = g(i - 3); return r1 + r2; }
  return 12;
}
fun main() {
  i32 a = f(0); __voblint_check(a == 2);      // PROVED
  i32 b = f(7); __voblint_check(b == 101);    // PROVED
  i32 c = f(9); __voblint_check(c == 265);    // PROVED
  i32 d = f(10); __voblint_check(d == 429);   // PROVED
  i32 e = g(0); __voblint_check(e == 1);      // PROVED
  i32 h = g(3); __voblint_check(h == 25);     // PROVED
  i32 k = g(6); __voblint_check(k == 101);    // PROVED
  i32 l = g(8); __voblint_check(l == 265);    // PROVED
  i32 m = f(13); __voblint_check(m == 233);   // REFUTED
  __voblint_check(m == 1817);              // PROVED
  i32 n = f(20); __voblint_check(n == 52756); // PROVED
  i32 o = g(13); __voblint_check(o == 2940);  // PROVED
  i32 p = g(20); __voblint_check(p == 85361);  // PROVED
}
