// PARAM: --analysis interval --context entry-state
// Concretely only f(100, 0) enters the branch, so x = 100 and y = 0 there.
//
// Entry-state contexts separate f(100, 0) from f(0, 100): inside the branch Interval
// alone knows x = 100 and y = 0, so it decides every check without asking Order.
fun f(i32 x, i32 y) {
  i32 z;
  if (y <= x) {
    __voblint_check((y <= x) + 1 == 2); // PROVED
    z = (y <= x);
    x = 0;
    __voblint_check(z == 1); // PROVED
    __voblint_check(y == 1); // REFUTED
  }
}
fun main() {
  f(0, 100);
  f(100, 0);
}
