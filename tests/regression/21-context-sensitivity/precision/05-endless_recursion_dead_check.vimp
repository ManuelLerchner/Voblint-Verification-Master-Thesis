// PARAM: --analysis interval --context entry-state
// Adapted from Goblint tests/regression/79-callstring/04-endless_loop_cs.c
// (ana.context.callString_length 10; Goblint annotates the inner check
// UNKNOWN). main cannot call itself in VIMP, so the recursion lives in a
// helper. rec increments the global num_iterat and recurses while it is
// positive, so from num_iterat = 2 it never returns: both checks sit after
// a call that does not terminate and are dead, hence suppressed (NOWARN).
// Because the global is the only state and it only grows, warrowing widens
// it to [2,+inf] once and the analysis finishes immediately -- the same
// under --context none and --context call-string --context-depth 10.
global num_iterat;
void rec() {
  int32 res;
  if (0 < num_iterat) {
    num_iterat := num_iterat + 1;
    res := rec();
    __voblint_check(res == 5); // NOWARN
    return res
  } else {
    if (num_iterat == 0) { return 5 } else { return 2 }
  }
}
void main() {
  int32 r;
  num_iterat := 2;
  r := rec();
  __voblint_check(r == 5) // NOWARN
}
