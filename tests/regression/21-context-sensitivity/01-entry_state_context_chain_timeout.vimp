// PARAM: --analysis interval --context entry-state --timeout 5
// Adapted from Goblint tests/regression/32-widen-context/01-on.c
// (ana.context.widen enabled; Goblint's default full context maps to
// --context entry-state). f(x) recurses on x + 1 whenever x is nonzero.
// Under i32 x climbs to 2147483647, wraps to -2147483648 and climbs back to
// 0, so f(1) returns 0 after about 2^32 nested calls. Every activation
// enters with a new singleton x, and entry-state keying creates one context
// per value: about 2^32 contexts. Goblint finishes here because
// ana.context.widen widens the context itself across levels; voblint has no
// context widening, and the solve gives no answer within 5 s. --timeout turns
// that into a structured "did not finish within" rejection, which is what
// this fixture pins (no verdict annotations: the runner expects the
// rejection, not a report). It shows only that no answer came within the
// bound, not that the solve diverges. A bounded call string answers the same
// program; see 17-call-string/precision/13-depth2_context_chain_wraps_to_zero.vimp.
fun i32 f(i32 x) {
  if (x != 0) { i32 r = f(x + 1); return r; } else { return x; }
}
fun main() {
  i32 a = f(1);
  __voblint_check(a == 0);
}
