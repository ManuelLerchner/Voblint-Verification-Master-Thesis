// PARAM: --analysis interval --context entry-state --solver per-origin
// Same program as 04-two_call_sites_entry_state.vimp, explicit --solver
// per-origin instead of entry-state's implicit Warrow default -- see
// 07-two_call_sites_entry_state_join_solver.vimp for why the routed
// equation system underneath accepts any solver the same way the flat one
// does.
void square(n) {
  return n * n
}
void main() {
  a := square(3);
  b := square(4);
  __voblint_check(a == 9); // PROVED
  __voblint_check(b == 16) // PROVED
}
