// PARAM: --analysis interval --context none --globals join
// x == 6 and y == 20 hold concretely, but without a context both calls share
// twice's single FunctionEntry unknown. Its seed receives p = 3 from one site
// and p = 10 from the other; the join rule joins them to [3,10] without
// widening, so the one analyzed body returns [6,20] to both callers. The
// bounds survive (contrast the warrow default in
// 19-paper-examples/known-imprecision/04-context_insensitive_calls.vimp,
// which widens to [6,+inf]); the per-call values do not.
//
// Ported from Example_Interval_DG_IP_Flagship.thy: twice_p_at_entry,
// twice_ret_at_exit, twice_x_computed, twice_y_computed.
fun twice(p) {
  __voblint_check(p >= 3); // PROVED
  __voblint_check(p <= 10); // PROVED
  return p + p;
}
fun main() {
  x = twice(3);
  y = twice(10);
  __voblint_check(x >= 6); // PROVED
  __voblint_check(x <= 20); // PROVED
  __voblint_check(y >= 6); // PROVED
  __voblint_check(y <= 20); // PROVED
  __voblint_check(x == 6); // UNKNOWN
  __voblint_check(y == 20); // UNKNOWN
}
