// PARAM: --analysis interval
// Procedure layout regression: the procedure list is known before any body is compiled, so a call may
// target the current procedure (f's direct self-recursion), a sibling
// declared later (g calling h, a forward reference needing no second
// pass), or a mutually recursive pair (g and h calling each other). The
// claim here is purely structural -- which callee each call edge targets,
// and where each procedure's block starts and ends -- not a value the
// analysis proves. G defaults to 0 and neither branch of f's body changes
// it, so f's own condition G<1 holds at every recursive re-entry: f
// provably never reaches its else branch, never returns to main, and the
// trailing check after inc() is therefore proved dead (NOWARN) -- a true
// consequence of the source. The
// graph below marks that check [dead] at pp13, agreeing with the DEAD the
// text report prints for it: both readings come from the same solved
// table, so a check the analysis proves unreachable cannot read as decided
// in one and dead in the other. The
// graph snapshot below pins which callee each call edge targets and each
// procedure's block layout; the call and
// combine edges after f's call site still appear in it; only their
// solved state is dead.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     f_pp2_ctx0
//     f_pp0_ctx0
//     f_pp1_ctx0
//     f_pp3_ctx0
//     f_entry_f_ctx0
//     f_result_f_ctx0
//   cluster_ctx_1:
//     main_pp14_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp10_ctx0
//     main_pp11_ctx0
//     main_pp12_ctx0
//     main_pp13_ctx0
//
// nodes:
//   f_pp2_ctx0: pp2
//       unreachable
//   main_pp14_ctx0: pp14
//       unreachable
//   main_result_main_ctx0: exit_main
//       unreachable
//   f_pp0_ctx0: pp0
//   main_entry_main_ctx0: entry_main
//   f_pp1_ctx0: pp1
//   f_pp3_ctx0: pp3
//       unreachable
//   main_pp10_ctx0: pp10
//   f_entry_f_ctx0: entry_f
//   f_result_f_ctx0: exit_f
//       unreachable
//   main_pp11_ctx0: pp11
//       unreachable
//   main_pp12_ctx0: pp12
//       unreachable
//   main_pp13_ctx0: pp13
//       unreachable
//       check 1 [dead]
//
// edges:
//   f_pp2_ctx0 -> f_pp3_ctx0: G := G
//   main_pp14_ctx0 -> main_result_main_ctx0: terminate
//   f_pp0_ctx0 -> f_pp1_ctx0: G<1
//   f_pp0_ctx0 -> f_pp2_ctx0: not (G<1)
//   main_entry_main_ctx0 -> main_pp10_ctx0: body(main)
//   f_pp3_ctx0 -> f_result_f_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   main_pp13_ctx0 -> main_pp14_ctx0: check(1)
//   f_pp1_ctx0 -> f_entry_f_ctx0: enter f()
//   main_pp10_ctx0 -> f_entry_f_ctx0: enter f()
//   f_result_f_ctx0 -> f_pp3_ctx0: combine
//   f_result_f_ctx0 -> main_pp11_ctx0: combine
//   f_pp1_ctx0 -> f_pp3_ctx0: call-to-return f
//   main_pp10_ctx0 -> main_pp11_ctx0: call-to-return f
//   main_pp11_ctx0 -> main_pp12_ctx0: call-to-return g
//   main_pp12_ctx0 -> main_pp13_ctx0: call-to-return inc
// EXPECT-GRAPH-END

global G;
fun f() {
  if (G < 1) { f(); } else { G = G; }
}
fun g() { h(); }
fun h() { g(); }
fun inc() { G = G + 1; }
fun main() { f(); g(); inc(); __voblint_check(true); } // NOWARN
