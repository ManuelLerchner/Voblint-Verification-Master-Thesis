// PARAM: --analysis interval --solver per-origin
// The same two-origin slot as 12-two_origin_join_meets_ceiling.vimp under
// the per-origin rule: storing one contribution per origin and taking their
// supremum on read reconstructs exactly what accumulating them into a single
// slot produces, so per-origin and join agree at [1,2]. Neither widens, which
// is what makes the pair the ceiling the two widening rules are measured
// against.
//
// The four checks pin the slot exactly, not just loosely. `0 < n` and `n < 3`
// fix the two bounds; `1 < n` and `n < 2` are UNKNOWN, which is what rules out
// [2,2] and [1,1] and leaves [1,2] as the only interval consistent with all
// four. A single `n < 10` would have been satisfied by [1,9] just as well.
void p(int32 n) {
  __voblint_check(0 < n);   // PROVED
  __voblint_check(n < 3);   // PROVED
  __voblint_check(1 < n);   // UNKNOWN
  __voblint_check(n < 2)    // UNKNOWN
}
void main() {
  p(1);
  p(2)
}
