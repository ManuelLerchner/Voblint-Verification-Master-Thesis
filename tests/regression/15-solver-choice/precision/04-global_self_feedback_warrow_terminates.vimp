// PARAM: --analysis interval --solver warrow
// Direct contrast with 05-global_self_feedback_join_terminates.vimp: the
// identical self-referential global write, here under Interval's production
// solver (Solver_Warrow).
//
// Termination here is not the whole claim: an imprecise UNKNOWN would also
// be sound (the flow-insensitive global
// summary could only prove total=[0,+inf) even though total is exactly 3
// here) -- widening bought termination, not precision. With the whole
// abstract state lifted into the local unknown, there is no separate
// global summary left for the write to fold back into, so the exact
// value now reaches the check: termination and precision coincide.
global total;
void main() {
  total := 0;
  total := total + 3;
  __voblint_check(0 < total) // PROVED
}
