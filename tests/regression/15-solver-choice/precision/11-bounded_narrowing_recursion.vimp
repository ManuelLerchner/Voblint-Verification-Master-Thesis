// PARAM: --analysis interval --globals bounded-narrowing
// A recursive call is one origin whose contribution to up's FunctionEntry
// seed grows with every activation, so bounded-narrowing widens it to
// [1,2147483647]. Once the guard n < 5 caps the recursive argument, the
// contribution shrinks and the rule narrows the origin back to [1,5]; with
// main's [0,0] the seed reads [0,5].
fun i32 up(i32 n) {
  __voblint_check(n <= 5); // PROVED
  if (n < 5) {
    i32 r = up(n + 1);
  }
  return 0;
}
fun main() {
  i32 z = up(0);
}
