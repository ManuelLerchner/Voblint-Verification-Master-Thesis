// PARAM: --analysis congruence --globals per-origin
// Exercises --globals per-origin with the Congruence domain. Congruence's
// widen is plain join, and a strictly ascending chain of residue classes is a
// chain of proper divisors of the modulus, so join alone terminates and the
// warrowing rules solve the same system by the same steps.
fun main() {
  x = 2 + 2;
  __voblint_check(x == 4); // PROVED
}
