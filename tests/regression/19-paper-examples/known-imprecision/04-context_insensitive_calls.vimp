// PARAM: --analysis interval --context none
// Baseline for FM 2026 Examples 7 and 8, both of which are definitions of
// a context C rather than precision claims of their own. Sect. 3's closing
// remark is the claim they serve: "distinguishing function calls by
// contexts, be it via callstrings or partial tabulation, has been shown to
// considerably increase analysis precision."
//
// This is the same source under no context at all, so there is one unknown
// per program point of f shared by both call sites. Mechanism: f's
// FunctionEntry seed receives 3 from one site and 10 from the other, and
// the single copy of f's body is analyzed under their join -- so f returns
// [6,+inf] to both callers and neither x == 6 nor y == 20 survives, though
// each is concretely exact.
//
// precision/05- and precision/06- are this program under the paper's two
// context choices; both recover the exact values.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: f / unit
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_1: main / unit
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_exit_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   f_exit_f_ctx0: exit_f
//       p=[3,+inf]
//   main_pp5_ctx0: pp5 [unknown]
//       x=[6,+inf]
//       y=[6,+inf]
//       check y == 20
//   main_pp6_ctx0: pp6
//       x=[6,+inf]
//       y=[6,+inf]
//   main_exit_main_ctx0: exit_main
//       x=[6,+inf]
//       y=[6,+inf]
//   f_pp0_ctx0: pp0
//       p=[3,+inf]
//   main_pp2_ctx0: pp2
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp3_ctx0: pp3
//       x=[6,+inf]
//       y=[-inf,+inf]
//   f_entry_f_ctx0: entry_f
//       p=[3,+inf]
//   main_pp4_ctx0: pp4 [unknown]
//       x=[6,+inf]
//       y=[6,+inf]
//       check x == 6
//   main_entry_main_ctx0: entry_main
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//
// edges:
//   f_pp0_ctx0 -> f_exit_f_ctx0: return p + p
//   main_pp4_ctx0 -> main_pp5_ctx0: check(x == 6)
//   main_pp5_ctx0 -> main_pp6_ctx0: check(y == 20)
//   main_pp6_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   main_pp2_ctx0 -> f_entry_f_ctx0: enter f(3)
//   f_exit_f_ctx0 -> main_pp3_ctx0: combine x := f(3)
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return f
//   main_pp3_ctx0 -> f_entry_f_ctx0: enter f(10)
//   f_exit_f_ctx0 -> main_pp4_ctx0: combine y := f(10)
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun f(p) { return p + p; }
fun main() {
  x = f(3);
  y = f(10);
  __voblint_check(x == 6);  // UNKNOWN
  __voblint_check(y == 20);  // UNKNOWN
}
