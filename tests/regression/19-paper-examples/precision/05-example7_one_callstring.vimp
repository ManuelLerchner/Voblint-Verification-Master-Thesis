// PARAM: --analysis interval --context call-string --context-depth 1
// FM 2026 Example 7: "For 1-callstring context-sensitivity, C is the set
// of call sites in the program plus the element _main, c0 = _main, and
// context_{u,f,args} _ _ = u." The context of an activation is simply the
// call site that produced it, ignoring the arguments and the state.
//
// Same source as known-imprecision/04-context_insensitive_calls.vimp,
// which loses both values to a single shared copy of f. Here f's two call
// sites are two distinct contexts, so each activation gets its own seed
// and its own copy of f's body, and both exact results survive.
//
// The paper's C is unbounded in general; Voblint's --context-depth K makes
// the bound explicit, and K = 1 is the instance Example 7 describes. See
// 17-call-string/ for what a depth of 1 cannot separate -- a callee one
// frame further down shares its own single call site across both
// activations, which is where depth 2 starts to matter.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0:
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_result_main_ctx0
//     main_entry_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//   cluster_ctx_1:
//     f_pp0_ctx1
//     f_entry_f_ctx1
//     f_result_f_ctx1
//   cluster_ctx_2:
//     f_pp0_ctx2
//     f_entry_f_ctx2
//     f_result_f_ctx2
//
// nodes:
//   main_pp5_ctx0: pp5
//       x=[6,6]
//       y=[20,20]
//       check y==20
//   main_pp6_ctx0: pp6
//       x=[6,6]
//       y=[20,20]
//   main_result_main_ctx0: exit_main
//       x=[6,6]
//       y=[20,20]
//   f_pp0_ctx1: pp0
//       p=[3,3]
//   f_pp0_ctx2: pp0
//       p=[10,10]
//   main_entry_main_ctx0: entry_main
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp2_ctx0: pp2
//       x=[-inf,+inf]
//       y=[-inf,+inf]
//   main_pp3_ctx0: pp3
//       x=[6,6]
//       y=[-inf,+inf]
//   f_entry_f_ctx1: entry_f
//       p=[3,3]
//   f_entry_f_ctx2: entry_f
//       p=[10,10]
//   main_pp4_ctx0: pp4
//       x=[6,6]
//       y=[20,20]
//       check x==6
//   f_result_f_ctx1: exit_f
//       p=[3,3]
//       ret=[6,6]
//   f_result_f_ctx2: exit_f
//       p=[10,10]
//       ret=[20,20]
//
// edges:
//   main_pp5_ctx0 -> main_pp6_ctx0: check(y==20)
//   main_pp6_ctx0 -> main_result_main_ctx0: terminate
//   f_pp0_ctx1 -> f_result_f_ctx1: return p+p
//   f_pp0_ctx2 -> f_result_f_ctx2: return p+p
//   main_entry_main_ctx0 -> main_pp2_ctx0: nop
//   f_entry_f_ctx1 -> f_pp0_ctx1: nop
//   f_entry_f_ctx2 -> f_pp0_ctx2: nop
//   main_pp4_ctx0 -> main_pp5_ctx0: check(x==6)
//   main_pp2_ctx0 -> f_entry_f_ctx1: enter f(3)
//   main_pp3_ctx0 -> f_entry_f_ctx2: enter f(10)
//   f_result_f_ctx1 -> main_pp3_ctx0: combine x := #ret
//   f_result_f_ctx2 -> main_pp4_ctx0: combine y := #ret
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return f
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return f
// EXPECT-GRAPH-END

void f(p) { return p + p }
void main() {
  x := f(3);
  y := f(10);
  __voblint_check(x == 6);  // PROVED
  __voblint_check(y == 20)  // PROVED
}
