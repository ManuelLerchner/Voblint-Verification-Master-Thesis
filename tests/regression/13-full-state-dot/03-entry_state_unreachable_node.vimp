// PARAM: --analysis interval --context entry-state --dot
// Entry-state full-state rendering of a node no execution reaches, the
// counterpart of 02-entry_state_contexts.vimp. f is called twice, so its body
// carries two entry-state contexts ([5,5] and [7,7]), and its n < 2 branch is
// infeasible under both.
//
// A node whose context is unreachable renders as "unreachable", not as an
// ordinary state whose variables happen to read bottom. The distinction is
// observable and not cosmetic: an empty interval prints as [+inf,-inf], which
// is a perfectly ordinary-looking variable line, so a bottom reading drawn as
// a state paints dead code as a live node.
//
// The sibling else branch still renders once per context, with that context's
// own n, so suppressing the dead node costs nothing at the live ones.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp9_ctx0
//     main_pp10_ctx0
//     main_exit_main_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_pp8_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: f / [5,5]
//     f_pp1_ctx0
//     f_pp2_ctx0
//     f_pp3_ctx0
//     f_pp4_ctx0
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_2: f / [7,7]
//     f_pp1_ctx1
//     f_pp2_ctx1
//     f_pp3_ctx1
//     f_pp4_ctx1
//     f_exit_f_ctx1
//     f_pp0_ctx1
//     f_entry_f_ctx1
//
// nodes:
//   main_pp9_ctx0: pp9 [proved]
//       a=[5,5]
//       b=[7,7]
//       check b == 7
//   main_pp10_ctx0: pp10
//       a=[5,5]
//       b=[7,7]
//   main_exit_main_ctx0: exit_main
//       a=[5,5]
//       b=[7,7]
//   main_pp6_ctx0: pp6
//       a=⊤
//       b=⊤
//   main_pp7_ctx0: pp7
//       a=[5,5]
//       b=⊤
//   main_pp8_ctx0: pp8 [proved]
//       a=[5,5]
//       b=[7,7]
//       check a == 5
//   main_entry_main_ctx0: entry_main
//       a=⊤
//       b=⊤
//   f_pp1_ctx0: pp1 [unreachable]
//       unreachable
//       check n == 99 [dead]
//   f_pp2_ctx0: pp2 [unreachable]
//       unreachable
//   f_pp3_ctx0: pp3 [proved]
//       n=[5,5]
//       check 2 < n
//   f_pp4_ctx0: pp4
//       n=[5,5]
//   f_exit_f_ctx0: exit_f
//       n=[5,5]
//   f_pp0_ctx0: pp0
//       n=[5,5]
//   f_entry_f_ctx0: entry_f
//       n=[5,5]
//   f_pp1_ctx1: pp1 [unreachable]
//       unreachable
//       check n == 99 [dead]
//   f_pp2_ctx1: pp2 [unreachable]
//       unreachable
//   f_pp3_ctx1: pp3 [proved]
//       n=[7,7]
//       check 2 < n
//   f_pp4_ctx1: pp4
//       n=[7,7]
//   f_exit_f_ctx1: exit_f
//       n=[7,7]
//   f_pp0_ctx1: pp0
//       n=[7,7]
//   f_entry_f_ctx1: entry_f
//       n=[7,7]
//
// edges:
//   f_pp0_ctx0 -> f_pp1_ctx0: [n < 2]
//   f_pp0_ctx1 -> f_pp1_ctx1: [n < 2]
//   f_pp0_ctx0 -> f_pp3_ctx0: ![n < 2]
//   f_pp0_ctx1 -> f_pp3_ctx1: ![n < 2]
//   f_pp1_ctx0 -> f_pp2_ctx0: check(n == 99)
//   f_pp1_ctx1 -> f_pp2_ctx1: check(n == 99)
//   f_pp2_ctx0 -> f_exit_f_ctx0: return 0
//   f_pp2_ctx1 -> f_exit_f_ctx1: return 0
//   f_pp3_ctx0 -> f_pp4_ctx0: check(2 < n)
//   f_pp3_ctx1 -> f_pp4_ctx1: check(2 < n)
//   f_pp4_ctx0 -> f_exit_f_ctx0: return n
//   f_pp4_ctx1 -> f_exit_f_ctx1: return n
//   main_pp8_ctx0 -> main_pp9_ctx0: check(a == 5)
//   main_pp9_ctx0 -> main_pp10_ctx0: check(b == 7)
//   main_pp10_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   f_entry_f_ctx1 -> f_pp0_ctx1: body(f)
//   main_entry_main_ctx0 -> main_pp6_ctx0: body(main)
//   main_pp6_ctx0 -> f_entry_f_ctx0: enter f(5)
//   f_exit_f_ctx0 -> main_pp7_ctx0: combine a := f(5)
//   main_pp6_ctx0 -> main_pp7_ctx0: call-to-return f
//   main_pp7_ctx0 -> f_entry_f_ctx1: enter f(7)
//   f_exit_f_ctx1 -> main_pp8_ctx0: combine b := f(7)
//   main_pp7_ctx0 -> main_pp8_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun f(n) {
  if (n < 2) {
    __voblint_check(n == 99); // NOWARN (unreachable)
    return 0;
  } else {
    __voblint_check(2 < n); // PROVED
    return n;
  }
}

fun main() {
  a = f(5);
  b = f(7);
  __voblint_check(a == 5); // PROVED
  __voblint_check(b == 7);  // PROVED
}
