// PARAM: --analysis congruence
// EXPECT-ARITHMETIC
// Concretely b, d and f are INT_MIN, INT_MAX and 0. Under the default
// assume_top, Goblint's congruenceDomain.ml answers top for a signed + or *
// unless no_ov holds, which standalone Congruence cannot establish, and for a
// difference of constants that leaves the range. So no check is decided;
// ../precision/02 proves all three under assume_wraparound.
fun main() {
  i32 a = 2147483647;
  i32 b = a + 1; // ARITH: WARN signed-overflow
  __voblint_check(b == -2147483648); // UNKNOWN
  i32 c = -2147483648;
  i32 d = c - 1; // ARITH: WARN signed-overflow
  __voblint_check(d == 2147483647); // UNKNOWN
  i32 e = 65536;
  i32 f = e * e; // ARITH: WARN signed-overflow
  __voblint_check(f == 0); // UNKNOWN
}
