// PARAM: --analysis interval
// Concretely b, d and f are INT_MIN, INT_MAX and 0: the semantics wraps.
// Under the default assume_top (Goblint's sem.int.signed_overflow) a signed
// result outside i32 gives Interval the kind's top, so no check is decided.
// This is the policy, not a lattice limit: ../precision/01 proves all three
// under assume_wraparound.
fun main() {
  a = 2147483647;
  b = a + 1;
  __voblint_check(b == -2147483648); // UNKNOWN
  c = -2147483648;
  d = c - 1;
  __voblint_check(d == 2147483647); // UNKNOWN
  e = 65536;
  f = e * e;
  __voblint_check(f == 0); // UNKNOWN
}
