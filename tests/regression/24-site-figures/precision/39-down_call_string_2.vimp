// PARAM: --analysis interval --context call-string --context-depth 2
// Backs a row of the site's "The price of precision" recursion chart
// (call string 2): 4 contexts, same shape.

fun down(n) {
  __voblint_check(n >= 0); // PROVED
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(100);
}
