// PARAM: --analysis interval --context none
// Backs the site figures for the counting loop: the equations figure, the widening
// stepper, the solver step-through, the zoom lens and the compiler morph. The loop head
// holds i=[0,5], the body i=[0,4], the exit i=[5,5], and the nodes are pp0..pp4.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp2_ctx0
//     main_pp1_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp2_ctx0: pp2
//       i=[0,4]
//   main_pp1_ctx0: pp1
//       i=[0,5]
//   main_pp3_ctx0: pp3 [proved]
//       i=[5,5]
//       check i == 5
//   main_pp4_ctx0: pp4
//       i=[5,5]
//   main_exit_main_ctx0: exit_main
//       i=[5,5]
//   main_pp0_ctx0: pp0
//       i=⊤
//   main_entry_main_ctx0: entry_main
//       i=⊤
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: i := 0
//   main_pp1_ctx0 -> main_pp2_ctx0: [i < 5]
//   main_pp1_ctx0 -> main_pp3_ctx0: ![i < 5]
//   main_pp2_ctx0 -> main_pp1_ctx0: i := i + 1
//   main_pp3_ctx0 -> main_pp4_ctx0: check(i == 5)
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END

fun main() {
  i = 0;
  while (i < 5) {
    i = i + 1;
  }
  __voblint_check(i == 5); // PROVED
}
