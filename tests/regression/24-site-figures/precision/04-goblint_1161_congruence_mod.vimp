// PARAM: --analysis int --context none
// Backs the Voblint side of the site figure "A real bug, replayed" (goblint/analyzer
// #1161): Goblint's regression test for that fix,
// tests/regression/37-congruence/14-negative.c, in VIMP.
// c is -5 or -7, so c % 2 is -1: C and VIMP both truncate division toward zero. The
// congruence alone reads c % 2 as 1+2Z and the interval alone as [-1,0]; the Int
// product's refinement leaves -1. Goblint before the fix read c % 2 as the constant 1,
// so it claimed the first check holds (#1156); its second verdict is not documented.

fun main() {
  top = __voblint_nondet_int();
  c = -5;
  if (top) {
    c = -7;
  }
  __voblint_check(c % 2 == 1); // REFUTED
  __voblint_check(c % 2 == -1); // PROVED
}
