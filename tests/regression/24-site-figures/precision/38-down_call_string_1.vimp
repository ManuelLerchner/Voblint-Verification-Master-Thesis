// PARAM: --analysis interval --context call-string --context-depth 1
// Backs a row of the site's "The price of precision" recursion chart
// (call string 1): n >= 0 is PROVED, and the graph snapshot pins the contexts.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_exit_main_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: down / call-string=pp2
//     down_pp1_ctx0
//     down_exit_down_ctx0
//     down_pp0_ctx0
//     down_pp2_ctx0
//     down_pp4_ctx0
//     down_entry_down_ctx0
//   cluster_ctx_2: down / call-string=pp5
//     down_pp1_ctx1
//     down_exit_down_ctx1
//     down_pp0_ctx1
//     down_pp2_ctx1
//     down_pp4_ctx1
//     down_entry_down_ctx1
//
// nodes:
//   main_exit_main_ctx0: exit_main
//   main_pp5_ctx0: pp5
//   main_pp6_ctx0: pp6
//   main_entry_main_ctx0: entry_main
//   down_pp1_ctx0: pp1
//       n=[0,4]
//   down_exit_down_ctx0: exit_down
//       n=[0,4]
//   down_pp0_ctx0: pp0 [proved]
//       n=[0,4]
//       check n >= 0
//   down_pp2_ctx0: pp2
//       n=[1,4]
//   down_pp4_ctx0: pp4
//       n=[0,4]
//   down_entry_down_ctx0: entry_down
//       n=[0,4]
//   down_pp1_ctx1: pp1
//       n=[5,5]
//   down_exit_down_ctx1: exit_down
//       n=[5,5]
//   down_pp0_ctx1: pp0 [proved]
//       n=[5,5]
//       check n >= 0
//   down_pp2_ctx1: pp2
//       n=[5,5]
//   down_pp4_ctx1: pp4
//       n=[5,5]
//   down_entry_down_ctx1: entry_down
//       n=[5,5]
//
// edges:
//   down_pp0_ctx0 -> down_pp1_ctx0: check(n >= 0)
//   down_pp0_ctx1 -> down_pp1_ctx1: check(n >= 0)
//   down_pp1_ctx0 -> down_pp2_ctx0: [n > 0]
//   down_pp1_ctx1 -> down_pp2_ctx1: [n > 0]
//   down_pp1_ctx0 -> down_pp4_ctx0: ![n > 0]
//   down_pp1_ctx1 -> down_pp4_ctx1: ![n > 0]
//   down_pp4_ctx0 -> down_exit_down_ctx0: return
//   down_pp4_ctx1 -> down_exit_down_ctx1: return
//   main_pp6_ctx0 -> main_exit_main_ctx0: return
//   down_entry_down_ctx0 -> down_pp0_ctx0: body(down)
//   down_entry_down_ctx1 -> down_pp0_ctx1: body(down)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   down_pp2_ctx0 -> down_entry_down_ctx0: enter down(n - 1)
//   down_exit_down_ctx0 -> down_pp4_ctx0: combine
//   down_pp2_ctx0 -> down_pp4_ctx0: call-to-return down
//   down_pp2_ctx1 -> down_entry_down_ctx0: enter down(n - 1)
//   down_exit_down_ctx0 -> down_pp4_ctx1: combine
//   down_pp2_ctx1 -> down_pp4_ctx1: call-to-return down
//   main_pp5_ctx0 -> down_entry_down_ctx1: enter down(5)
//   down_exit_down_ctx1 -> main_pp6_ctx0: combine
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return down
// EXPECT-GRAPH-END

fun down(n) {
  __voblint_check(n >= 0); // PROVED
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(5);
}
