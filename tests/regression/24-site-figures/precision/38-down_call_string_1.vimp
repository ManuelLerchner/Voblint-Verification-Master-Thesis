// PARAM: --analysis interval --context call-string --context-depth 1
// Backs a row of the site's "The price of precision" recursion chart
// (call string 1): 3 contexts, and the one standing for the rest of the
// recursion is still bounded.

fun down(n) {
  __voblint_check(n >= 0); // PROVED
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(100);
}
