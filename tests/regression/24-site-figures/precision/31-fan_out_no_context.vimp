// PARAM: --analysis interval --context none
// Backs the fan-out row of the site's "The price of precision" table
// (no context): the check in f is PROVED, and the graph snapshot pins the
// number of solved nodes and contexts the chart reports.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: f / unit
//     f_pp1_ctx0
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_1: g / unit
//     g_exit_g_ctx0
//     g_pp2_ctx0
//     g_pp3_ctx0
//     g_pp4_ctx0
//     g_entry_g_ctx0
//   cluster_ctx_2: h / unit
//     h_exit_h_ctx0
//     h_pp5_ctx0
//     h_pp6_ctx0
//     h_pp7_ctx0
//     h_entry_h_ctx0
//   cluster_ctx_3: main / unit
//     main_exit_main_ctx0
//     main_pp8_ctx0
//     main_pp9_ctx0
//     main_pp10_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   f_pp1_ctx0: pp1
//       x=[1,+∞]
//   f_exit_f_ctx0: exit_f
//       x=[1,+∞]
//   g_exit_g_ctx0: exit_g
//       x=[1,+∞]
//   h_exit_h_ctx0: exit_h
//       x=[1,+∞]
//   main_exit_main_ctx0: exit_main
//   f_pp0_ctx0: pp0 [proved]
//       x=[1,+∞]
//       check x >= 1
//   g_pp2_ctx0: pp2
//       x=[1,+∞]
//   g_pp3_ctx0: pp3
//       x=[1,+∞]
//   f_entry_f_ctx0: entry_f
//       x=[1,+∞]
//   g_pp4_ctx0: pp4
//       x=[1,+∞]
//   h_pp5_ctx0: pp5
//       x=[1,+∞]
//   h_pp6_ctx0: pp6
//       x=[1,+∞]
//   g_entry_g_ctx0: entry_g
//       x=[1,+∞]
//   h_pp7_ctx0: pp7
//       x=[1,+∞]
//   main_pp8_ctx0: pp8
//   main_pp9_ctx0: pp9
//   h_entry_h_ctx0: entry_h
//       x=[1,+∞]
//   main_pp10_ctx0: pp10
//   main_entry_main_ctx0: entry_main
//
// edges:
//   f_pp0_ctx0 -> f_pp1_ctx0: check(x >= 1)
//   f_pp1_ctx0 -> f_exit_f_ctx0: return
//   g_pp4_ctx0 -> g_exit_g_ctx0: return
//   h_pp7_ctx0 -> h_exit_h_ctx0: return
//   main_pp10_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   g_entry_g_ctx0 -> g_pp2_ctx0: body(g)
//   h_entry_h_ctx0 -> h_pp5_ctx0: body(h)
//   main_entry_main_ctx0 -> main_pp8_ctx0: body(main)
//   g_pp2_ctx0 -> f_entry_f_ctx0: enter f(x)
//   f_exit_f_ctx0 -> g_pp3_ctx0: combine
//   g_pp2_ctx0 -> g_pp3_ctx0: call-to-return f
//   g_pp3_ctx0 -> f_entry_f_ctx0: enter f(x + 1)
//   f_exit_f_ctx0 -> g_pp4_ctx0: combine
//   g_pp3_ctx0 -> g_pp4_ctx0: call-to-return f
//   h_pp5_ctx0 -> g_entry_g_ctx0: enter g(x)
//   g_exit_g_ctx0 -> h_pp6_ctx0: combine
//   h_pp5_ctx0 -> h_pp6_ctx0: call-to-return g
//   h_pp6_ctx0 -> g_entry_g_ctx0: enter g(x + 2)
//   g_exit_g_ctx0 -> h_pp7_ctx0: combine
//   h_pp6_ctx0 -> h_pp7_ctx0: call-to-return g
//   main_pp8_ctx0 -> h_entry_h_ctx0: enter h(1)
//   h_exit_h_ctx0 -> main_pp9_ctx0: combine
//   main_pp8_ctx0 -> main_pp9_ctx0: call-to-return h
//   main_pp9_ctx0 -> h_entry_h_ctx0: enter h(5)
//   h_exit_h_ctx0 -> main_pp10_ctx0: combine
//   main_pp9_ctx0 -> main_pp10_ctx0: call-to-return h
// EXPECT-GRAPH-END

fun f(x) {
  __voblint_check(x >= 1); // PROVED
}

fun g(x) {
  f(x);
  f(x + 1);
}

fun h(x) {
  g(x);
  g(x + 2);
}

fun main() {
  h(1);
  h(5);
}
