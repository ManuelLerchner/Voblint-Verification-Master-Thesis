// PARAM: --analysis interval --context none --globals warrow-per-origin
// Backs the warrow-per-origin cell of the site's Globals guide table: f(x + 1) grows x without bound, and the check is PROVED.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: f / unit
//     f_exit_f_ctx0
//     f_pp0_ctx0
//     f_pp1_ctx0
//     f_pp2_ctx0
//     f_entry_f_ctx0
//   cluster_ctx_1: main / unit
//     main_exit_main_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   f_exit_f_ctx0: exit_f [unreachable]
//       unreachable
//   main_exit_main_ctx0: exit_main [unreachable]
//       unreachable
//   f_pp0_ctx0: pp0 [proved]
//       x=[0,+∞]
//       check x >= 0
//   f_pp1_ctx0: pp1
//       x=[0,+∞]
//   f_pp2_ctx0: pp2 [unreachable]
//       unreachable
//   main_pp3_ctx0: pp3
//   f_entry_f_ctx0: entry_f
//       x=[0,+∞]
//   main_pp4_ctx0: pp4 [unreachable]
//       unreachable
//   main_entry_main_ctx0: entry_main
//
// edges:
//   f_pp0_ctx0 -> f_pp1_ctx0: check(x >= 0)
//   f_pp2_ctx0 -> f_exit_f_ctx0: return
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   f_entry_f_ctx0 -> f_pp0_ctx0: body(f)
//   main_entry_main_ctx0 -> main_pp3_ctx0: body(main)
//   f_pp1_ctx0 -> f_entry_f_ctx0: enter f(x + 1)
//   f_exit_f_ctx0 -> f_pp2_ctx0: combine
//   f_pp1_ctx0 -> f_pp2_ctx0: call-to-return f
//   main_pp3_ctx0 -> f_entry_f_ctx0: enter f(0)
//   f_exit_f_ctx0 -> main_pp4_ctx0: combine
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return f
// EXPECT-GRAPH-END

fun f(x) {
  __voblint_check(x >= 0); // PROVED
  f(x + 1);
}

fun main() {
  f(0);
}
