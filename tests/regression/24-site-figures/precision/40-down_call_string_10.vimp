// PARAM: --analysis interval --context call-string --context-depth 10
// Backs a row of the site's "The price of precision" recursion chart
// (call string 10): 12 contexts, and the cost is still close to the floor.

fun down(n) {
  __voblint_check(n >= 0); // PROVED
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(100);
}
