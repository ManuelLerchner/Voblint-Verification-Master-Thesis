// PARAM: --analysis interval --context call-string --context-depth 6
// Backs a row of the site's "The price of precision" fan-out chart
// (call string 6): six call sites of memory match the call depth main -> f6 ->
// ... -> f0, so every copy of f0 sees one exact argument and the check lands.


fun f0(x) {
  __voblint_check(x <= 22); // PROVED
}
fun f1(x) { f0(x); f0(x + 1); }
fun f2(x) { f1(x); f1(x + 2); }
fun f3(x) { f2(x); f2(x + 3); }
fun f4(x) { f3(x); f3(x + 4); }
fun f5(x) { f4(x); f4(x + 5); }
fun f6(x) { f5(x); f5(x + 6); }

fun main() { f6(1); }
