// PARAM: --analysis int --signed-overflow assume_wraparound
// Backs the site figure "Four domains, one value: reduction": refine_congruence moves
// the interval's bounds onto 1 (mod 4), so [0,10] becomes [1,9] and both checks are PROVED.
//
// Run under --signed-overflow assume_wraparound: 4 * n + 1 is 1 (mod 4) for every
// n only modulo 2^32, and under Goblint's default assume_top the unbounded
// 4 * n may overflow, which gives both components top
// (27-signed-overflow/known-imprecision/03).
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp1_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_pp7_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp1_ctx0: pp1 [unknown]
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=⊤
//       possible signed integer overflow in *: 4 * n
//   main_pp2_ctx0: pp2
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=intervals:[-2147483647,2147483645]; congruences:1+4ℤ
//   main_pp3_ctx0: pp3
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=intervals:[1,2147483645]; congruences:1+4ℤ
//   main_pp4_ctx0: pp4 [proved]
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=intervals:[1,9]; congruences:1+4ℤ
//       check x >= 1 && x <= 9
//   main_pp7_ctx0: pp7
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=intervals:[-2147483647,2147483645]; congruences:1+4ℤ
//   main_exit_main_ctx0: exit_main
//       int:
//         n=intervals:[-2147483648,2147483647]; congruences:⊤
//         x=intervals:[-2147483647,2147483645]; congruences:1+4ℤ
//   main_pp0_ctx0: pp0
//       int:
//         n=⊤
//         x=⊤
//   main_entry_main_ctx0: entry_main
//       int:
//         n=⊤
//         x=⊤
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: n := __voblint_nondet_int()
//   main_pp1_ctx0 -> main_pp2_ctx0: x := 4 * n + 1
//   main_pp2_ctx0 -> main_pp3_ctx0: [x >= -2]
//   main_pp2_ctx0 -> main_pp7_ctx0: ![x >= -2]
//   main_pp3_ctx0 -> main_pp4_ctx0: [x <= 10]
//   main_pp3_ctx0 -> main_pp7_ctx0: ![x <= 10]
//   main_pp4_ctx0 -> main_pp7_ctx0: check(x >= 1 && x <= 9)
//   main_pp7_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END

fun main() {
  i32 n = __voblint_nondet_int();
  i32 x = 4 * n + 1;
  if (x >= -2) {
    if (x <= 10) {
      __voblint_check(x >= 1 && x <= 9); // PROVED
    }
  }
}
