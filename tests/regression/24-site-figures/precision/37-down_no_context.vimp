// PARAM: --analysis interval --context none
// Backs a row of the site's "The price of precision" recursion chart
// (no context): one copy of down stands for all 101 calls, and the guard keeps
// n in [0,100], so the check holds. 2 contexts.

fun down(n) {
  __voblint_check(n >= 0); // PROVED
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(100);
}
