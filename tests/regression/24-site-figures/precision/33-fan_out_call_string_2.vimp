fun f(x) {
  __voblint_check(x >= 1); // PROVED
}

fun g(x) {
  f(x);
  f(x + 1);
}

fun h(x) {
  g(x);
  g(x + 2);
}

fun main() {
  h(1);
  h(5);
}
