// PARAM: --analysis interval
// Backs the "Each domain alone" column of the site figure "Four domains, one value:
// reduction". Every run has x in {1,5,9}, but an interval cannot express 1 (mod 4): the guards leave [-2,10], so the check is not decided.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp1_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_pp7_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp1_ctx0: pp1
//       n=⊤
//       x=⊤
//   main_pp2_ctx0: pp2
//       n=⊤
//       x=⊤
//   main_pp3_ctx0: pp3
//       n=⊤
//       x=[-2,+∞]
//   main_pp4_ctx0: pp4 [unknown]
//       n=⊤
//       x=[-2,10]
//       check x >= 1 && x <= 9
//   main_pp7_ctx0: pp7
//       n=⊤
//       x=⊤
//   main_exit_main_ctx0: exit_main
//       n=⊤
//       x=⊤
//   main_pp0_ctx0: pp0
//       n=⊤
//       x=⊤
//   main_entry_main_ctx0: entry_main
//       n=⊤
//       x=⊤
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: n := __voblint_nondet_int()
//   main_pp1_ctx0 -> main_pp2_ctx0: x := 4 * n + 1
//   main_pp2_ctx0 -> main_pp3_ctx0: [x >= -2]
//   main_pp2_ctx0 -> main_pp7_ctx0: ![x >= -2]
//   main_pp3_ctx0 -> main_pp4_ctx0: [x <= 10]
//   main_pp3_ctx0 -> main_pp7_ctx0: ![x <= 10]
//   main_pp4_ctx0 -> main_pp7_ctx0: check(x >= 1 && x <= 9)
//   main_pp7_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END

fun main() {
  n = __voblint_nondet_int();
  x = 4 * n + 1;
  if (x >= -2) {
    if (x <= 10) {
      __voblint_check(x >= 1 && x <= 9); // UNKNOWN
    }
  }
}
