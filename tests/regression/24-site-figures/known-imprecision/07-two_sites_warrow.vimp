// PARAM: --analysis interval --context none --globals warrow
// Backs the warrow cell of the site's Globals guide table. Concretely p(1); p(2) enter p with [1,2],
// but warrow widens the entry as soon as the second call site's contribution outgrows the first: [1,+inf], so the check is UNKNOWN.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: p / unit
//     p_pp1_ctx0
//     p_exit_p_ctx0
//     p_pp0_ctx0
//     p_entry_p_ctx0
//   cluster_ctx_1: main / unit
//     main_exit_main_ctx0
//     main_pp2_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   p_pp1_ctx0: pp1
//       x=[1,+∞]
//   p_exit_p_ctx0: exit_p
//       x=[1,+∞]
//   main_exit_main_ctx0: exit_main
//   p_pp0_ctx0: pp0 [unknown]
//       x=[1,+∞]
//       check x <= 2
//   main_pp2_ctx0: pp2
//   main_pp3_ctx0: pp3
//   p_entry_p_ctx0: entry_p
//       x=[1,+∞]
//   main_pp4_ctx0: pp4
//   main_entry_main_ctx0: entry_main
//
// edges:
//   p_pp0_ctx0 -> p_pp1_ctx0: check(x <= 2)
//   p_pp1_ctx0 -> p_exit_p_ctx0: return
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp2_ctx0: body(main)
//   p_entry_p_ctx0 -> p_pp0_ctx0: body(p)
//   main_pp2_ctx0 -> p_entry_p_ctx0: enter p(1)
//   p_exit_p_ctx0 -> main_pp3_ctx0: combine
//   main_pp2_ctx0 -> main_pp3_ctx0: call-to-return p
//   main_pp3_ctx0 -> p_entry_p_ctx0: enter p(2)
//   p_exit_p_ctx0 -> main_pp4_ctx0: combine
//   main_pp3_ctx0 -> main_pp4_ctx0: call-to-return p
// EXPECT-GRAPH-END

fun p(x) {
  __voblint_check(x <= 2); // UNKNOWN
}

fun main() {
  p(1);
  p(2);
}
