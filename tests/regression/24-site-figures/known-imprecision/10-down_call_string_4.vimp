//       n=[2,2]
//       check n >= 0
//   down_pp2_ctx1: pp2
//       n=[2,2]
//   down_pp4_ctx1: pp4
//       n=[2,2]
//   down_entry_down_ctx1: entry_down
//       n=[2,2]
//   down_pp1_ctx2: pp1
//       n=[3,3]
//   down_exit_down_ctx2: exit_down
//       n=[3,3]
//   down_pp0_ctx2: pp0 [proved]
//       n=[3,3]
//       check n >= 0
//   down_pp2_ctx2: pp2
//       n=[3,3]
//   down_pp4_ctx2: pp4
//       n=[3,3]
