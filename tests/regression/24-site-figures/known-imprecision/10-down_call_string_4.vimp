//   down_pp1_ctx2 -> down_pp2_ctx2: [n > 0]
//   down_pp1_ctx3 -> down_pp2_ctx3: [n > 0]
//   down_pp1_ctx4 -> down_pp2_ctx4: [n > 0]
//   down_pp1_ctx0 -> down_pp4_ctx0: ![n > 0]
//   down_pp1_ctx1 -> down_pp4_ctx1: ![n > 0]
//   down_pp1_ctx2 -> down_pp4_ctx2: ![n > 0]
//   down_pp1_ctx3 -> down_pp4_ctx3: ![n > 0]
//   down_pp1_ctx4 -> down_pp4_ctx4: ![n > 0]
//   down_pp4_ctx0 -> down_exit_down_ctx0: return
//   down_pp4_ctx1 -> down_exit_down_ctx1: return
//   down_pp4_ctx2 -> down_exit_down_ctx2: return
//   down_pp4_ctx3 -> down_exit_down_ctx3: return
//   down_pp4_ctx4 -> down_exit_down_ctx4: return
//   main_pp6_ctx0 -> main_exit_main_ctx0: return
//   down_entry_down_ctx0 -> down_pp0_ctx0: body(down)
//   down_entry_down_ctx1 -> down_pp0_ctx1: body(down)
//   down_entry_down_ctx2 -> down_pp0_ctx2: body(down)
//   down_entry_down_ctx3 -> down_pp0_ctx3: body(down)
//   down_entry_down_ctx4 -> down_pp0_ctx4: body(down)
//   main_entry_main_ctx0 -> main_pp5_ctx0: body(main)
//   down_pp2_ctx0 -> down_entry_down_ctx0: enter down(n - 1)
//   down_exit_down_ctx0 -> down_pp4_ctx0: combine
//   down_pp2_ctx0 -> down_pp4_ctx0: call-to-return down
//   down_pp2_ctx1 -> down_entry_down_ctx0: enter down(n - 1)
//   down_exit_down_ctx0 -> down_pp4_ctx1: combine
//   down_pp2_ctx1 -> down_pp4_ctx1: call-to-return down
//   down_pp2_ctx2 -> down_entry_down_ctx1: enter down(n - 1)
//   down_exit_down_ctx1 -> down_pp4_ctx2: combine
//   down_pp2_ctx2 -> down_pp4_ctx2: call-to-return down
//   down_pp2_ctx3 -> down_entry_down_ctx2: enter down(n - 1)
//   down_exit_down_ctx2 -> down_pp4_ctx3: combine
//   down_pp2_ctx3 -> down_pp4_ctx3: call-to-return down
//   down_pp2_ctx4 -> down_entry_down_ctx3: enter down(n - 1)
//   down_exit_down_ctx3 -> down_pp4_ctx4: combine
//   down_pp2_ctx4 -> down_pp4_ctx4: call-to-return down
//   main_pp5_ctx0 -> down_entry_down_ctx4: enter down(5)
//   down_exit_down_ctx4 -> main_pp6_ctx0: combine
//   main_pp5_ctx0 -> main_pp6_ctx0: call-to-return down
// EXPECT-GRAPH-END

fun down(n) {
  __voblint_check(n >= 0); // UNKNOWN
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(5);
}
