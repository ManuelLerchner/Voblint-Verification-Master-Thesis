//       n=[5,5]
//   down_entry_down_ctx4: entry_down
//       n=[5,5]
//
// edges:
//   down_pp0_ctx0 -> down_pp1_ctx0: check(n >= 0)
//   down_pp0_ctx1 -> down_pp1_ctx1: check(n >= 0)
//   down_pp0_ctx2 -> down_pp1_ctx2: check(n >= 0)
//   down_pp0_ctx3 -> down_pp1_ctx3: check(n >= 0)
