// nodes:
//   main_exit_main_ctx0: exit_main
//   main_pp5_ctx0: pp5
//   main_pp6_ctx0: pp6
//   main_entry_main_ctx0: entry_main
//   down_pp1_ctx0: pp1
//       n=[-∞,1]
//   down_exit_down_ctx0: exit_down
//       n=[-∞,1]
//   down_pp0_ctx0: pp0 [unknown]
//       n=[-∞,1]
//       check n >= 0
//   down_pp2_ctx0: pp2
//       n=[1,1]
//   down_pp4_ctx0: pp4
//       n=[-∞,1]
