// PARAM: --analysis interval --context none
// Backs the figure "Concrete runs and one interval per node". n stays in
// [-4, 4], so x = 3 * n reaches only the multiples of three in [-12, 12],
// which an interval cannot express: after x > 0 it holds [1,12], so x < 3
// leaves [1,2] and the check x == 1 is UNKNOWN although no run reaches it.
// The other branch contradicts [-12,0] with x > 5, so that check is DEAD.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp1_ctx0
//     main_pp2_ctx0
//     main_pp4_ctx0
//     main_pp5_ctx0
//     main_pp6_ctx0
//     main_pp7_ctx0
//     main_pp9_ctx0
//     main_pp10_ctx0
//     main_pp12_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp1_ctx0: pp1
//       interval:
//         n=[-2147483648,2147483647]
//         x=⊤
//   main_pp2_ctx0: pp2
//       interval:
//         n=[-2147483648,2147483647]
//         x=⊤
//   main_pp4_ctx0: pp4
//       interval:
//         n=[-4,4]
//         x=⊤
//   main_pp5_ctx0: pp5
//       interval:
//         n=[-4,4]
//         x=[-12,12]
//   main_pp6_ctx0: pp6
//       interval:
//         n=[-4,4]
//         x=[1,12]
//   main_pp7_ctx0: pp7 [unknown]
//       interval:
//         n=[-4,4]
//         x=[1,2]
//       check x == 1
//   main_pp9_ctx0: pp9
//       interval:
//         n=[-4,4]
//         x=[-12,0]
//   main_pp10_ctx0: pp10 [unreachable]
//       unreachable
//       check x == 6 [dead]
//   main_pp12_ctx0: pp12
//       interval:
//         n=[-4,4]
//         x=[-12,12]
//   main_exit_main_ctx0: exit_main
//       interval:
//         n=[-4,4]
//         x=[-12,12]
//   main_pp0_ctx0: pp0
//       interval:
//         n=⊤
//         x=⊤
//   main_entry_main_ctx0: entry_main
//       interval:
//         n=⊤
//         x=⊤
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: n := __voblint_nondet_int()
//   main_pp1_ctx0 -> main_pp2_ctx0: [n < -4 || n > 4]
//   main_pp1_ctx0 -> main_pp4_ctx0: ![n < -4 || n > 4]
//   main_pp2_ctx0 -> main_pp4_ctx0: n := 0
//   main_pp4_ctx0 -> main_pp5_ctx0: x := 3 * n
//   main_pp5_ctx0 -> main_pp6_ctx0: [x > 0]
//   main_pp5_ctx0 -> main_pp9_ctx0: ![x > 0]
//   main_pp6_ctx0 -> main_pp7_ctx0: [x < 3]
//   main_pp6_ctx0 -> main_pp12_ctx0: ![x < 3]
//   main_pp7_ctx0 -> main_pp12_ctx0: check(x == 1)
//   main_pp9_ctx0 -> main_pp10_ctx0: [x > 5]
//   main_pp9_ctx0 -> main_pp12_ctx0: ![x > 5]
//   main_pp10_ctx0 -> main_pp12_ctx0: check(x == 6)
//   main_pp12_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END

fun main() {
  n = __voblint_nondet_int();
  if (n < -4 || n > 4) {
    n = 0;
  }
  x = 3 * n;
  if (x > 0) {
    if (x < 3) {
      __voblint_check(x == 1); // UNKNOWN
    }
  } else {
    if (x > 5) {
      __voblint_check(x == 6); // NOWARN
    }
  }
}
