// PARAM: --analysis interval --context call-string --context-depth 1
// EXPECT-ARITHMETIC
// Backs the call string 1 tab of the site figure "Context sensitivity: how many
// copies of a procedure", on the playground's demo program: wrap(1) and wrap(4) reach
// scale through its single call site s3.
// Concretely a = 2, but this setting gives scale one copy for both calls, v joins
// [1,1] and [4,4], and a == 2 is UNKNOWN.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / root context
//     main_pp9_ctx0
//     main_pp8_ctx0
//     main_pp10_ctx0
//     main_pp11_ctx0
//     main_pp15_ctx0
//     main_pp21_ctx0
//     main_pp22_ctx0
//     main_exit_main_ctx0
//     main_pp7_ctx0
//     main_pp12_ctx0
//     main_pp13_ctx0
//     main_pp14_ctx0
//     main_pp16_ctx0
//     main_pp18_ctx0
//     main_pp19_ctx0
//     main_pp20_ctx0
//     main_entry_main_ctx0
//   cluster_ctx_1: scale / call-string=pp4
//     scale_exit_scale_ctx0
//     scale_pp2_ctx0
//     scale_entry_scale_ctx0
//   cluster_ctx_2: record / call-string=pp12
//     record_pp1_ctx0
//     record_exit_record_ctx0
//     record_pp0_ctx0
//     record_entry_record_ctx0
//   cluster_ctx_3: record / call-string=pp13
//     record_pp1_ctx1
//     record_exit_record_ctx1
//     record_pp0_ctx1
//     record_entry_record_ctx1
//   cluster_ctx_4: wrap / call-string=pp18
//     wrap_exit_wrap_ctx0
//     wrap_pp4_ctx0
//     wrap_pp5_ctx0
//     wrap_entry_wrap_ctx0
//   cluster_ctx_5: wrap / call-string=pp19
//     wrap_exit_wrap_ctx1
//     wrap_pp4_ctx1
//     wrap_pp5_ctx1
//     wrap_entry_wrap_ctx1
//
// nodes:
//   main_pp9_ctx0: pp9
//       a=⊤
//       b=⊤
//       i=[0,4]
//       share=⊤
//   main_pp8_ctx0: pp8
//       a=⊤
//       b=⊤
//       i=[0,5]
//       share=⊤
//   main_pp10_ctx0: pp10 [proved]
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//       check i == 5
//   main_pp11_ctx0: pp11 [refuted]
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//       check i < 5
//   main_pp15_ctx0: pp15
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp21_ctx0: pp21 [unknown]
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//       possible division by zero: 10 / (a - 2)
//   main_pp22_ctx0: pp22
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_exit_main_ctx0: exit_main
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp7_ctx0: pp7
//       a=⊤
//       b=⊤
//       i=⊤
//       share=⊤
//   main_pp12_ctx0: pp12
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp13_ctx0: pp13
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp14_ctx0: pp14 [proved]
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//       check hits == 8
//   main_pp16_ctx0: pp16 [unreachable]
//       unreachable
//   main_pp18_ctx0: pp18
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp19_ctx0: pp19
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//   main_pp20_ctx0: pp20 [unknown]
//       a=⊤
//       b=⊤
//       i=[5,5]
//       share=⊤
//       check a == 2
//   main_entry_main_ctx0: entry_main
//       a=⊤
//       b=⊤
//       i=⊤
//       share=⊤
//   scale_exit_scale_ctx0: exit_scale
//       v=[1,+∞]
//   scale_pp2_ctx0: pp2
//       v=[1,+∞]
//   scale_entry_scale_ctx0: entry_scale
//       v=[1,+∞]
//   record_pp1_ctx0: pp1
//       amount=[5,5]
//   record_exit_record_ctx0: exit_record
//       amount=[5,5]
//   record_pp0_ctx0: pp0
//       amount=[5,5]
//   record_entry_record_ctx0: entry_record
//       amount=[5,5]
//   record_pp1_ctx1: pp1
//       amount=[3,3]
//   record_exit_record_ctx1: exit_record
//       amount=[3,3]
//   record_pp0_ctx1: pp0
//       amount=[3,3]
//   record_entry_record_ctx1: entry_record
//       amount=[3,3]
//   wrap_exit_wrap_ctx0: exit_wrap
//       w=[1,1]
//       r=⊤
//   wrap_pp4_ctx0: pp4
//       w=[1,1]
//       r=⊤
//   wrap_pp5_ctx0: pp5
//       w=[1,1]
//       r=⊤
//   wrap_entry_wrap_ctx0: entry_wrap
//       w=[1,1]
//       r=⊤
//   wrap_exit_wrap_ctx1: exit_wrap
//       w=[4,4]
//       r=⊤
//   wrap_pp4_ctx1: pp4
//       w=[4,4]
//       r=⊤
//   wrap_pp5_ctx1: pp5
//       w=[4,4]
//       r=⊤
//   wrap_entry_wrap_ctx1: entry_wrap
//       w=[4,4]
//       r=⊤
//
// edges:
//   record_pp0_ctx0 -> record_pp1_ctx0: hits := hits + amount
//   record_pp0_ctx1 -> record_pp1_ctx1: hits := hits + amount
//   record_pp1_ctx0 -> record_exit_record_ctx0: return
//   record_pp1_ctx1 -> record_exit_record_ctx1: return
//   scale_pp2_ctx0 -> scale_exit_scale_ctx0: return v * 2
//   wrap_pp5_ctx0 -> wrap_exit_wrap_ctx0: return r
//   wrap_pp5_ctx1 -> wrap_exit_wrap_ctx1: return r
//   main_pp7_ctx0 -> main_pp8_ctx0: i := 0
//   main_pp8_ctx0 -> main_pp9_ctx0: [i < 5]
//   main_pp8_ctx0 -> main_pp10_ctx0: ![i < 5]
//   main_pp9_ctx0 -> main_pp8_ctx0: i := i + 1
//   main_pp10_ctx0 -> main_pp11_ctx0: check(i == 5)
//   main_pp11_ctx0 -> main_pp12_ctx0: check(i < 5)
//   main_pp14_ctx0 -> main_pp15_ctx0: check(hits == 8)
//   main_pp15_ctx0 -> main_pp16_ctx0: [hits > 10]
//   main_pp15_ctx0 -> main_pp18_ctx0: ![hits > 10]
//   main_pp20_ctx0 -> main_pp21_ctx0: check(a == 2)
//   main_pp21_ctx0 -> main_pp22_ctx0: share := 10 / (a - 2)
//   main_pp22_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp7_ctx0: body(main)
//   record_entry_record_ctx0 -> record_pp0_ctx0: body(record)
//   record_entry_record_ctx1 -> record_pp0_ctx1: body(record)
//   scale_entry_scale_ctx0 -> scale_pp2_ctx0: body(scale)
//   wrap_entry_wrap_ctx0 -> wrap_pp4_ctx0: body(wrap)
//   wrap_entry_wrap_ctx1 -> wrap_pp4_ctx1: body(wrap)
//   wrap_pp4_ctx0 -> scale_entry_scale_ctx0: enter scale(w)
//   scale_exit_scale_ctx0 -> wrap_pp5_ctx0: combine r := scale(w)
//   wrap_pp4_ctx0 -> wrap_pp5_ctx0: call-to-return scale
//   wrap_pp4_ctx1 -> scale_entry_scale_ctx0: enter scale(w)
//   scale_exit_scale_ctx0 -> wrap_pp5_ctx1: combine r := scale(w)
//   wrap_pp4_ctx1 -> wrap_pp5_ctx1: call-to-return scale
//   main_pp12_ctx0 -> record_entry_record_ctx0: enter record(i)
//   record_exit_record_ctx0 -> main_pp13_ctx0: combine
//   main_pp12_ctx0 -> main_pp13_ctx0: call-to-return record
//   main_pp13_ctx0 -> record_entry_record_ctx1: enter record(3)
//   record_exit_record_ctx1 -> main_pp14_ctx0: combine
//   main_pp13_ctx0 -> main_pp14_ctx0: call-to-return record
//   main_pp16_ctx0 -> main_pp18_ctx0: call-to-return record
//   main_pp18_ctx0 -> wrap_entry_wrap_ctx0: enter wrap(1)
//   wrap_exit_wrap_ctx0 -> main_pp19_ctx0: combine a := wrap(1)
//   main_pp18_ctx0 -> main_pp19_ctx0: call-to-return wrap
//   main_pp19_ctx0 -> wrap_entry_wrap_ctx1: enter wrap(4)
//   wrap_exit_wrap_ctx1 -> main_pp20_ctx0: combine b := wrap(4)
//   main_pp19_ctx0 -> main_pp20_ctx0: call-to-return wrap
// EXPECT-GRAPH-END

global hits;

fun record(amount) {
  hits = hits + amount;
}

fun scale(v) {
  return v * 2;
}

fun wrap(w) {
  r = scale(w);
  return r;
}

fun main() {
  i = 0;
  while (i < 5) {
    i = i + 1;
  }
  __voblint_check(i == 5); // PROVED
  __voblint_check(i < 5); // REFUTED

  record(i);
  record(3);
  __voblint_check(hits == 8); // PROVED

  if (hits > 10) {
    record(100);
  }

  a = wrap(1);
  b = wrap(4);
  __voblint_check(a == 2); // UNKNOWN
  share = 10 / (a - 2); // ARITH: WARN division-by-zero
}
