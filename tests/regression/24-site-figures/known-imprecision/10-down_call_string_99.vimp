// PARAM: --analysis interval --context call-string --context-depth 99
// Backs a row of the site's "The price of precision" recursion chart
// (call string 99): one short of the recursion depth, so a single context still
// stands for the deepest calls, and widening opens its lower bound before
// narrowing can close it. 101 contexts, and the slowest setting on the chart:
// it pays for nearly every context and still answers UNKNOWN.

fun down(n) {
  __voblint_check(n >= 0); // UNKNOWN
  if (n > 0) {
    down(n - 1);
  }
}

fun main() {
  down(100);
}
