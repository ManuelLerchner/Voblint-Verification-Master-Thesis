// PARAM: --analysis int --int-refinement never --signed-overflow assume_wraparound
// Source: Example_Int_Domain (interval_parity_contradiction,
// interval_congruence_contradiction).
//
// x is odd and 1 (mod 2); the two guards pin the interval to [0,0]. Every
// component is still inhabited on its own, but no odd integer lies in
// [0,0], and the composite emptiness test sees that even with refinement
// off, so the branch is dead. Measured on this source: --analysis interval
// and --analysis congruence answer REFUTED (branch live), --analysis parity
// UNKNOWN.
//
// Run under --signed-overflow assume_wraparound: the case tests classes that
// survive wraparound modulo 2^32 on signed i32. Under Goblint's default
// assume_top a signed operation that may overflow gives both components top
// (../known-imprecision/04-assume_top_unbounded_operands_lose_class.vimp);
// with x bounded the class survives (22-assume_top_bounded_operands_keep_class).
fun main() {
  i32 n = __voblint_nondet_int();
  i32 x = 2 * n + 1;
  if (x >= 0) {
    if (x <= 0) {
      __voblint_check(false); // NOWARN
    }
  }
}
