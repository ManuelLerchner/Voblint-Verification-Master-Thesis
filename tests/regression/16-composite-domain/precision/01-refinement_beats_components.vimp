// PARAM: --analysis int
// The reduced product of Interval and Congruence proves x == 3, which neither
// component proves alone. m stays in [0, 100], so x = 3 * m cannot overflow
// and lies in 3Z. The guard leaves Interval with [1, 5] and Congruence with 3Z;
// only their reduction (it_refine) narrows x to the single multiple of three in
// [1, 5]. Run as separate analyses on the same program, Interval and
// Congruence each answer UNKNOWN, and so does interval,congruence, which runs
// both in one solve without reducing them (known-imprecision/
// 03-components_side_by_side_do_not_reduce.vimp).
fun main() {
  i32 m = __voblint_nondet_int();
  if (m < 0 || m > 100) {
    m = 0;
  }
  i32 x = 3 * m;
  if (x >= 1 && x <= 5) {
    __voblint_check(x == 3); // PROVED
  }
}
