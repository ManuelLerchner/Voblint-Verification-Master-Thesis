// PARAM: --analysis int --context call-string --context-depth 2
// Same f -> g -> h chain as 21-context-sensitivity/precision/04 (Goblint
// 80-context_gas/12 and 13), under a depth-2 call string and the composite
// Int domain. Int proves every check at this depth, including those whose
// chain exceeds it: h's collapsed contexts enter with i at intervals:
// [0,2147483646] (--graph-snapshot), the false arm of i == 0 strips the
// endpoint 0 to [1,2147483646], so the fall-through `return 13` arm is dead
// and the collapsed exit is the singleton 3. --analysis interval alone
// answers the same at this depth (measured), because Interval's own
// disequality refinement strips the endpoint; the case pins that the
// composite keeps that refinement.
fun i32 h(i32 i) {
  if (i == 0) { return 3; }
  if (0 < i) { i32 r = h(i - 1); return r; }
  return 13;
}
fun i32 g(i32 i) {
  if (i == 0) { return 2; }
  if (0 < i) { i32 r = h(i - 1); return r; }
  return 12;
}
fun i32 f(i32 i) {
  if (i == 0) { return 1; }
  if (0 < i) { i32 r = g(i - 1); return r; }
  return 11;
}
fun main() {
  i32 a = f(10); __voblint_check(a == 3);  // PROVED
  i32 b = f(8); __voblint_check(b == 3);   // PROVED
  i32 c = h(5); __voblint_check(c == 3);   // PROVED
  i32 d = f(0); __voblint_check(d == 1);   // PROVED
  i32 e = f(1); __voblint_check(e == 2);   // PROVED
  i32 x = g(0); __voblint_check(x == 2);   // PROVED
  i32 y = g(1); __voblint_check(y == 3);   // PROVED
  i32 z = f(11); __voblint_check(z == 3);  // PROVED
  i32 u = g(12); __voblint_check(u == 3);  // PROVED
  i32 v = g(20); __voblint_check(v == 3);  // PROVED
  i32 w = f(20); __voblint_check(w == 3);  // PROVED
  i32 s = h(40); __voblint_check(s == 3);  // PROVED
  i32 t = h(300); __voblint_check(t == 3); // PROVED
  i32 q = f(300); __voblint_check(q == 3);  // PROVED
}
