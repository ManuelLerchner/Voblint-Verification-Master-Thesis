// PARAM: --analysis int --int-refinement once
// Source: Example_Int_Backward (int_false_disequality_refines,
// int_direct_comparisons_all_modes, int_division_remainder_modes) and
// Example_Int_Transfer (int_tf_abs_once_special_min, verdict part only).
//
// The false arm of x + 1 != 3 pins x to 2. A comparison on x = -1 is the
// exact value 0 or 1. min, max, / and % of literals are exact. never and
// fixpoint give the same verdicts (measured). The congruence component of
// min(3, 5), 1 (mod 2) rather than 3, is not visible in a check because
// the interval already decides it.
fun main() {
  x = __voblint_nondet_int();
  if (x + 1 != 3) {
    __voblint_check(true); // PROVED
  } else {
    __voblint_check(x == 2); // PROVED
    __voblint_check(x > 0); // PROVED
  }
  y = -1;
  __voblint_check(0 < (y <= 0)); // PROVED
  __voblint_check((y > 0) == 0); // PROVED
  __voblint_check((y >= 0) == 0); // PROVED
  __voblint_check(0 < (y != 0)); // PROVED
  z = min(3, 5);
  __voblint_check(z == 3); // PROVED
  w = max(3, 5);
  __voblint_check(w == 5); // PROVED
  q = -7 / 3;
  __voblint_check(q == -2); // PROVED
  r = -7 % 3;
  __voblint_check(r == -1); // PROVED
}
