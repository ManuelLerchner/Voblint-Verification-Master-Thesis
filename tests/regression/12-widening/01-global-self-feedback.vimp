// PARAM: --analysis interval
// Permanent regression for the certified Interval widening backend
// (docs/... the warrowing/widening solver bridge fixed for issue #96):
// before that fix, this two-line self-referential global write could make
// the join-only Interval backend diverge, because the side-effecting
// global-summary constraint for `total` folds the write's result back into
// its own current value -- a fixpoint dependency that exists even without
// any source-level loop. The regression is termination with a sound (if
// imprecise) result, not precision: total is exactly 3 here, but the
// flow-insensitive global summary only proves total=[0,+inf].
global total;
void main() {
  total := 0;
  total := total + 3;
  __voblint_check(0 < total) // UNKNOWN
}
