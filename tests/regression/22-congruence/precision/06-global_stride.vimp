// PARAM: --analysis congruence --signed-overflow assume_wraparound
// A declared global carried across a call boundary. cinit_congruence_st
// (Congruence_Exec.thy) starts a global at the single integer 0 and every
// local at top, so the ownership split is visible in the initial state
// itself: g is a Global_Location and survives enter_frame_congruence_for,
// which resets locals to top.
//
// bump's write is read back at the caller through the combine edge, so
// g == 5 is decided on a singleton rather than on a joined class.
//
// Run under --signed-overflow assume_wraparound: the case is about a global
// carried across a call, and its classes come from signed arithmetic, which
// standalone Congruence answers with top under Goblint's default assume_top
// (27-signed-overflow/known-imprecision/02).
global i32 g;
fun bump() { g = g + 4; }
fun main() {
  g = 1;
  bump();
  __voblint_check(g == 5); // PROVED
  __voblint_check(g != 4); // PROVED
}
