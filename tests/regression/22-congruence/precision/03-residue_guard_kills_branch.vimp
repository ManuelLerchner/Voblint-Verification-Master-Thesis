// PARAM: --analysis congruence --signed-overflow assume_wraparound
// Reachability from modular information alone: x is 0 (mod 2) for every
// value n takes, 5 is 5 (mod 0), and the two classes are disjoint, so
// intersect_congruence returns bottom and the then-branch is proved dead.
//
// The check layer uses the same disjointness: cong_eq
// (Congruence_Kind.thy) refutes an equality between disjoint classes, so
// 13-disjoint_classes_decide_equality.vimp proves the same kind of claim when
// it appears as a check.
//
// Run under --signed-overflow assume_wraparound: the case tests congruence
// arithmetic modulo 2^32 on signed i32. Under Goblint's default assume_top a
// signed +, - or * that may overflow gives top instead (27-signed-
// overflow/known-imprecision/02).
fun main() {
  i32 n = __voblint_nondet_int();
  i32 x = 2 * n;
  if (x == 5) {
    __voblint_check(false); // NOWARN (unreachable)
  } else {
    __voblint_check(true); // PROVED
  }
}
