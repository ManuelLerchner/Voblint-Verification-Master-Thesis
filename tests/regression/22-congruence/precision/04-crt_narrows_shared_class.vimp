// PARAM: --analysis congruence
// The guard x == y intersects two classes. x = 4 * n + 1 is 1 (mod 4);
// 4 divides 2^32, so the class survives i32 wraparound. y = 6 * m + 3 does
// not keep 3 (mod 6): 6 * m wraps to any even value, so y is only odd.
// The meet of 1 (mod 4) and 1 (mod 2) is 1 (mod 4), and 13 lies in it.
// The inner branch is concretely reachable (n = 3, and 6 * m == 10 has an
// i32 solution because 3 is invertible mod 2^32), so check(false) is
// REFUTED.
fun main() {
  n = __voblint_nondet_int();
  m = __voblint_nondet_int();
  x = 4 * n + 1;
  y = 6 * m + 3;
  if (x == y) {
    if (x == 13) {
      __voblint_check(false); // REFUTED
    } else {
      __voblint_check(true); // PROVED
    }
  } else {
    __voblint_check(true); // PROVED
  }
}
