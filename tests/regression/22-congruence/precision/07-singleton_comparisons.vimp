// PARAM: --analysis congruence
// Exact integers retain all six comparison results, including negative
// operands and equality boundaries. Congruence previously answered UNKNOWN
// for every ordering query, even when both classes were singletons.
fun main() {
  x = -1;
  y = 0;
  __voblint_check(x < y); // PROVED
  __voblint_check(x <= x); // PROVED
  __voblint_check(y > x); // PROVED
  __voblint_check(x >= x); // PROVED
  __voblint_check(x == x); // PROVED
  __voblint_check(x != y); // PROVED
  __voblint_check(x < x); // REFUTED
  __voblint_check(y <= x); // REFUTED
  __voblint_check(x > x); // REFUTED
  __voblint_check(x >= y); // REFUTED
  __voblint_check(x == y); // REFUTED
  __voblint_check(x != x); // REFUTED
}
