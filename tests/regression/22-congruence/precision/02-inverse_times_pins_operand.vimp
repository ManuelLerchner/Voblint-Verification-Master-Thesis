// PARAM: --analysis congruence
// The multiplicative half of the backward filter. inv_times_congruence
// divides the known result by the known operand -- inverse_times_candidate
// 12 against the literal 3 -- and intersects the quotient into n's current
// class, which is top, so n comes out pinned to 4.
//
// The analysis recovers the factor by inverting multiplication in the
// abstract domain; the source needs no explicit division. Interval cannot do this
// (its inv_times gives up on a top operand) and --analysis parity has no
// backward filter at all.
fun main() {
  n = __voblint_nondet_int();
  if (n * 3 == 12) {
    __voblint_check(n == 4); // PROVED
    __voblint_check(n != 0); // PROVED
  } else {
    __voblint_check(true); // PROVED
  }
}
