// PARAM: --analysis congruence
// Source: Example_Congruence_Backward (inv_plus_congruence_regression,
// inv_minus_congruence_regression, inv_times_congruence_modular_regression,
// inv_times_congruence_incompatible_regression,
// inv_times_congruence_nonsingleton_fallback,
// congruence_intersection_incompatible_regression,
// congruence_false_disequality_refines).
//
// Each guard runs one backward inverse. n + 1 in 2 (mod 4) gives n in
// 1 (mod 4), so n == 3 is dead and n == 5 is live; n - 1 in 2 (mod 4)
// gives 3 (mod 4); n * 2 in 2 (mod 6) gives 1 (mod 3); n * 2 odd is
// impossible. Multiplying two non-singleton classes inverts to nothing, so
// x keeps 1 (mod 4) and x == 13 stays live. Even never equals odd. The
// false arm of n + 1 != 3 pins n to 2.
fun main() {
  n = __voblint_nondet_int();
  k = __voblint_nondet_int();
  if (n + 1 == 4 * k + 2) {
    if (n == 3) {
      __voblint_check(false); // NOWARN
    }
    if (n == 5) {
      __voblint_check(true); // PROVED
    }
  }
  if (n - 1 == 4 * k + 2) {
    if (n == 5) {
      __voblint_check(false); // NOWARN
    }
    if (n == 7) {
      __voblint_check(true); // PROVED
    }
  }
  if (n * 2 == 6 * k + 2) {
    if (n == 3) {
      __voblint_check(false); // NOWARN
    }
    if (n == 4) {
      __voblint_check(true); // PROVED
    }
  }
  if (n * 2 == 2 * k + 1) {
    __voblint_check(false); // NOWARN
  }
  a = __voblint_nondet_int();
  b = __voblint_nondet_int();
  x = 4 * a + 1;
  y = 6 * b + 3;
  if (x * y == n) {
    if (x == 13) {
      __voblint_check(true); // PROVED
    }
  }
  e = 2 * a;
  o = 2 * b + 1;
  if (e == o) {
    __voblint_check(false); // NOWARN
  }
  if (n + 1 != 3) {
    __voblint_check(true); // PROVED
  } else {
    __voblint_check(n == 2); // PROVED
  }
}
