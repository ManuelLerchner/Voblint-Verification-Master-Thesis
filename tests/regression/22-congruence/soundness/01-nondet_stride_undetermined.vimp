// PARAM: --analysis congruence
// x is 0 (mod 2), which is exactly what the domain reports, and x == 0 is
// genuinely not fixed by the source: n = 0 gives x = 0 and n = 1 gives
// x = 2, so both a satisfying and a violating execution exist. UNKNOWN is
// the only sound answer -- there is no mechanism losing information here.
//
// The companion refutation is what separates this from the imprecision
// cases: (x != 3) next door in ../known-imprecision/01 is concretely
// fixed and still comes back UNKNOWN. Same abstract value for x, different
// reason for the same verdict.
fun main() {
  n = __voblint_nondet_int();
  x = 2 * n;
  __voblint_check(x == 0); // UNKNOWN
}
