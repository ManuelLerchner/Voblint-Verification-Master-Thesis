// PARAM: --analysis congruence
// n is an unconstrained i32, and n * 3 may overflow. Under the default
// assume_top semantics an overflowing product may take any value, so a run
// with n != 4 can still enter the branch: inverting the multiplication would
// claim n == 4 unsoundly. The checks must stay UNKNOWN.
fun main() {
  n = __voblint_nondet_int();
  if (n * 3 == 12) {
    __voblint_check(n == 4); // UNKNOWN
    __voblint_check(n != 0); // UNKNOWN
  }
}
