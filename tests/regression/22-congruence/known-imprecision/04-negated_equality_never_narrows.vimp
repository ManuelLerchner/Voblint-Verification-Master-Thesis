// PARAM: --analysis congruence
// The else-branch is reached exactly when n is not 4, so (n != 4) is a
// fixed fact there.
//
// Two mechanisms stack, and only the outer one is a lattice limit. The
// filter first: cong_refine (Congruence_Kind.thy) leaves both sides
// unchanged for a disequality, so the false arm of an equality guard
// learns nothing and n stays top. That is not an unreached case -- the
// complement of a singleton is not a residue class, so there is nothing
// for the false arm to narrow to. The check layer then declines: top
// shares a value with 4, so cong_eq cannot decide n != 4.
//
// This is why the case sits here rather than reading as a fixable gap.
// --analysis interval has the same shape and the same answer; recovering
// it needs a disjunctive or exclusion domain, which no domain here is.
fun main() {
  i32 n = __voblint_nondet_int();
  if (n == 4) {
    __voblint_check(true); // PROVED
  } else {
    __voblint_check(n != 4); // UNKNOWN
  }
}
