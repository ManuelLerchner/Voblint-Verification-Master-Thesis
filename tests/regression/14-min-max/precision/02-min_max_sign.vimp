// PARAM: --analysis sign
// A negative argument on either side pins sign_min negative regardless of
// the other side, and symmetrically for sign_max positive -- exact here
// even at Sign's coarser granularity.
void main() {
  int32 w, x, y, z;
  x := 3;
  y := 0 - 5;
  z := min(x, y);
  w := max(x, y);
  __voblint_check(z < 0); // PROVED
  __voblint_check(0 < w) // PROVED
}
