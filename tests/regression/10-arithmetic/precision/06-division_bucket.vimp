// PARAM: --analysis interval
// Normalize and clamp an unknown input before dividing it into buckets.
// Interval retains quotient/remainder bounds through the call and the joins.
fun bucket(n) {
  if (n < 0) {
    n = -n;
  }
  if (n > 23) {
    n = 23;
  }
  q = n / 4;
  r = n % 4;
  __voblint_check(q >= 0); // PROVED
  __voblint_check(q <= 5); // PROVED
  __voblint_check(r >= 0); // PROVED
  __voblint_check(r < 4); // PROVED
  return q;
}

fun main() {
  input = __voblint_nondet_int();
  bin = bucket(input);
  __voblint_check(bin >= 0); // PROVED
  __voblint_check(bin <= 5); // PROVED
  __voblint_check(bin != 6); // PROVED
  if (bin == 0) {
    label = 0;
  } else if (bin <= 3) {
    label = 1;
  } else {
    label = 2;
  }
  __voblint_check(label >= 0); // PROVED
  __voblint_check(label <= 2); // PROVED
  __voblint_check(1 == 2 < 3); // PROVED
}
