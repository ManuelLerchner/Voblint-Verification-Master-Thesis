// PARAM: --analysis int
// C's remainder carries the sign of its dividend, so x % 6 is 5 where x is
// positive and -1 where x is negative. n is bounded, so x = 6n + 5 stays in
// [-595,605] without overflow and both cases happen: n = -1 gives x = -1,
// and -1 % 6 is -1, not 5.
//
// Congruence keeps the class 5 (mod 6), and the Int product bounds a to
// [-1,5], which leaves exactly -1 and 5, so a guard on the sign splits the
// two and each arm holds a singleton. Neither component decides an arm
// alone: Interval on its own stops at [-5,5] because it never learns the
// class, and Congruence alone cannot rule out overflow of 6 * n and gives a
// Top. Unbounded, 6 * n + 5 wraps to every odd i32 and the remainder to every
// odd value in [-5,5] (../soundness/02-remainder_sign_undetermined.vimp).
fun main() {
  i32 n = __voblint_nondet_int();
  if (-100 <= n && n <= 100) {
    i32 x = 6 * n + 5;
    i32 a = x % 6;
    __voblint_check(a >= -1); // PROVED
    __voblint_check(a <= 5); // PROVED
    __voblint_check(a != 0); // PROVED
    if (a < 0) {
      __voblint_check(a == -1); // PROVED
    } else {
      __voblint_check(a == 5); // PROVED
    }
  }
}
