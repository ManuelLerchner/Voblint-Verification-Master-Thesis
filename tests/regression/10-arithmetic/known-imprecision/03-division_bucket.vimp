// PARAM: --analysis interval
// Normalize and clamp an unknown input before dividing it into buckets.
// Interval keeps the upper bounds of quotient and remainder through the
// call and the joins. The lower bounds are lost for two reasons.
// q >= 0 and bin >= 0 are undetermined: -n wraps to -2147483648 when
// n = -2147483648, so q and bin can be -536870912.
// r >= 0 always holds, since -2147483648 % 4 == 0. Mechanism: after the
// clamp n is -2147483648 or in [0,23], and the interval hull
// [-2147483648,23] loses that the outlier is divisible by 4, so r is
// [-3,3].
fun i32 bucket(i32 n) {
  if (n < 0) {
    n = -n;
  }
  if (n > 23) {
    n = 23;
  }
  i32 q = n / 4;
  i32 r = n % 4;
  __voblint_check(q >= 0); // UNKNOWN
  __voblint_check(q <= 5); // PROVED
  __voblint_check(r >= 0); // UNKNOWN
  __voblint_check(r < 4); // PROVED
  return q;
}

fun main() {
  i32 input = __voblint_nondet_int();
  i32 bin = bucket(input);
  __voblint_check(bin >= 0); // UNKNOWN
  __voblint_check(bin <= 5); // PROVED
  __voblint_check(bin != 6); // PROVED
  i32 label;
  if (bin == 0) {
    label = 0;
  } else if (bin <= 3) {
    label = 1;
  } else {
    label = 2;
  }
  __voblint_check(label >= 0); // PROVED
  __voblint_check(label <= 2); // PROVED
  __voblint_check(1 == 2 < 3); // PROVED
}
