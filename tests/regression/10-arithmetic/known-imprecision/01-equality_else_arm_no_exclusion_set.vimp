// PARAM: --analysis interval
// Adapted from Goblint tests/regression/31-ikind-aware-ints/16-enums-compare.c,
// the else arm of if (z == 3) with y = 3: every execution there has z != 3, so
// y == z is concretely false and !(y == z) concretely true (Goblint: FAIL,
// bare, through the enums domain's exclusion set). The false arm of an
// equality guard removes the single point 3 from z, and an interval is convex:
// [-inf,+inf] minus {3} is still [-inf,+inf]. With z unchanged, the equality
// against y = [3,3] is UNKNOWN in both polarities. int agrees: none of sign,
// parity or congruence can exclude a single point either.
void main() {
  z := __voblint_nondet_int();
  y := 3;
  if (z == 3) {
    skip
  } else {
    __voblint_check(y == z); // UNKNOWN
    __voblint_check(!(y == z)) // UNKNOWN
  }
}
