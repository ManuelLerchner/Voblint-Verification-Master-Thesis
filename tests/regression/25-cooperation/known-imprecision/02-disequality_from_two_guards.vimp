// PARAM: --analysis interval
// Concretely z == 0 at the check: both guards hold, so x == y and x != y
// evaluates to 0.
//
// Mechanism: as in 01-equality_from_two_guards, the guards compare two
// unbounded intervals and refine neither, so Interval evaluates x != y to
// [0,1].
//
// The order analysis answers EvalInt (x != y) with [0,0] once it holds both
// (x, y) and (y, x) (rel_qry, src/Analyses/Relational/Rel_Order_Local.thy), so
// the cooperating product would assign 0. Unlike case 01, no solver run of the
// product on this program is recorded; the product is not reachable from the
// CLI, so this case pins the baseline.
fun main() {
  x = __voblint_nondet_int();
  y = __voblint_nondet_int();
  if (x <= y) {
    if (y <= x) {
      z = (x != y);
      __voblint_check(z == 0); // UNKNOWN
    }
  }
}
