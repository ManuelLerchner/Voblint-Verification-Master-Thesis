// PARAM: --analysis interval
// A constant-false check in reachable code is REFUTED, not NOWARN: unlike
// 06-reachability's check(false) sentinels, this location is not dead
// code, so the check actually executes and its condition is decidably
// false every time.
void main() {
  int32 x;
  x := 5;
  __voblint_check(false) // REFUTED
}
