// PARAM: --analysis interval --globals join
// Ported from Example_Interval_Checks_Store_Only.thy (checks_ivl_ex_classify_2/3/4,
// checks_ivl_ex_report_eval). The guard narrows the unconstrained x to [1,9]
// on the then-branch, so the upper bound proves x < 11 and the lower bound
// refutes x < 0. x == 5 is genuinely undetermined on [1,9], so UNKNOWN is the
// only sound answer there.
fun main() {
  x = __voblint_nondet_int();
  if (0 < x && x < 10) {
    __voblint_check(x < 11); // PROVED
    __voblint_check(x < 0); // REFUTED
    __voblint_check(x == 5); // UNKNOWN
  } else {
    y = 0;
  }
}
