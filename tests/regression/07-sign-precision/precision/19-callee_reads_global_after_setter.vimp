// PARAM: --analysis sign --globals join
// Source: Example_Sign_Mixed_Flow (mf_report, mf_checks_hold).
//
// set() writes the global, get() reads it back as a return value. With the
// default --program-globals flow-sensitive the whole state is carried
// flow-sensitively, so all four checks are proved (y = Positive). The theory
// runs the same program with --program-globals flow-insensitive, where Gx joins its
// seed 0 with 1 and y is only NonNegative; see
// 21-callee_reads_shared_global_after_setter.vimp.
global Gx;
fun set() { Gx = 1; }
fun get() { return Gx; }
fun main() {
  x = 1;
  set();
  y = get();
  __voblint_check(0 < x); // PROVED
  __voblint_check(y >= 0); // PROVED
  __voblint_check(0 < y); // PROVED
  __voblint_check(0 < Gx); // PROVED
}
