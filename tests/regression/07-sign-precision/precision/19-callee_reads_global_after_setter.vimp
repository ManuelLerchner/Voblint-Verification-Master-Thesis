// PARAM: --analysis sign --globals join
// Source: Example_Sign_Mixed_Flow (mf_snapshot, mf_after_calls).
//
// set() writes the global, get() reads it back as a return value. The
// theory solves this program with an ownership-split specification whose
// globals live in one flow-insensitive slot, where Gx joins its seed 0
// with 1 and y is only NonNegative (mf_after_calls: 0 < x and 0 <= y). The
// CLI carries the whole state flow-sensitively, so it proves the stronger
// 0 < y and 0 < Gx as well (measured: y = Positive).
global Gx;
fun set() { Gx = 1; }
fun get() { return Gx; }
fun main() {
  x = 1;
  set();
  y = get();
  __voblint_check(0 < x); // PROVED
  __voblint_check(y >= 0); // PROVED
  __voblint_check(0 < y); // PROVED
  __voblint_check(0 < Gx); // PROVED
}
