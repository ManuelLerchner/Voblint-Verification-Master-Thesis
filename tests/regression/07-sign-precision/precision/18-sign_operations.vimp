// PARAM: --analysis sign
// Source: Example_Sign_Domain_Ops (sign_of_int_regression,
// sign_arithmetic_regression, join_sign_regression, aval_sign_regression,
// assign_sign_regression, sign_direct_comparisons,
// sign_direct_guard_refinement, sign_interface_regression,
// sign_division_remainder_regression).
//
// Each block exercises one sign operation through a check. The UNKNOWN rows
// b < 0, d > 0 and q > 0 are soundness rows: b is -1 or 0, d is 1 or 0, and
// q is n / c with both positive, so each condition holds in one execution
// and fails in another. The products with zero, quotients and remainders
// here cannot leave i32, so they keep their sign. Products of nonzero signs
// and sums of positives may overflow and lose it; they are in
// ../known-imprecision/07-nonzero_operands_may_wrap.vimp, and other
// operations that lose information on fixed values in
// ../known-imprecision/02-mixed_signs_lose_sign.vimp.
fun main() {
  i32 c = __voblint_nondet_int();
  i32 n = __voblint_nondet_int();
  i32 z = 0 * n;
  __voblint_check(z == 0); // PROVED
  i32 x = 1;
  __voblint_check(0 < x); // PROVED
  i32 b;
  if (c) { b = -1; } else { b = 0; }
  __voblint_check(b <= 0); // PROVED
  __voblint_check(b < 0); // UNKNOWN
  i32 d;
  if (c) { d = 1; } else { d = 0; }
  __voblint_check(d >= 0); // PROVED
  __voblint_check(d > 0); // UNKNOWN
  i32 m = -1;
  __voblint_check(0 < (m <= 0)); // PROVED
  __voblint_check((m > 0) == 0); // PROVED
  __voblint_check((m >= 0) == 0); // PROVED
  __voblint_check(0 < (m != 0)); // PROVED
  if (n > 0) {
    __voblint_check(0 < n); // PROVED
  }
  if (n <= 0) {
    __voblint_check(n < 1); // PROVED
  }
  if (n >= 0) {
    __voblint_check(n > -1); // PROVED
  }
  if (n != 0) {
    __voblint_check(true); // PROVED
  } else {
    __voblint_check(n == 0); // PROVED
  }
  if (n >= 0) {
    if (n <= 0) {
      __voblint_check(n == 0); // PROVED
    }
  }
  if (n > 0) {
    if (n < 0) {
      __voblint_check(false); // NOWARN
    }
  }
  if (n > 0 && c > 0) {
    i32 q = n / c;
    __voblint_check(q >= 0); // PROVED
    __voblint_check(q > 0); // UNKNOWN
    q = n / 0;
    __voblint_check(q == 0); // PROVED
  }
  if (n < 0) {
    i32 r = n % 0;
    __voblint_check(r < 0); // PROVED
  }
}
