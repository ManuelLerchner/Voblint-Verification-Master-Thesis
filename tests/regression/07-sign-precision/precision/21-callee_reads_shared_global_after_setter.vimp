// PARAM: --analysis sign --globals join --program-globals flow-insensitive
// Source: Example_Sign_Mixed_Flow (mf_report, mf_checks_hold).
//
// 19-callee_reads_global_after_setter.vimp with program globals
// flow-insensitive. Gx has one value for the whole run, at its own global
// unknown, so its initial 0 joins the write 1 and get() returns only
// NonNegative: 0 < x and y >= 0 are proved, 0 < y and 0 < Gx are not.
global i32 Gx;
fun set() { Gx = 1; }
fun i32 get() { return Gx; }
fun main() {
  i32 x = 1;
  set();
  i32 y = get();
  __voblint_check(0 < x); // PROVED
  __voblint_check(y >= 0); // PROVED
  __voblint_check(0 < y); // UNKNOWN
  __voblint_check(0 < Gx); // UNKNOWN
}
