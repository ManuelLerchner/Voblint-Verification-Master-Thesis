// PARAM: --analysis sign
// The branch gate is generic in backward_domain, so every domain that
// interprets it inherits the per-disjunct feasibility test -- including the
// `feasible` entry each interpretation has to list in its `defines` block for
// the filter to stay code-generatable. This is the Sign instance of
// 02-control-flow/precision/04-infeasible_disjunct_dropped.vimp: x is Positive,
// so "(x < 0) == 1" is false in every state, the branch is taken only when
// "0 < y" holds, and the join keeps y Positive rather than discarding it.
void main() {
  x := 5;
  y := __voblint_nondet_int();
  if (0 < y || (x < 0) == 1) {
    __voblint_check(0 < y) // PROVED
  } else {
    __voblint_check(y < 1) // PROVED
  }
}
