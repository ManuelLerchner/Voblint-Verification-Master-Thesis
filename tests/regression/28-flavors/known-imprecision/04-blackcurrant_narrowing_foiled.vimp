// PARAM: --analysis interval
// Blackcurrant (Monniaux, ETAPS 2024): the same counter, incremented only when a
// nondeterministic test holds. i stays in [0, 9] in every run, but the path that
// skips the increment is a self-loop at the loop head, so the next-iteration
// operator never shrinks the widened value and narrowing does not help. Policy
// iteration finds [0, 9]; Voblint has no policy iteration.
fun main() {
  i32 i = 0;
  i32 c;
  while (1) {
    c = __voblint_nondet_int();
    if (c) {
      i = i + 1;
      if (i >= 10) {
        i = 0;
      }
    }
    __voblint_check(i <= 9);  // UNKNOWN
  }
}
