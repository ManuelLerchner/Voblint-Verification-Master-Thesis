// PARAM: --analysis interval
// Coffee (Monniaux, ETAPS 2024, slide 38): y = |x|, and y >= 1 implies x != 0,
// so the check holds in every run. Proving it needs the relation between x and
// y on each path; a non-relational interval keeps x unconstrained.
fun main() {
  x = __voblint_nondet_int();
  y = 0;
  if (x >= 0) {
    y = x;
  } else {
    y = -x;
  }
  if (y >= 1) {
    __voblint_check(x != 0); // UNKNOWN
  }
}
