// PARAM: --analysis interval
// x = 0; while (x < 20) x = x + 1. The loop head settles at x = [0,20]
// without widening loss: the guard x < 20 narrows the body entry to [0,19],
// the increment gives [1,20], and its join with the initial [0,0] is the
// head value again. The exit is [20,20]. The EXPECT-GRAPH block pins the
// head, body and exit values and the compiled CFG layout (pp1 loop head,
// pp2 body entry, pp3 exit).
//
// Ported from Exec_Interval_Run.thy (loop_head_ivl, loop_body_ivl,
// loop_head_ivl_td, loop_body_ivl_td, loop_head_warrow),
// Example_Interval_Loop_Coverage.thy (loop_cfg_full, loop_body_x_from_assume)
// and Example_Guard_Refinement.thy (refine_x_lt_20, body_step_refined,
// loop_join_refined). The join rule's run of this program is
// Example_Interval_DG_Flagship.thy; the other update rules agree on the same
// loop shape in 06-reachability/precision/10, 15, 16, 17.
// EXPECT-GRAPH-BEGIN
// clusters:
//   cluster_ctx_0: main / unit
//     main_pp2_ctx0
//     main_pp1_ctx0
//     main_pp3_ctx0
//     main_pp4_ctx0
//     main_exit_main_ctx0
//     main_pp0_ctx0
//     main_entry_main_ctx0
//
// nodes:
//   main_pp2_ctx0: pp2
//       interval:
//         x=[0,19]
//   main_pp1_ctx0: pp1
//       interval:
//         x=[0,20]
//   main_pp3_ctx0: pp3 [proved]
//       interval:
//         x=[20,20]
//       check x == 20
//   main_pp4_ctx0: pp4
//       interval:
//         x=[20,20]
//   main_exit_main_ctx0: exit_main
//       interval:
//         x=[20,20]
//   main_pp0_ctx0: pp0
//       interval:
//         x=⊤
//   main_entry_main_ctx0: entry_main
//       interval:
//         x=⊤
//
// edges:
//   main_pp0_ctx0 -> main_pp1_ctx0: x := 0
//   main_pp1_ctx0 -> main_pp2_ctx0: [x < 20]
//   main_pp1_ctx0 -> main_pp3_ctx0: ![x < 20]
//   main_pp2_ctx0 -> main_pp1_ctx0: x := x + 1
//   main_pp3_ctx0 -> main_pp4_ctx0: check(x == 20)
//   main_pp4_ctx0 -> main_exit_main_ctx0: return
//   main_entry_main_ctx0 -> main_pp0_ctx0: body(main)
// EXPECT-GRAPH-END


fun main() {
  x = 0;
  while (x < 20) {
    x = x + 1;
  }
  __voblint_check(x == 20); // PROVED
}
