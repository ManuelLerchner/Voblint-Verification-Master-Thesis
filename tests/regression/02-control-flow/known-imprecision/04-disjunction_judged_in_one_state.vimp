// PARAM: --analysis interval
// Inside the guard x is 1 or 2, so x == 1 || x == 2 holds in every store.
// taeval (Typed_Nonrel.thy) judges both disjuncts in the same state
// x=[1,2]: x == 1 and x == 2 are both unknown there, and so is their
// disjunction. The disjunction is never re-judged under the refinement
// of its first operand. Goblint's CIL front end lowers || into branches, so
// there the second operand is judged after the first has failed.
// The nested form below recovers the fact: on the else branch of x == 1,
// ivl_excl (Interval_Kind.thy) moves the bound 1 past the excluded
// constant, so x=[2,2] and x == 2 is PROVED.
fun main() {
  i32 x = __voblint_nondet_int();
  if (x >= 1 && x <= 2) {
    __voblint_check(x == 1 || x == 2); // UNKNOWN
    if (x == 1) {
      i32 t = 1;
    } else {
      __voblint_check(x == 2); // PROVED
    }
  }
}
