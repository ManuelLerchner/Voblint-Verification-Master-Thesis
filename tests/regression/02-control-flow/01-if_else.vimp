// PARAM: --analysis interval
// Branch and join: y is 1 or 2 depending on the arm taken, so the check
// holds on every path regardless of which arm the analysis takes.
program {
  void main() {
    x := 0;
    if (x < 1) {
      y := 1
    } else {
      y := 2
    };
    __voblint_check(0 < y) // PROVED
  }
}
