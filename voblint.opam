opam-version: "2.0"
synopsis: "Verified Goblint-style static analysis pipeline in Isabelle/HOL"
description: """
Voblint formalizes and extracts a procedure-aware abstract interpreter for
VIMP. This package manifest declares the OCaml dependencies needed to build
the extracted command-line interface, browser frontend, and executable tests.
"""
maintainer: "Manuel Lerchner"
authors: ["Manuel Lerchner"]
license: "BSD-3-Clause"
homepage: "https://github.com/ManuelLerchner/Voblint-Verification-Master-Thesis"
bug-reports: "https://github.com/ManuelLerchner/Voblint-Verification-Master-Thesis/issues"
dev-repo: "git+https://github.com/ManuelLerchner/Voblint-Verification-Master-Thesis.git"

depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.22" & build}
  "menhir" {build}
  "zarith"
  # Browser frontend / JavaScript interop.
  "js_of_ocaml" {>= "6.4.1" & build}
  # WebAssembly compiler backend.
  "wasm_of_ocaml-compiler" {>= "6.4.1" & build}
  # Zarith runtime primitives for browser targets.
  "zarith_stubs_js" {build}
  # `pixi run ocaml-format-check`; must match the version in .ocamlformat.
  "ocamlformat" {with-test & = "0.29.0"}
]

# v0.17.0 does not contain the wasm_of_ocaml runtime declaration.
# Pin to an upstream revision containing the Wasm Zarith stubs until a
# corresponding zarith_stubs_js release is available.
pin-depends: [
  [
    "zarith_stubs_js.v0.17.0"
    "git+https://github.com/janestreet/zarith_stubs_js.git#c8e2e3eb062eee373625f9aecca88168103e4e93"
  ]
]

build: [
  ["dune" "build" "-j" jobs]
]
