(* GENERATED by scripts/gen_vimp_menhir.py from manifests/vimp-grammar.yaml. Do not hand-edit; regenerate instead. *)

%{
(* Menhir does not export prelude bindings through the generated .mli, so the
   recorder itself lives in cli/frontend/vimp_positions.ml where Vimp_frontend can
   reach it too. See that module for why positions are taken here rather than
   from the token stream, and what order they come out in. *)
let record_stmt_pos = Vimp_positions.record

(* A check's label is where its keyword starts, so the analysis result names
   each check by its own source position. *)
let source_label p =
  let line, column = Vimp_positions.label p in
  ( Voblint.nat_of_integer (Z.of_int line),
    Voblint.nat_of_integer (Z.of_int column) )

(* A function_decl's action builds its Vimp_typing.definition; closing the
   bucket here keeps the name, its header and its positions together without a
   second traversal. *)
let close_definition header_start header_end ((name, _, _, _, _) as decl) =
  Vimp_positions.close name header_start header_end;
  decl
%}

%token <string> IDENT
%token <Z.t> INT
%token GLOBAL
%token FUN
%token SKIP
%token RETURN
%token CHECK
%token IF
%token ELSE
%token WHILE
%token BOOL_TRUE
%token BOOL_FALSE
%token KW_I8
%token KW_U8
%token KW_I16
%token KW_U16
%token KW_I32
%token KW_U32
%token KW_I64
%token KW_U64
%token ASSIGN
%token PLUS
%token MINUS
%token STAR
%token SLASH
%token PERCENT
%token LT
%token LE
%token GT
%token GE
%token EQEQ
%token NEQ
%token AND
%token OR
%token NOT
%token LBRACE
%token RBRACE
%token LPAREN
%token RPAREN
%token SEMI
%token COMMA
%token EOF

%left OR
%left AND
%nonassoc EQEQ NEQ
%nonassoc LT LE GT GE
%left PLUS MINUS
%left STAR SLASH PERCENT
%right NOT UMINUS

%type <Voblint.exp> exp
%type <(unit, string, Voblint.exp) Voblint.gcom> stmt
%type <(unit, string, Voblint.exp) Voblint.gcom> if_stmt
%type <(unit, string, Voblint.exp) Voblint.gcom> stmts
%type <(unit, string, Voblint.exp) Voblint.gcom> stmts_opt
%type <Voblint.exp list> actuals
%type <string list> ids
%type <Voblint.ikind> kind
%type <Vimp_typing.global_line> global_line
%type <Vimp_typing.global_line list> global_line_star
%type <Vimp_typing.formal> tformal
%type <Vimp_typing.formal list> tformals
%type <string * (unit, string, Voblint.exp) Voblint.gcom> init_decl
%type <(string * (unit, string, Voblint.exp) Voblint.gcom) list> init_decls
%type <(string * Voblint.ikind * (unit, string, Voblint.exp) Voblint.gcom) list> local_decl
%type <(string * Voblint.ikind * (unit, string, Voblint.exp) Voblint.gcom) list> local_decl_star
%type <Vimp_typing.definition> function_decl
%type <Vimp_typing.definition list> function_decl_star

%start <unit Voblint.imp_prog_ext> program
%%

(* exp: *)
exp:
  | v0 = IDENT
      { Voblint.V v0 }
  | v0 = INT
      { Voblint.N (Voblint.Int_of_integer v0) }
  | v0 = MINUS v1 = exp %prec UMINUS
      { match v1 with
      | Voblint.N (Voblint.Int_of_integer z) ->
        Voblint.N (Voblint.Int_of_integer (Z.neg z))
      | _ ->
        Voblint.Minus
          (Voblint.N (Voblint.Int_of_integer Z.zero), v1) }
  | v0 = exp v1 = PLUS v2 = exp
      { Voblint.Plus (v0, v2) }
  | v0 = exp v1 = MINUS v2 = exp
      { Voblint.Minus (v0, v2) }
  | v0 = exp v1 = STAR v2 = exp
      { Voblint.Times (v0, v2) }
  | v0 = exp v1 = SLASH v2 = exp
      { Voblint.Div (v0, v2) }
  | v0 = exp v1 = PERCENT v2 = exp
      { Voblint.Mod (v0, v2) }
  | v0 = BOOL_TRUE
      { Voblint.N (Voblint.Int_of_integer (Z.of_int 1)) }
  | v0 = BOOL_FALSE
      { Voblint.N (Voblint.Int_of_integer (Z.of_int 0)) }
  | v0 = exp v1 = LT v2 = exp
      { Voblint.Less (v0, v2) }
  | v0 = exp v1 = LE v2 = exp
      { Voblint.LessEq (v0, v2) }
  | v0 = exp v1 = GT v2 = exp
      { Voblint.Greater (v0, v2) }
  | v0 = exp v1 = GE v2 = exp
      { Voblint.GreaterEq (v0, v2) }
  | v0 = exp v1 = EQEQ v2 = exp
      { Voblint.Eq (v0, v2) }
  | v0 = exp v1 = NEQ v2 = exp
      { Voblint.NotEq (v0, v2) }
  | v0 = NOT v1 = exp
      { Voblint.Not v1 }
  | v0 = exp v1 = AND v2 = exp
      { Voblint.And (v0, v2) }
  | v0 = exp v1 = OR v2 = exp
      { Voblint.Or (v0, v2) }
  | v0 = LPAREN v1 = exp v2 = RPAREN
      { v1 }
  | v0 = LPAREN v1 = kind v2 = RPAREN v3 = exp %prec UMINUS
      { Voblint.Cast (v1, v3) }
(* kind: *)
kind:
  | v0 = KW_I8
      { Voblint.I8 }
  | v0 = KW_U8
      { Voblint.U8 }
  | v0 = KW_I16
      { Voblint.I16 }
  | v0 = KW_U16
      { Voblint.U16 }
  | v0 = KW_I32
      { Voblint.I32 }
  | v0 = KW_U32
      { Voblint.U32 }
  | v0 = KW_I64
      { Voblint.I64 }
  | v0 = KW_U64
      { Voblint.U64 }
(* stmt: *)
stmt:
  | v0 = SKIP v1 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.SKIP ()) }
  | v0 = IDENT v1 = ASSIGN v2 = exp v3 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Assign ((), v0, v2)) }
  | v0 = RETURN v1 = exp v2 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Return ((), (Some v1))) }
  | v0 = RETURN v1 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Return ((), None)) }
  | v0 = CHECK v1 = LPAREN v2 = exp v3 = RPAREN v4 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Check ((), (source_label $startpos), v2)) }
  | v0 = if_stmt
      { v0 }
  | v0 = WHILE v1 = LPAREN v2 = exp v3 = RPAREN v4 = LBRACE v5 = stmts_opt v6 = RBRACE
      { record_stmt_pos $startpos $endpos (Voblint.While ((), v2, v5)) }
  | v0 = IDENT v1 = LPAREN v2 = actuals v3 = RPAREN v4 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Call ((), None, v0, v2)) }
  | v0 = IDENT v1 = ASSIGN v2 = IDENT v3 = LPAREN v4 = actuals v5 = RPAREN v6 = SEMI
      { record_stmt_pos $startpos $endpos (Voblint.Call ((), (Some v0), v2, v4)) }
(* if_stmt: *)
if_stmt:
  | v0 = IF v1 = LPAREN v2 = exp v3 = RPAREN v4 = LBRACE v5 = stmts_opt v6 = RBRACE v7 = ELSE v8 = LBRACE v9 = stmts_opt v10 = RBRACE
      { record_stmt_pos $startpos $endpos (Voblint.If ((), v2, v5, v9)) }
  | v0 = IF v1 = LPAREN v2 = exp v3 = RPAREN v4 = LBRACE v5 = stmts_opt v6 = RBRACE
      { record_stmt_pos $startpos $endpos (Voblint.If ((), v2, v5, (record_stmt_pos $endpos $endpos (Voblint.SKIP ())))) }
  | v0 = IF v1 = LPAREN v2 = exp v3 = RPAREN v4 = LBRACE v5 = stmts_opt v6 = RBRACE v7 = ELSE v8 = if_stmt
      { record_stmt_pos $startpos $endpos (Voblint.If ((), v2, v5, v8)) }
(* stmts: *)
stmts:
  | x = stmt
      { x }
  | xs = stmts  x = stmt
      { Voblint.Seq (xs, x) }
(* stmts_opt: *)
stmts_opt:
  | (* empty *)
      { record_stmt_pos $startpos $endpos (Voblint.SKIP ()) }
  | cs = stmts
      { cs }
(* actuals: *)
actuals:
  | (* empty *)
      { [] }
  | x = exp
      { [x] }
  | xs = actuals COMMA x = exp
      { xs @ [x] }
(* ids: *)
ids:
  | x = IDENT
      { [x] }
  | xs = ids COMMA x = IDENT
      { xs @ [x] }
(* program: *)
program:
  | gs = global_line_star fs = function_decl_star EOF
      { Vimp_typing.program gs fs }

global_line_star:
  | (* empty *)
      { [] }
  | g = global_line gs = global_line_star
      { g :: gs }

global_line:
  | GLOBAL xs = ids SEMI
      { (xs, None) }
  | GLOBAL k = kind xs = ids SEMI
      { (xs, Some k) }

tformal:
  | x = IDENT
      { (x, None) }
  | k = kind x = IDENT
      { (x, Some k) }

tformals:
  | (* empty *)
      { [] }
  | f = tformal
      { [f] }
  | fs = tformals COMMA f = tformal
      { fs @ [f] }

(* A local declaration starts its variable at an arbitrary value of its kind,
   written out as a library call so the semantics, not the parser, says what
   that value may be. An initializer, as in C's `i8 x = 2;`, is an assignment
   instead, converted to the variable's kind as any assignment is. Each
   declarator is one statement at its own position. *)
init_decl:
  | x = IDENT
      { (x,
         record_stmt_pos $startpos $endpos
           (Voblint.Call ((), Some x, "__voblint_nondet_int", []))) }
  | x = IDENT ASSIGN e = exp
      { (x, record_stmt_pos $startpos $endpos (Voblint.Assign ((), x, e))) }

init_decls:
  | d = init_decl
      { [d] }
  | ds = init_decls COMMA d = init_decl
      { ds @ [d] }

local_decl:
  | k = kind ds = init_decls SEMI
      { List.map (fun (x, c) -> (x, k, c)) ds }

local_decl_star:
  | (* empty *)
      { [] }
  | l = local_decl ls = local_decl_star
      { l @ ls }

(* Locals are declared before the first statement, as CIL's fundec.slocals
   lists them, so every local is in scope throughout its procedure. *)
function_decl:
  | FUN rk = option(kind) name = IDENT LPAREN fs = tformals rp = RPAREN
    LBRACE ls = local_decl_star b = stmts_opt RBRACE
      { let body = List.fold_right (fun (_, _, c) acc -> Voblint.Seq (c, acc)) ls b in
        close_definition $startpos $endpos(rp)
          (name, fs, rk, List.map (fun (x, k, _) -> (x, k)) ls, body) }

function_decl_star:
  | (* empty *)
      { [] }
  | f = function_decl fs = function_decl_star
      { f :: fs }
