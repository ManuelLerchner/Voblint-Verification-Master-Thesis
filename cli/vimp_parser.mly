%{
(* Menhir does not export prelude bindings through the generated .mli, so the
   recorder itself lives in cli/vimp_positions.ml where Vimp_frontend can
   reach it too. See that module for why positions are taken here rather than
   from the token stream, and what order they come out in. *)
let record_stmt_pos = Vimp_positions.record
%}

%token <string> IDENT
%token <int> INT
%token GLOBAL
%token VOID
%token SKIP
%token RETURN
%token CHECK
%token IF
%token ELSE
%token WHILE
%token BOOL_TRUE
%token BOOL_FALSE
%token ASSIGN
%token PLUS
%token MINUS
%token STAR
%token LT
%token EQEQ
%token AND
%token OR
%token NOT
%token LBRACE
%token RBRACE
%token LPAREN
%token RPAREN
%token SEMI
%token COMMA
%token EOF

%left OR
%left AND
%nonassoc LT EQEQ
%left PLUS MINUS
%left STAR
%right NOT UMINUS

%type <Voblint_CLI.Core.exp> exp
%type <Voblint_CLI.Core.com> stmt
%type <Voblint_CLI.Core.com> stmts
%type <Voblint_CLI.Core.com> stmts_opt
