; frontend/  source text -> imp_prog, and imp_prog -> source text
; result/    reading one run result: names, verdicts, the contextual CFG
; render/    one module per output: text report, DOT, snapshot, JSON, g2html
; entry/     the native CLI and the browser adapter

(include_subdirs unqualified)

(rule
 (targets Voblint_CLI.ml)
 (deps ../codegen/generated/ml/Voblint_CLI.ml)
 (action (copy %{deps} %{targets})))

(library
 (name voblint_frontend)
 (wrapped false)
 (modules
  Voblint_CLI
  vimp_positions
  vimp_parser
  vimp_lexer
  vimp_frontend
  vimp_printer)
 (libraries
  menhirLib
  str
  zarith)
 (flags (:standard -w -8-11-20-26-27-32-37-39 -warn-error -A)))

(library
 (name voblint_rendering)
 (wrapped false)
 (modules
  value_symbols
  result_text
  context_graph
  render_text
  render_dot
  render_snapshot
  render_json
  render_xml
  wf_explain
  report_dir)
 (libraries voblint_frontend)
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))

(executable
 (name voblint)
 (modules voblint)
 (libraries
  voblint_frontend
  voblint_rendering
  str
  zarith
  unix)
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))

(executable
 (name voblint_web)
 (modules voblint_web)
 (modes wasm)
 (libraries
  voblint_frontend
  voblint_rendering
  js_of_ocaml
  zarith
  zarith_stubs_js)

 ;; The generated analyzer contains deep indirect recursion through the
 ;; solver's query/eval callbacks. Keep CPS enabled so tail calls through
 ;; higher-order functions can be transformed rather than consuming the
 ;; Wasm/host stack.
 (wasm_of_ocaml
  (flags
   (:standard
   --opt=3)))
 (flags (:standard -w -8-11-20-26-27-32-37-39 -warn-error -A)))
