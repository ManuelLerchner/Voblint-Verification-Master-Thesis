(rule
 (targets Voblint_CLI.ml)
 (deps ../codegen/generated/ml/Voblint_CLI.ml)
 (action (copy %{deps} %{targets})))

(menhir
 (modules vimp_parser)
 (flags
  --table
  --unused-precedence-levels))

(ocamllex vimp_lexer)

(library
 (name voblint_frontend)
 (wrapped false)
 (modules
  Voblint_CLI
  vimp_positions
  vimp_parser
  vimp_lexer
  vimp_frontend)
 (libraries
  menhirLib
  str
  zarith)
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))

(library
 (name voblint_rendering)
 (wrapped false)
 (modules dot_render)
 (libraries voblint_frontend)
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))

(executable
 (name main)
 (modules
  html_report
  main)
 (libraries
  voblint_frontend
  voblint_rendering
  str
  zarith
  unix)
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))

(executable
 (name browser_main)
 (modules browser_main)
 (modes js)
 (libraries
  voblint_frontend
  voblint_rendering
  js_of_ocaml
  zarith
  zarith_stubs_js)
;; The generated analyzer contains deep indirect recursion through the solver's
;; query/eval callbacks. V8 has no general proper tail calls, so js_of_ocaml's
;; normal output can overflow the JavaScript stack on recursive analyses.
;; CPS compilation makes these call paths stack-safe.
(js_of_ocaml
 (flags
  (:standard --effects=cps)))
 (flags (:standard -w -8-11-20-27-32-37-39 -warn-error -A)))
